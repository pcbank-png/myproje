{
  "expo": {
    "name": "NSX Cari Takip",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.mobileapp.e171kg"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A1933"
      },
      "package": "com.emergent.mobileapp.e171kg"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#06152A"
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "QR kodunu galeriden seçmek için fotoğraflarınıza erişim gerekir."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "QR ile hızlı ve güvenli giriş için kamera kullanılır",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-vector-icons/feather",
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/nsx-icon-48.png",
          "color": "#2563EB"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "1b1ec875-5613-41bd-bec3-b4550e2602e6"
      }
    },
    "owner": "nsxyazilim"
  }
}

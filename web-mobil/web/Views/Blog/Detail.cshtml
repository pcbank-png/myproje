@model NSYazilim.Web.Controllers.BlogController.SeoPage
@inject NSYazilim.Web.Services.SiteLocalizationService SiteLocalization
@{
    var blogLang = await SiteLocalization.GetCurrentLanguageAsync(Context.RequestAborted);
    async Task<string> BT(string? source)
        => string.IsNullOrWhiteSpace(source)
            ? string.Empty
            : await SiteLocalization.TranslateAsync(source, blogLang.Code, Context.RequestAborted);

    var relatedProductName = await BT(ViewBag.RelatedProductName?.ToString());
    var relatedProductUrl = ViewBag.RelatedProductUrl?.ToString();
    var relatedProductPrimaryText = await BT(ViewBag.RelatedProductPrimaryText?.ToString());
    var relatedProductPrimaryUrl = ViewBag.RelatedProductPrimaryUrl?.ToString();
    var relatedPages = ViewBag.RelatedPages as IReadOnlyList<NSYazilim.Web.Controllers.BlogController.SeoPage>
        ?? new List<NSYazilim.Web.Controllers.BlogController.SeoPage>();
    var isVeresiyePage = IsVeresiyeRelated(Model);
    var showFreeVeresiyePromotion = isVeresiyePage;
    var isFreeVeresiyeLanding = string.Equals(Model.Slug, "ucretsiz-veresiye-programi", StringComparison.OrdinalIgnoreCase);
    const string veresiyeProductUrl = "/urun/nsx-veresiye-takip-pro-free";
    const string veresiyeProductAnchor = "NSX Veresiye Takip Pro’yu ücretsiz indirin; v1.0.5 Bulut ve Mobil Yönetim özelliklerini kullanmaya başlayın.";
    const string veresiyeVideoEmbedUrl = "https://www.youtube.com/embed/ypsXQY6iOl4";
    var detailUrl = Model.IsLanding ? $"/{Model.Slug}" : $"/blog/{Model.Slug}";
    var blogHeroWords = (Model.H1 ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var blogHeroAccentCount = blogHeroWords.Length >= 4 ? 2 : 1;
    var blogHeroMain = blogHeroWords.Length > blogHeroAccentCount
        ? string.Join(" ", blogHeroWords.Take(blogHeroWords.Length - blogHeroAccentCount))
        : string.Empty;
    var blogHeroAccent = blogHeroWords.Length > 0
        ? string.Join(" ", blogHeroWords.Skip(Math.Max(0, blogHeroWords.Length - blogHeroAccentCount)))
        : Model.H1;
}



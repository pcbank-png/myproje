<section class="nsx-blog-detail-page@(Model.IsLanding ? string.Empty : " nsx-blog-detail-page--guide")">
    <header class="nsx-blog-detail-hero">
        <div class="container">
            <div class="nsx-blog-detail-copy">
                <div class="nsx-blog-kicker">@(Model.IsLanding ? "NSX Yazılım Çözümü" : "NSX Yazılım Rehberi")</div>
                <h1><span class="nsx-short-hero-white">@blogHeroMain</span><span class="nsx-short-hero-orange">@blogHeroAccent</span></h1>
                <p>@Model.Description</p>

                <div class="nsx-blog-detail-meta" aria-label="Yazı bilgileri">
                    <span>NSX Yazılım</span>
                    <span><time datetime="@Model.PublishedAt.ToString("O")">@ViewBag.PublishedDateText</time></span>
                    <span><time datetime="@Model.ModifiedAt.ToString("O")">@Model.ModifiedAt.ToString("dd.MM.yyyy")</time></span>
                </div>
            </div>

            <figure class="nsx-blog-hero-image">
                <img src="@Model.ImageUrl" alt="@Model.ImageAlt" width="@Model.ImageWidth" height="@Model.ImageHeight" fetchpriority="high" decoding="async" />
                <figcaption>@Model.ImageAlt</figcaption>
            </figure>
        </div>
    </header>

    <div class="container nsx-blog-detail-content">
        <div class="nsx-blog-detail-layout">
            <article class="nsx-blog-article">
                @if (showFreeVeresiyePromotion)
                {
                    <div class="nsx-blog-highlight-link">
                        <a href="@veresiyeProductUrl">@veresiyeProductAnchor</a>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(relatedProductUrl))
                {
                    <section class="nsx-blog-product-access">
                        <div>
                            <div class="nsx-blog-kicker">Hızlı Ürün Erişimi</div>
                            <h2>@relatedProductName</h2>
                            <p>Bu sayfadan direkt indirme işlemine başlayabilir veya ürün detay sayfasına gidebilirsiniz.</p>
                        </div>
                        <div class="nsx-blog-product-actions">
                            <a class="nsx-btn nsx-btn-primary" href="@relatedProductPrimaryUrl">@(string.IsNullOrWhiteSpace(relatedProductPrimaryText) ? "Hemen İncele" : relatedProductPrimaryText)</a>
                            @if (!string.Equals(relatedProductPrimaryUrl, relatedProductUrl, StringComparison.OrdinalIgnoreCase))
                            {
                                <a class="nsx-btn nsx-btn-light" href="@relatedProductUrl">Detay Sayfasına Git</a>
                            }
                        </div>
                    </section>
                }

                @if (isFreeVeresiyeLanding)
                {
                    <section class="nsx-blog-video-block">
                        <div class="nsx-blog-video-head">
                            <div>
                                <div class="nsx-blog-kicker">Kurulum Videosu + Güncel Sürüm</div>
                                <h2>NSX Veresiye Takip Pro Kurulum ve Kullanım Videosu</h2>
                                <p>Videoda masaüstü programının kurulum ve temel kullanım adımlarını izleyebilirsiniz. Güncel v1.0.5 sürümünde bunlara ek olarak QR ile Bulut ve Mobil Yönetim, canlı senkronizasyon, mobil müşteri arama, cari hareket, borç ve tahsilat özellikleri bulunur.</p>
                            </div>
                            <a class="nsx-btn nsx-btn-primary" href="@veresiyeProductUrl">Programı Ücretsiz İndir</a>
                        </div>

                        <div class="nsx-blog-video-frame">
                            <iframe
                                src="@veresiyeVideoEmbedUrl"
                                title="NSX Veresiye Takip Pro Kurulum ve Kullanım Videosu"
                                loading="lazy"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen>
                            </iframe>
                        </div>

                        <p class="nsx-blog-video-note"><strong>v1.0.5 güncel sürüm notu:</strong> Video temel masaüstü akışını anlatır. Yeni Bulut ve Mobil sistemde Cloud Bağlantısı ekranından QR oluşturabilir, telefondan müşteri arayabilir, cari hareketleri görebilir, borç ve tahsilat kaydedebilirsiniz.</p>
                    </section>
                }

                <div class="nsx-blog-article-body">
                    @foreach (var paragraph in (Model.Body ?? string.Empty).Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries))
                    {
                        <p>@paragraph.Trim()</p>
                    }
                </div>

                @if (Model.Sections?.Length > 0)
                {
                    <section class="nsx-blog-info-section nsx-blog-seo-sections">
                        @foreach (var seoSection in Model.Sections ?? Array.Empty<NSYazilim.Web.Controllers.BlogController.SeoSection>())
                        {
                            <h2>@seoSection.Heading</h2>
                            <p>@seoSection.Content</p>
                        }
                    </section>
                }

                @if (showFreeVeresiyePromotion)
                {
                    <p class="nsx-blog-inline-link">
                        <a href="@veresiyeProductUrl">@veresiyeProductAnchor</a>
                    </p>
                }

                @if (Model.Faqs?.Length > 0)
                {
                    <section class="nsx-blog-faq">
                        <div class="nsx-blog-kicker">Merak Edilenler</div>
                        <h2>Sıkça Sorulan Sorular</h2>
                        <div class="nsx-blog-faq-grid">
                            @foreach (var faq in Model.Faqs ?? Array.Empty<NSYazilim.Web.Controllers.BlogController.SeoFaq>())
                            {
                                <div>
                                    <strong>@faq.Question</strong>
                                    <p>@faq.Answer</p>
                                </div>
                            }
                        </div>
                    </section>
                }
                else if (showFreeVeresiyePromotion)
                {
                    <section class="nsx-blog-faq">
                        <div class="nsx-blog-kicker">Merak Edilenler</div>
                        <h2>Sıkça Sorulan Sorular</h2>
                        <div class="nsx-blog-faq-grid">
                            <div>
                                <strong>NSX Veresiye Takip Pro ücretsiz mi?</strong>
                                <p>Evet. Program ücretsiz kullanım için sunulur; güncel v1.0.5 sürümünde masaüstü cari takibe ek olarak Bulut ve Mobil Yönetim özellikleri bulunur.</p>
                            </div>
                            <div>
                                <strong>Bakkal ve marketler için uygun mu?</strong>
                                <p>Evet. Bakkal, market, bayi ve küçük işletmeler müşteri cari hesaplarını masaüstünden ve QR ile bağlanan mobil panelden takip edebilir.</p>
                            </div>
                            <div>
                                <strong>Cari hesap telefondan yönetilebilir mi?</strong>
                                <p>Evet. Mobil panelde müşteri aranır; cari hareketleri açılır ve borç veya tahsilat aynı müşteri hesabından kaydedilebilir.</p>
                            </div>
                            <div>
                                <strong>Masaüstü ve mobil veriler nasıl güncel kalır?</strong>
                                <p>Canlı senkronizasyon, masaüstü ve mobil tarafta yapılan cari değişikliklerin iki tarafta güncel tutulmasına yardımcı olur.</p>
                            </div>
                        </div>
                    </section>
                }

                <section class="nsx-blog-info-section">
                    @if (showFreeVeresiyePromotion)
                    {
                        <h2>Kimler için uygundur?</h2>
                        <p>Bakkal, market, bayi, esnaf ve müşteri bazlı borç-tahsilat takibi yapan küçük ve orta ölçekli işletmeler için uygundur. Masaüstünde çalışmaya devam ederken gerektiğinde cep telefonundan cari hesaplara erişmek isteyen işletmelere sade bir Bulut ve Mobil kullanım sunar.</p>

                        <h2>NSX Veresiye v1.0.5 yaklaşımı</h2>
                        <p>Masaüstü hızını koruyup mobil tarafta yalnızca günlük ihtiyaçlara odaklanır: toplam borç, toplam tahsilat, açık bakiye, müşteri arama, cari hareketler, borç ve tahsilat. Mevcut veriler korunarak Bulut ve Mobil erişim mevcut programa eklenir.</p>
                    }
                    else
                    {
                        <h2>Kimler için uygundur?</h2>
                        <p>İşini daha düzenli takip etmek, lisanslı veya ücretsiz yazılım kullanmak ve süreçlerini dijitalleştirmek isteyen işletmeler için uygundur.</p>

                        <h2>NSX Yazılım yaklaşımı</h2>
                        <p>NSX Yazılım; hızlı kullanım, sade arayüz, güvenli dijital teslimat, güncelleme desteği ve destek odaklı çözümler geliştirmeyi hedefler.</p>
                    }
                </section>

                <div class="nsx-blog-final-actions">
                    @if (showFreeVeresiyePromotion)
                    {
                        <a class="nsx-btn nsx-btn-primary" href="@veresiyeProductUrl">NSX Veresiye Programı Ürün Sayfası</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(relatedProductUrl))
                    {
                        <a class="nsx-btn nsx-btn-primary" href="@relatedProductPrimaryUrl">@(string.IsNullOrWhiteSpace(relatedProductPrimaryText) ? "Hemen İncele" : relatedProductPrimaryText)</a>
                        <a class="nsx-btn nsx-btn-light" href="@relatedProductUrl">Detay Sayfasına Git</a>
                    }
                    else
                    {
                        <a class="nsx-btn nsx-btn-primary" href="@(string.IsNullOrWhiteSpace(Model.CtaUrl) ? "/store" : Model.CtaUrl)">@(string.IsNullOrWhiteSpace(Model.CtaText) ? "Ürünleri İncele" : Model.CtaText)</a>
                    }
                    <a class="nsx-btn nsx-btn-light" href="/iletisim">İletişime Geç</a>
                </div>
            </article>

            <aside class="nsx-blog-sidebar">
                <section class="nsx-blog-sidebar-card">
                    <span class="nsx-blog-sidebar-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6.5 3.5h8l3 3v14h-11z" />
                            <path d="M14.5 3.5v3h3M9 11h6M9 14.5h6M9 18h4" />
                        </svg>
                    </span>
                    <div class="nsx-blog-kicker">Rehber Bilgisi</div>
                    <h2>NSX Yazılım Rehberi</h2>
                    <p>İş süreçlerinizi daha düzenli yönetmenize yardımcı olacak sade ve uygulanabilir bilgiler.</p>
                    <dl>
                        <div><dt>Yayın</dt><dd>@Model.PublishedAt.ToString("dd.MM.yyyy")</dd></div>
                        <div><dt>Güncelleme</dt><dd>@Model.ModifiedAt.ToString("dd.MM.yyyy")</dd></div>
                        <div><dt>Yayıncı</dt><dd>NSX Yazılım</dd></div>
                    </dl>
                    <a class="nsx-blog-sidebar-link" href="/blog">Tüm rehberleri görüntüle <i class="bi bi-arrow-right"></i></a>
                </section>

                @if (Model.Keywords?.Any() == true)
                {
                    <section class="nsx-blog-sidebar-card compact">
                        <div class="nsx-blog-kicker">Konu Başlıkları</div>
                        <div class="nsx-blog-tags">
                            @foreach (var keyword in Model.Keywords.Take(7))
                            {
                                <span>@keyword</span>
                            }
                        </div>
                    </section>
                }
            </aside>
        </div>

        @if (relatedPages.Any())
        {
            <section class="nsx-blog-related">
                <div class="nsx-blog-related-head">
                    <div>
                        <span>İlgili Rehberler</span>
                        <h2>Bu konuyla ilgili diğer sayfalar</h2>
                    </div>
                    <a href="/blog">Tüm rehberler <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="nsx-blog-related-grid">
                    @foreach (var item in relatedPages)
                    {
                        <a href="@(item.IsLanding ? $"/{item.Slug}" : $"/blog/{item.Slug}")">
                            <small>NSX Rehber</small>
                            <strong>@item.H1</strong>
                            <span>@item.Description</span>
                        </a>
                    }
                </div>
            </section>
        }
    </div>
</section>

@functions {
    public bool IsVeresiyeRelated(NSYazilim.Web.Controllers.BlogController.SeoPage page)
    {
        return page.Slug is
            "ucretsiz-veresiye-programi" or
            "veresiye-programi-nedir" or
            "ucretsiz-veresiye-programi-nedir" or
            "ucretsiz-cari-takip-programi" or
            "esnaflar-icin-veresiye-takip-programi" or
            "borc-alacak-takip-programi-ucretsiz" or
            "bakkal-veresiye-defteri-nasil-tutulur" or
            "cari-hesap-takibi-nasil-yapilir" or
            "excel-yerine-veresiye-takip-programi" or
            "veresiye-defteri-programi" or
            "ucretsiz-cari-hesap-programi" or
            "veresiye-cari-takip-programi-pro";
    }
}

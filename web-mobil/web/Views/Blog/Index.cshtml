    .nsx-blog-redesign-hero .nsx-blog-redesign-stats span,
    .nsx-blog-detail-hero .nsx-blog-detail-meta span{
        display:inline-flex!important;align-items:center!important;gap:7px!important;min-height:34px!important;padding:0 11px!important;
        border:1px solid rgba(255,255,255,.15)!important;border-radius:999px!important;background:rgba(255,255,255,.045)!important;
        color:#d9dee4!important;font-family:var(--nsx-font,"Segoe UI",Arial,sans-serif)!important;font-size:10px!important;font-weight:800!important;
    }
    .nsx-blog-redesign-hero .nsx-blog-redesign-stats strong,
    .nsx-blog-detail-hero .nsx-blog-detail-meta i{color:#39d98a!important;font-size:11px!important;}

    @@media(max-width:1180px){
        .nsx-blog-redesign-hero .nsx-blog-redesign-intro h1,
        .nsx-blog-detail-hero .nsx-blog-detail-copy h1{font-size:38px!important;}
    }
    @@media(max-width:680px){
        .nsx-blog-redesign-hero .nsx-blog-redesign-intro h1,
        .nsx-blog-detail-hero .nsx-blog-detail-copy h1{font-size:30px!important;}
        .nsx-blog-redesign-hero .nsx-blog-redesign-intro > p,
        .nsx-blog-detail-hero .nsx-blog-detail-copy > p{font-size:13px!important;line-height:1.7!important;}
    }
    @@media(max-width:430px){
        .nsx-blog-redesign-hero .nsx-blog-redesign-stats,
        .nsx-blog-detail-hero .nsx-blog-detail-meta{gap:7px!important;}
        .nsx-blog-redesign-hero .nsx-blog-redesign-stats span,
        .nsx-blog-detail-hero .nsx-blog-detail-meta span{width:100%!important;justify-content:center!important;}
    }
</style>

<section class="nsx-blog-index-page nsx-blog-redesign">
    <header class="nsx-blog-redesign-hero">
        <div class="container">
            <div class="nsx-blog-redesign-intro">
                <span class="nsx-blog-redesign-kicker"><i></i> NSX Bilgi Merkezi</span>
                <h1>İşinizi büyüten <em>uygulanabilir rehberler.</em></h1>
                <p>Yazılım seçimi, günlük operasyonlar ve dijital iş süreçleri için sade, güvenilir ve doğrudan uygulanabilir içerikler.</p>
                <div class="nsx-blog-redesign-stats" aria-label="Blog bilgileri">
                    <span><strong>@Model.Count</strong> güncel rehber</span>
                    <span><strong>@categories.Count</strong> uzmanlık alanı</span>
                    <span><strong>NSX</strong> saha deneyimi</span>
                </div>
            </div>
        </div>
    </header>

    <div class="container nsx-blog-index-content">
        @if (featured != null)
        {
            var featuredUrl = ArticleUrl(featured);
            <article class="nsx-blog-featured-card" data-blog-category="@ArticleCategory(featured)">
                <a class="nsx-blog-featured-media" href="@featuredUrl" aria-label="@featured.H1 rehberini oku">
                    <img src="@featured.ImageUrl" alt="@featured.ImageAlt" width="@featured.ImageWidth" height="@featured.ImageHeight" decoding="async" />
                    <span>Öne çıkan rehber</span>
                </a>
                <div>
                    <small>@ArticleCategory(featured) · @featured.PublishedAt.ToString("dd.MM.yyyy")</small>
                    <h2><a href="@featuredUrl">@featured.H1</a></h2>
                    <p>@featured.Description</p>
                    <a class="nsx-blog-featured-link" href="@featuredUrl">Rehberi incele <i class="bi bi-arrow-up-right"></i></a>
                </div>
            </article>
        }

        <div class="nsx-blog-redesign-toolbar">
            <div>
                <span>Rehber arşivi</span>
                <h2>İhtiyacınıza göre keşfedin</h2>
            </div>
            <div class="nsx-blog-filters" role="group" aria-label="Rehber kategorileri">
                <button type="button" class="active" data-blog-filter="all" aria-pressed="true">Tüm Rehberler</button>
                @foreach (var category in categories)
                {
                    <button type="button" data-blog-filter="@category" aria-pressed="false">@category</button>
                }
            </div>
        </div>

        @if (articles.Any())
        {
            <div class="nsx-blog-redesign-grid" id="nsxBlogGrid">
                @foreach (var item in articles)
                {
                    var itemUrl = ArticleUrl(item);
                    var category = ArticleCategory(item);
                    <article class="nsx-blog-redesign-card" data-blog-category="@category">
                        <a class="nsx-blog-redesign-media" href="@itemUrl" aria-label="@item.H1 rehberini oku">
                            <img src="@item.ImageUrl" alt="@item.ImageAlt" width="@item.ImageWidth" height="@item.ImageHeight" loading="lazy" decoding="async" />
                            <span>@category</span>
                        </a>
                        <div class="nsx-blog-redesign-content">
                            <div class="nsx-blog-redesign-meta">
                                <span>@item.PublishedAt.ToString("dd.MM.yyyy")</span>
                                <span>NSX Rehber</span>
                            </div>
                            <h2><a href="@itemUrl">@item.H1</a></h2>
                            <p>@item.Description</p>
                            <a class="nsx-blog-redesign-link" href="@itemUrl">Okumaya devam et <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </article>
                }
            </div>
        }
        else if (featured == null)
        {
            <div class="nsx-blog-redesign-empty">
                <strong>Yeni rehberler hazırlanıyor.</strong>
                <p>Bu sırada NSX yazılımlarını inceleyebilirsiniz.</p>
                <a href="/yazilimlar">Yazılımları keşfet</a>
            </div>
        }

        <section class="final-cta nsx-blog-home-cta">
            <div class="cta-glow"></div>
            <div class="cta-copy">
                <span class="cta-logo"><img src="/nsx-assets/logo-brand.webp" asp-append-version="true" alt="NSX Yazılım" width="1511" height="397" loading="lazy" decoding="async" fetchpriority="low" /></span>
                <small class="nsx-blog-home-cta-kicker">Doğru çözümü birlikte seçelim</small>
                <h2>İşletmeniz için hangi yazılımın uygun olduğundan emin değil misiniz?</h2>
                <p>İhtiyacınızı anlatın; size uygun NSX ürününü ve kullanım yolunu birlikte netleştirelim.</p>
            </div>
            <div class="cta-actions">
                <a class="primary-button" href="/iletisim">Uzman desteği alın <span>→</span></a>
                <a class="primary-button" href="/yazilimlar">Tüm yazılımlar <span>→</span></a>
            </div>
        </section>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const buttons = Array.from(document.querySelectorAll('[data-blog-filter]'));
            const cards = Array.from(document.querySelectorAll('[data-blog-category]'));
            if (!buttons.length || !cards.length) return;

            const applyFilter = (filter) => {
                const selected = (filter || 'all').trim();
                buttons.forEach(item => {
                    const active = item.dataset.blogFilter === selected;
                    item.classList.toggle('active', active);
                    item.setAttribute('aria-pressed', active ? 'true' : 'false');
                });
                cards.forEach(card => {
                    const visible = selected === 'all' || (card.dataset.blogCategory || '').trim() === selected;
                    if (visible) {
                        card.removeAttribute('hidden');
                        card.style.removeProperty('display');
                    } else {
                        card.setAttribute('hidden', 'hidden');
                        card.style.setProperty('display', 'none', 'important');
                    }
                });
            };

            buttons.forEach(button => button.addEventListener('click', () => applyFilter(button.dataset.blogFilter)));
            applyFilter('all');
        })();
    </script>
}

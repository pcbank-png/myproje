@model IReadOnlyList<NSYazilim.Web.Controllers.BlogController.SeoPage>
@inject NSYazilim.Web.Services.SiteLocalizationService Localization
@{
    var featured = Model.FirstOrDefault();
    var articles = Model.Skip(featured == null ? 0 : 1).ToList();

    string ArticleUrl(NSYazilim.Web.Controllers.BlogController.SeoPage item)
        => item.IsLanding ? $"/{item.Slug}" : $"/blog/{item.Slug}";

    string ArticleCategorySource(NSYazilim.Web.Controllers.BlogController.SeoPage item)
    {
        return item.Slug switch
        {
            "veresiye-programi-nedir" or
            "ucretsiz-veresiye-programi-nedir" or
            "ucretsiz-cari-takip-programi" or
            "esnaflar-icin-veresiye-takip-programi" or
            "borc-alacak-takip-programi-ucretsiz" or
            "bakkal-veresiye-defteri-nasil-tutulur" or
            "cari-hesap-takibi-nasil-yapilir" or
            "excel-yerine-veresiye-takip-programi" or
            "veresiye-defteri-programi" or
            "ucretsiz-cari-hesap-programi" or
            "veresiye-cari-takip-programi-pro" or
            "nsx-cari-takip-pro-programi" or
            "nsx-cari-takip-pro-bulut-programi" or
            "nsx-komisyonlu-cari-takip-pro" => "Cari ve Veresiye",

            "oto-tamir-programi" or
            "oto-galeri-programi" or
            "oto-galeri-yonetim-programi" or
            "oto-tamir-servis-yonetim-programi" => "Otomotiv",

            "ucretsiz-teknik-servis-programi" or
            "nsx-veri-kurtarma-pro-programi" or
            "servis-live-programi" or
            "teknik-servis-takip-programi" or
            "nsx-servispro-live-teknik-servis-programi" or
            "nsx-teknik-servis-pro-programi" => "Servis Yönetimi",

            "klinik-programi" or
            "randevu-programi" or
            "klinik-randevu-takip-programi" or
            "dugun-salonu-yonetim-programi" or
            "nsx-sigorta-acente-pro-programi" => "İşletme Yönetimi",

            "nsx-barkodlu-satis-cari-stok-takip-pro" => "Satış ve Stok",
            "nsx-kasa-defteri-pro-programi" => "Finans ve Kasa",
            "nsx-security-auditor-pro-kod-guvenlik-analizi" => "Yazılım Güvenliği",
            "ucretsiz-bilgisayar-hizlandirma-programi" or
            "bilgisayar-hizlandirma-programi" or
            "oyun-hizlandirma-fps-artirma-programi" => "Teknoloji",
            _ => "Dijital Dönüşüm"
        };
    }

    var categoryTranslations = new Dictionary<string, string>(StringComparer.Ordinal);
    foreach (var sourceCategory in Model.Select(ArticleCategorySource).Distinct(StringComparer.Ordinal))
    {
        categoryTranslations[sourceCategory] = await Localization.TranslateAsync(
            sourceCategory,
            cancellationToken: Context.RequestAborted);
    }

    string ArticleCategory(NSYazilim.Web.Controllers.BlogController.SeoPage item)
    {
        var source = ArticleCategorySource(item);
        return categoryTranslations.TryGetValue(source, out var translated) ? translated : source;
    }

    var categories = Model.Select(ArticleCategory).Distinct().OrderBy(x => x).ToList();
}



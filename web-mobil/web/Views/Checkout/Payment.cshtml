<main class="nsx-payment-choice-page">
    <section class="nsx-payment-choice-shell">
        <header class="nsx-payment-choice-head">
            <a href="@productUrl" class="nsx-payment-choice-back" aria-label="@backLabel">←</a>
            <div class="nsx-payment-choice-headcopy">
                <span>@securePayment</span>
                <h1>@heading</h1>
                <p>@intro</p>
            </div>
            <aside class="nsx-payment-security" aria-label="@sslText">
                <span class="nsx-payment-security__shield" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.5 19 5v5.7c0 4.6-2.7 8.4-7 10.8-4.3-2.4-7-6.2-7-10.8V5l7-2.5Z" stroke="currentColor" stroke-width="1.7"/><rect x="8.8" y="10.4" width="6.4" height="5.3" rx="1.2" stroke="currentColor" stroke-width="1.5"/><path d="M10.2 10.4V8.9a1.8 1.8 0 0 1 3.6 0v1.5" stroke="currentColor" stroke-width="1.5"/></svg>
                </span>
                <strong>@sslText</strong>
            </aside>
        </header>

        <div class="nsx-payment-choice-product">
            <img src="@mainImage" alt="@productName" />
            <div class="nsx-payment-choice-product__meta">
                <small>@selectedProduct</small>
                <strong>@productName</strong>
                <span>@licenseLabel</span>
            </div>
            <div class="nsx-payment-choice-amount">
                <small>@amountLabel</small>
                <b>@Model.Amount.ToString("N2", displayCulture) ₺</b>
            </div>
        </div>

        <div class="nsx-payment-choice-grid">
            <section class="nsx-payment-choice-card is-primary @(Model.ShopierAvailable ? "" : "is-disabled")">
                <span class="nsx-payment-choice-ribbon">@recommended</span>
                <div class="nsx-payment-choice-cardtop">
                    <span class="nsx-payment-choice-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2.5" stroke="currentColor" stroke-width="1.7"/><path d="M3 9h18M7 15h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                    </span>
                    <div class="nsx-payment-choice-cardcopy">
                        <small>@(Model.ShopierAvailable ? recommended : cardPaymentLabel)</small>
                        <h2>@cardTitle</h2>
                        <p>@(Model.ShopierAvailable ? cardDescription : cardUnavailable)</p>
                    </div>
                    <div class="nsx-credit-card-demo" aria-hidden="true">
                        <div class="nsx-credit-card-demo__top"><span class="nsx-credit-card-demo__chip"></span><span class="nsx-credit-card-demo__wave">)))</span></div>
                        <div class="nsx-credit-card-demo__number">••••  ••••  ••••  4242</div>
                        <div class="nsx-credit-card-demo__bottom"><span>NSX YAZILIM</span><span>12/28</span></div>
                    </div>
                </div>

                <div class="nsx-payment-benefits">
                    <span><i>✓</i>@instantPayment</span>
                    <span><i>✓</i>@sslSecurity</span>
                    <span><i>✓</i>@allCards</span>
                </div>

                <div class="nsx-payment-card-brands">
                    @await Html.PartialAsync("_PaymentBrandMarks")
                </div>

                @if (Model.ShopierAvailable)
                {
                    <a class="nsx-payment-choice-cta" href="@Model.ShopierUrl" rel="nofollow noopener">
                        <span aria-hidden="true">🔒</span><span>@cardCta</span><span aria-hidden="true">→</span>
                    </a>
                    <div class="nsx-payment-choice-note">
                        <span>@verifyLicense <strong>@licenseLabel</strong></span>
                        @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                        {
                            <span>@emailDelivery <strong>@Model.CustomerEmail</strong></span>
                        }
                    </div>
                }
                else
                {
                    <div class="nsx-payment-choice-disabled-status">@matchingPending</div>
                }
            </section>

            <section class="nsx-payment-choice-card">
                <div class="nsx-payment-choice-cardtop nsx-bank-cardtop">
                    <span class="nsx-payment-choice-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M3 9.2 12 4l9 5.2M5 10v7.5M9.5 10v7.5M14.5 10v7.5M19 10v7.5M3 19.5h18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <div class="nsx-payment-choice-cardcopy">
                        <small>@bankKicker</small>
                        <h2>@bankTitle</h2>
                        <p>@bankDescription</p>
                    </div>
                </div>

                <div class="nsx-payment-benefits">
                    <span><i>✓</i>@allBanks</span>
                    <span><i>✓</i>@practical</span>
                    <span><i>✓</i>@fastApproval</span>
                </div>

                <div class="nsx-bank-feature">
                    <span class="nsx-bank-feature__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M3 9.2 12 4l9 5.2M5 10v7.5M9.5 10v7.5M14.5 10v7.5M19 10v7.5M3 19.5h18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <span><strong>@viewBankInfo</strong><small>@bankInfoDetail</small></span>
                    <b aria-hidden="true">›</b>
                </div>

                <a class="nsx-payment-choice-cta is-secondary" href="@bankTransferUrl"><span>@bankCta</span><span aria-hidden="true">→</span></a>
            </section>
        </div>

        <div class="nsx-payment-trustbar">
            <div class="nsx-payment-trustbar__item">
                <span class="nsx-payment-trustbar__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.5 19 5v5.7c0 4.6-2.7 8.4-7 10.8-4.3-2.4-7-6.2-7-10.8V5l7-2.5Z" stroke="currentColor" stroke-width="1.7"/><path d="m8.7 12.1 2.1 2.1 4.7-4.7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span><strong>@secureInfrastructure</strong><small>@secureInfrastructureText</small></span>
            </div>
            <div class="nsx-payment-trustbar__brands">@await Html.PartialAsync("_PaymentBrandMarks")</div>
            <div class="nsx-payment-trustbar__item">
                <span class="nsx-payment-trustbar__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M3 9.2 12 4l9 5.2M5 10v7.5M9.5 10v7.5M14.5 10v7.5M19 10v7.5M3 19.5h18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>

@@media(max-width:650px){.nsx-payment-choice-page{padding:28px 12px 48px}.nsx-payment-choice-head{grid-template-columns:42px 1fr}.nsx-payment-security{display:none}.nsx-payment-choice-product{grid-template-columns:52px 1fr}.nsx-payment-choice-product img{width:52px;height:52px}.nsx-payment-choice-amount{grid-column:2;justify-items:start;padding:6px 0 0;border-inline-start:0}.nsx-payment-choice-card{padding:17px}.nsx-payment-choice-cardtop{grid-template-columns:52px 1fr}.nsx-payment-choice-icon{width:52px;height:52px}.nsx-credit-card-demo{grid-column:1 / -1;width:100%;height:108px}.nsx-payment-benefits{grid-template-columns:1fr}.nsx-payment-brands{gap:10px;justify-content:space-between}.nsx-payment-brand--visa{font-size:23px}.nsx-payment-brand--troy{font-size:22px}.nsx-payment-brand--amex{width:54px;height:33px}.nsx-payment-choice-head h1{font-size:30px}.nsx-payment-choice-head p{font-size:12.5px}}

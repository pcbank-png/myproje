@model NSYazilim.Web.ViewModels.CheckoutPaymentViewModel
@using System.Globalization
@using NSYazilim.Web.Services
@inject SiteLocalizationService SiteLocalization
@inject SeoLanguageUrlService SeoLanguageUrls
@{
    var currentLanguage = await SiteLocalization.GetCurrentLanguageAsync(Context.RequestAborted);
    async Task<string> T(string source)
    {
        var translated = await SiteLocalization.TranslateAsync(source, currentLanguage.Code, Context.RequestAborted);
        return CheckoutUiTranslations.Resolve(source, currentLanguage.Code, translated);
    }

    var pageTitle = await T("Ödeme Yöntemi | NSX Yazılım");
    ViewData["Title"] = pageTitle;
    ViewData["Robots"] = "noindex, nofollow, noarchive";

    CultureInfo displayCulture;
    try
    {
        displayCulture = CultureInfo.GetCultureInfo(currentLanguage.Code);
    }
    catch (CultureNotFoundException)
    {
        displayCulture = CultureInfo.GetCultureInfo("tr-TR");
    }
    var mainImage = Model.Product.Images?.OrderByDescending(x => x.IsMain).ThenBy(x => x.SortOrder).FirstOrDefault()?.ImagePath
        ?? "/nsx-assets/logo-brand.webp";
    var productName = await SiteLocalization.TranslateAsync(Model.Product.Name, currentLanguage.Code, Context.RequestAborted);
    var licenseLabel = await T(Model.LicenseLabel);
    var productUrl = await SeoLanguageUrls.BuildLocalizedReturnUrlAsync(Model.ProductUrl, currentLanguage, Context.RequestAborted);
    var bankTransferUrl = await SeoLanguageUrls.BuildLocalizedReturnUrlAsync(Model.BankTransferUrl, currentLanguage, Context.RequestAborted);

    var backLabel = await T("Ürüne dön");
    var securePayment = await T("GÜVENLİ ÖDEME");
    var heading = await T("Ödeme yöntemini seçin");
    var intro = await T("Kartla Shopier üzerinden anında ödeme yapabilir veya Havale / EFT ile devam edebilirsiniz.");
    var sslText = await T("Ödemeleriniz 256-bit SSL ile koruma altındadır.");
    var selectedProduct = await T("Seçili ürün");
    var amountLabel = await T("Tutar");
    var recommended = await T("ÖNERİLEN");
    var cardPaymentLabel = await T("KARTLA ÖDEME");
    var cardTitle = await T("Banka / Kredi Kartı");
    var cardDescription = await T("Shopier güvenli ödeme altyapısı üzerinden kartınızla hızlı ve güvenli ödeme yapın.");
    var instantPayment = await T("Anında ödeme");
    var sslSecurity = await T("256-bit SSL güvenliği");
    var allCards = await T("Tüm yaygın kartlarla ödeme");
    var cardCta = await T("Shopier ile Güvenli Öde");
    var verifyLicense = await T("Shopier ekranında lisans seçiminizi doğrulayın.");
    var emailDelivery = await T("Otomatik lisans teslimatı için Shopier'de hesabınızdaki e-posta adresini kullanın:");
    var cardUnavailable = await T("Bu ürün için kartla ödeme bağlantısı henüz tanımlı değil.");
    var matchingPending = await T("Shopier eşleştirmesi bekleniyor");
    var bankKicker = await T("BANKA TRANSFERİ");
    var bankTitle = await T("Havale / EFT");
    var bankDescription = await T("Banka hesabımıza havale yaptıktan sonra ödeme bildiriminizi gönderin. Onay sonrası lisansınız hesabınıza tanımlanır.");
    var allBanks = await T("Tüm bankalardan ödeme");
    var practical = await T("Güvenli ve pratik");
    var fastApproval = await T("Onay sonrası hızlı işlem");
    var viewBankInfo = await T("Banka bilgilerimizi görüntüleyin");
    var bankInfoDetail = await T("Havale / EFT için gerekli hesap bilgileri, açıklama ve ödeme sonrası adımlar.");
    var bankCta = await T("Banka Bilgilerini Gör");
    var secureInfrastructure = await T("Güvenli Ödeme Altyapısı");
    var secureInfrastructureText = await T("Kart ödemeleri Shopier güvenli ödeme altyapısı üzerinden tamamlanır.");
    var transferPayment = await T("Havale / EFT ile Ödeme");
    var transferPaymentText = await T("Ödeme onayından sonra dijital lisansınız hesabınıza tanımlanır.");
    var digitalDelivery = await T("Dijital teslimat");
    var secureLicensing = await T("Güvenli lisanslama");
    var technicalSupport = await T("NSX teknik destek");
}

<style id="nsx-checkout-payment-pro-v3">

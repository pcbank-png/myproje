dth:62px;height:62px;border-radius:17px;background:#f2f6fb;color:#233d60}.nsx-payment-choice-icon svg{width:32px;height:32px}.is-primary .nsx-payment-choice-icon{background:#fff0e5;color:#c34f00}.nsx-payment-choice-cardcopy{display:grid;gap:6px}.nsx-payment-choice-cardcopy small{color:#8490a2;font-size:9.5px;font-weight:900;letter-spacing:.12em}.nsx-payment-choice-cardcopy h2{margin:0;color:#132038;font-size:20px;font-weight:900;letter-spacing:-.02em}.nsx-payment-choice-cardcopy p{margin:0;color:#637287;font-size:12.5px;line-height:1.55}.nsx-credit-card-demo{width:178px;height:104px;padding:14px;border-radius:16px;background:radial-gradient(circle at 76% 26%,#30353d 0 17%,transparent 18%),linear-gradient(145deg,#343a42,#11151a 65%);box-shadow:0 13px 28px rgba(12,17,24,.2);color:#fff;display:grid;grid-template-rows:auto 1fr auto;gap:6px}.nsx-credit-card-demo__top{display:flex;align-items:center;justify-content:space-between}.nsx-credit-card-demo__chip{width:25px;height:18px;border-radius:5px;background:linear-gradient(135deg,#f6d98a,#c99c3e)}.nsx-credit-card-demo__wave{font-size:18px;opacity:.85;transform:rotate(90deg)}.nsx-credit-card-demo__number{align-self:center;font-size:12px;letter-spacing:.12em}.nsx-credit-card-demo__bottom{display:flex;justify-content:space-between;color:#cbd1d7;font-size:7px;letter-spacing:.08em}.nsx-payment-benefits{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:18px 0 14px}.nsx-payment-benefits span{display:flex;align-items:center;gap:7px;color:#627086;font-size:10px;line-height:1.25}.nsx-payment-benefits i{display:grid;place-items:center;width:20px;height:20px;flex:none;border-radius:50%;background:#fff0e6;color:#ff6e04;font-style:normal;font-size:11px;font-weight:900}.nsx-payment-card-brands{margin-top:2px;padding:11px 14px;border:1px solid #e6eaf0;border-radius:15px;background:#fbfcfe}.nsx-payment-brands{display:flex;align-items:center;justify-content:space-around;gap:20px;min-height:42px}.nsx-payment-brand{display:inline-flex;align-items:center;justify-content:center;flex:none;white-space:nowrap}.nsx-payment-brand--visa{color:#1a2a76;font-size:29px;font-weight:1000;font-style:italic;letter-spacing:-.08em}.nsx-payment-brand--mastercard{position:relative;display:grid;justify-items:center;gap:0}.nsx-payment-brand__mc-circles{position:relative;display:block;width:45px;height:27px}.nsx-payment-brand__mc-circles b{position:absolute;top:1px;width:25px;height:25px;border-radius:50%}.nsx-payment-brand__mc-circles b:first-child{left:2px;background:#e91d2d}.nsx-payment-brand__mc-circles b:last-child{right:2px;background:#f7a61b;opacity:.94}.nsx-payment-brand--mastercard small{margin-top:-1px;color:#171717;font-size:7px;font-weight:800}.nsx-payment-brand--amex{display:grid;place-items:center;width:61px;height:37px;padding:3px;border-radius:3px;background:#1478c9;color:#fff;font-size:8.5px;font-weight:1000;line-height:.9;letter-spacing:-.05em;text-shadow:0 1px rgba(0,0,0,.18)}.nsx-payment-brand--troy{color:#333b46;font-size:28px;font-weight:1000;font-style:italic;letter-spacing:-.08em}.nsx-payment-brand--troy span{margin-inline-start:1px;color:#26a8a4;font-size:12px}.nsx-payment-choice-cta{display:flex;align-items:center;justify-content:center;gap:9px;min-height:48px;margin-top:14px;border:1px solid #ff6e04;border-radius:13px;background:linear-gradient(90deg,#ff6e04,#f45d00);box-shadow:0 12px 24px rgba(255,110,4,.17);color:#fff;text-decoration:none;font-size:12.5px;font-weight:900;transition:transform .16s ease,box-shadow .16s ease}.nsx-payment-choice-cta:hover{transform:translateY(-1px);box-shadow:0 15px 28px rgba(255,110,4,.22);color:#fff}.nsx-payment-choice-note{display:grid;gap:4px;margin-top:10px;color:#788599;font-size:9.5px;line-height:1.45}.nsx-payment-choice-note strong{color:#526178}.nsx-payment-choice-disabled-status{display:flex;align-items:center;justify-content:center;min-height:48px;margin-top:auto;border:1px dashed #d7dee8;border-radius:13px;background:#f7f9fb;color:#7e8a9a;font-size:11px;font-weight:850}.nsx-bank-cardtop{grid-template-columns:62px minmax(0,1fr)}.nsx-bank-feature{display:grid;grid-template-columns:44px minmax(0,1fr) auto;align-items:center;gap:11px;margin-top:18px;padding:12px;border:1px solid #e5eaf0;border-radius:15px;background:#f8fafc}.nsx-bank-feature__icon{display:grid;place-items:center;width:44px;height:44px;border-radius:12px;background:#eef3f8;color:#233d60}.nsx-bank-feature__icon svg{width:23px;height:23px}.nsx-bank-feature strong{display:block;color:#2a384d;font-size:11px}.nsx-bank-feature small{display:block;margin-top:3px;color:#7b8797;font-size:9px;line-height:1.35}.nsx-bank-feature>b{color:#718096;font-size:18px}.nsx-payment-choice-cta.is-secondary{margin-top:auto;border-color:#d7dfe9;background:#fff;box-shadow:none;color:#233d60}.nsx-payment-choice-cta.is-secondary:hover{border-color:#aebdd0;background:#f9fbfd;color:#233d60}.nsx-payment-trustbar{display:grid;grid-template-columns:minmax(240px,1fr) auto minmax(220px,.8fr);align-items:center;gap:20px;margin-top:17px;padding:13px 16px;border:1px solid #e1e6ed;border-radius:17px;background:#fff;box-shadow:0 10px 30px rgba(35,61,96,.045)}.nsx-payment-trustbar__item{display:flex;align-items:center;gap:10px;min-width:0}.nsx-payment-trustbar__icon{display:grid;place-items:center;width:40px;height:40px;flex:none;border-radius:12px;background:#fff1e7;color:#ff6e04}.nsx-payment-trustbar__icon svg{width:22px;height:22px}.nsx-payment-trustbar__item strong{display:block;color:#27354a;font-size:10.5px}.nsx-payment-trustbar__item small{display:block;margin-top:2px;color:#7c8898;font-size:8.5px;line-height:1.35}.nsx-payment-trustbar__brands{min-width:315px;padding:0 18px;border-inline:1px solid #e8ecf1}.nsx-payment-choice-trust{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:17px;color:#66758a;font-size:10px}.nsx-payment-choice-trust span{padding:7px 11px;border-radius:999px;background:#f5f8fb}

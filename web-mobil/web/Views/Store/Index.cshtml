@model IEnumerable<NSYazilim.Web.Models.Product>
@using System.Globalization
@using System.Text.Json
@using System.Text.Encodings.Web
@using NSYazilim.Web.Services
@inject NSYazilim.Web.Services.SiteLocalizationService SiteLocalization
@inject NSYazilim.Web.Services.SeoLanguageUrlService SeoLanguageUrls
@{
    Layout = null;
    var currentLanguage = await SiteLocalization.GetCurrentLanguageAsync();
    var products = Model?.ToList() ?? new List<NSYazilim.Web.Models.Product>();
    var q = ViewBag.Query?.ToString() ?? "";
    var stock = ViewBag.Stock?.ToString() ?? "all";
    var sort = ViewBag.Sort?.ToString() ?? "recommended";
    var ratingAverage = ViewBag.RatingAverage as Dictionary<int, double> ?? new();
    var ratingCount = ViewBag.RatingCount as Dictionary<int, int> ?? new();
    var productCampaigns = ViewBag.ProductCampaigns as Dictionary<int, NSYazilim.Web.Models.Campaign> ?? new();
    var requestedCategory = ViewBag.Category?.ToString() ?? Context.Request.Query["category"].ToString().Trim();
    var storeSeoLinks = await SeoLanguageUrls.BuildAsync("/store", currentLanguage, Context.RequestAborted);
    var canonical = storeSeoLinks.CurrentUrl;
    var socialImage = SeoTextHelper.AbsoluteUrl("/nsx-assets/logo-brand.webp");
    var robots = ViewData["Robots"]?.ToString() ?? "index, follow, max-image-preview:large, max-snippet:-1";
    var pageTitle = SeoTextHelper.BuildTitle(ViewData["MetaTitle"]?.ToString() ?? "Yazılımlar");
    var pageDescription = SeoTextHelper.BuildDescription(ViewData["MetaDescription"]?.ToString());
    var pageKeywords = ViewData["MetaKeywords"]?.ToString() ?? SeoTextHelper.Keywords;
    string ProductUrl(NSYazilim.Web.Models.Product product) => !string.IsNullOrWhiteSpace(product.Slug) ? $"/urun/{product.Slug.Trim().ToLowerInvariant()}" : $"/store/detail/{product.Id}";
    string LocalizedProductUrl(NSYazilim.Web.Models.Product product) => SeoTextHelper.AbsoluteUrl(
        SeoLanguageUrlService.BuildLocalizedPath(ProductUrl(product), currentLanguage, storeSeoLinks.DefaultLanguage));
    var localizedProductNames = new Dictionary<int, string>();
    var localizedProductDescriptions = new Dictionary<int, string>();
    foreach (var product in products)
    {
        var localizedName = await SiteLocalization.TranslateAsync(product.Name, currentLanguage.Code, Context.RequestAborted);
        var seoProfile = ProductSeoCatalog.Find(product);
        // Kart özeti kısa olabilir; ancak yabancı dilde genel bir cümleye düşürülmez.
        // Önce ürünün gerçek meta açıklaması, yoksa ürünün kendi açıklamasından özet kullanılır.
        var sourceDescription = !string.IsNullOrWhiteSpace(product.MetaDescription)
            ? product.MetaDescription
            : (seoProfile?.MetaDescription ?? ProductContentSanitizer.ToPlainText(product.Description, 260));
        var localizedDescription = await SiteLocalization.TranslateAsync(sourceDescription, currentLanguage.Code, Context.RequestAborted);
        localizedProductNames[product.Id] = localizedName;
        localizedProductDescriptions[product.Id] = localizedDescription;
    }
    var localizedStoreSchemaName = await SiteLocalization.TranslateAsync("NSX Yazılımları", currentLanguage.Code, Context.RequestAborted);
    var localizedProductWord = await SiteLocalization.TranslateAsync("Ürün", currentLanguage.Code, Context.RequestAborted);
    var localizedDiscountWord = await SiteLocalization.TranslateAsync("İNDİRİM", currentLanguage.Code, Context.RequestAborted);
    var storeJsonLd = JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "ItemList",
        ["name"] = localizedStoreSchemaName,
        ["url"] = canonical,
        ["inLanguage"] = currentLanguage.Code,
        ["itemListElement"] = products.Select((product, index) => new Dictionary<string, object?>
        {
            ["@type"] = "ListItem",
            ["position"] = index + 1,
            ["name"] = localizedProductNames[product.Id],
            ["url"] = LocalizedProductUrl(product),
            ["item"] = new Dictionary<string, object?>
            {
                ["@type"] = "SoftwareApplication",
                ["name"] = localizedProductNames[product.Id],
                ["url"] = LocalizedProductUrl(product),
                ["description"] = localizedProductDescriptions[product.Id],
                ["applicationCategory"] = "BusinessApplication",
                ["operatingSystem"] = "Windows"
            }
        }).ToList()
    }, new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
}
<!DOCTYPE html>
<html lang="@currentLanguage.UrlCode" dir="@(currentLanguage.IsRtl ? "rtl" : "ltr")"><head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KYN9MQQ51T"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-KYN9MQQ51T');
    </script>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />
    <meta name="keywords" content="@pageKeywords" />
    <meta name="robots" content="@robots" />
    <meta name="author" content="Nevzat SÜRÜCÜ" /><meta name="publisher" content="NSX Yazılım" />
    <link rel="canonical" href="@canonical" />
    @await Html.PartialAsync("_SeoLanguageAlternates", storeSeoLinks)
    <link rel="sitemap" type="application/xml" title="Sitemap" href="@SeoTextHelper.AbsoluteUrl("/sitemap.xml")" />
    <meta property="og:locale" content="@currentLanguage.Code.Replace('-', '_')" /><meta property="og:type" content="website" /><meta property="og:site_name" content="NSX Yazılım" />
    <meta property="og:title" content="@pageTitle" /><meta property="og:description" content="@pageDescription" /><meta property="og:url" content="@canonical" /><meta property="og:image" content="@socialImage" /><meta property="og:image:secure_url" content="@socialImage" /><meta property="og:image:alt" content="NSX işletme yazılımları" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content="@pageTitle" /><meta name="twitter:description" content="@pageDescription" /><meta name="twitter:image" content="@socialImage" /><meta name="twitter:image:alt" content="NSX işletme yazılımları" />
    <script type="application/ld+json">@Html.Raw(storeJsonLd)</script>
    <link rel="icon" href="/favicon.ico" asp-append-version="true" /><link rel="stylesheet" href="/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="/css/public-hero-fixes.css" asp-append-version="true" /><link rel="stylesheet" href="/css/nsx-hero-effects.css" asp-append-version="true" /><link rel="stylesheet" href="/css/nsx-pro-v2.css" asp-append-version="true" />
    <style id="nsx-store-home-match-pro">

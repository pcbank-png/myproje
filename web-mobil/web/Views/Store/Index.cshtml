      .nsx-store-showcase-grid{grid-template-columns:1fr;}
      .nsx-store-hero-points{gap:7px;}
      .nsx-store-hero-points span{width:100%;justify-content:center;}
    }
    </style>
<link rel="stylesheet" href="/css/nsx-home-light.css" asp-append-version="true">
<link rel="stylesheet" href="/css/nsx-home-products-pro.css" asp-append-version="true">
<link rel="stylesheet" href="/css/nsx-global-type.css" asp-append-version="true">
</head><body class="home-light-theme public-light-theme">
<main class="software-list-page">
    <section class="store-hero-shell">
        @await Html.PartialAsync("_PublicHeader")
        <section class="software-list-hero">
            <div class="container">
                <div class="nsx-store-hero-copy">
                    <span class="nsx-store-kicker">NSX Yazılım Kütüphanesi</span>
                    <h1>İşinize uygun yazılımı <em>kolayca keşfedin.</em></h1>
                    <p>Cari hesaptan teknik servise, otomotivden klinik ve organizasyona kadar işletmeniz için geliştirilen NSX çözümlerini tek ekranda karşılaştırın.</p>
                    <div class="nsx-store-hero-points" aria-label="NSX yazılım avantajları">
                        <span><b>✓</b> Windows uyumlu</span>
                        <span><b>✓</b> Kolay kurulum</span>
                        <span><b>✓</b> Yerli destek</span>
                    </div>
                </div>
                <div class="nsx-store-showcase" aria-hidden="true">
                    <div class="nsx-store-showcase-head">
                        <div class="nsx-store-showcase-brand"><img src="/nsx-assets/logo-brand.webp" asp-append-version="true" alt="" width="1511" height="397" decoding="async" /><span>İşletme Yazılımları<small>Profesyonel NSX çözümleri</small></span></div>
                        <div class="nsx-store-live"><i></i> Kullanıma hazır</div>
                    </div>
                    <div class="nsx-store-showcase-grid">
                        <div class="nsx-store-showcase-card"><small>Yazılım Kütüphanesi</small><strong>@products.Count @localizedProductWord</strong><span>Tek noktadan keşfet</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="7" height="7" rx="1.5"/><rect x="14" y="4" width="7" height="7" rx="1.5"/><rect x="3" y="15" width="7" height="6" rx="1.5"/><rect x="14" y="15" width="7" height="6" rx="1.5"/></svg></div>
                        <div class="nsx-store-showcase-card"><small>Kurulum</small><strong>Hızlı</strong><span>Kolay başlangıç</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg></div>
                        <div class="nsx-store-showcase-card"><small>Destek</small><strong>Yerli</strong><span>NSX desteği</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 13a8 8 0 0 1 16 0"/><path d="M4 13v4a2 2 0 0 0 2 2h2v-6H4Zm16 0v4a2 2 0 0 1-2 2h-2v-6h4Z"/></svg></div>
                        <div class="nsx-store-showcase-card"><small>Lisans</small><strong>Güvenli</strong><span>Profesyonel kullanım</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m12 3 8 4v5c0 5-3.4 8-8 9-4.6-1-8-4-8-9V7z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg></div>
                    </div>
                </div>
            </div>
        </section>
    </section>

    <section class="solutions-section"><div class="container">
        <div class="nsx-store-section-head">
            <div><span>Tüm Yazılımlar</span><h2>İşletmeniz için doğru çözümü seçin.</h2></div>
            <p>Kategoriye göre filtreleyin, ürünleri karşılaştırın ve ihtiyacınıza en uygun NSX yazılımının detaylarını inceleyin.</p>
        </div>
        <div class="software-toolbar is-search-only">
            <form class="software-search" method="get" action="@($"{Context.Request.PathBase}/store")"><input type="hidden" name="category" value="@requestedCategory" /><input name="q" value="@q" placeholder="Yazılımlarda ara" aria-label="Yazılımlarda ara" /><select name="sort"><option value="recommended" selected="@(sort == "recommended")">Önerilen</option><option value="new" selected="@(sort == "new")">En yeni</option><option value="price_asc" selected="@(sort == "price_asc")">Fiyat: düşükten yükseğe</option><option value="price_desc" selected="@(sort == "price_desc")">Fiyat: yüksekten düşüğe</option></select><button type="submit">Ara</button></form>
        </div>
        @if (products.Any())
        {
            <div class="products-grid home-products-grid" id="softwareGrid">
            @for (var index = 0; index < products.Count; index++)
            {
                var product = products[index];
                var localizedProductName = localizedProductNames[product.Id];
                var localizedProductDescription = localizedProductDescriptions[product.Id];
                var detailsOpenLabel = await SiteLocalization.TranslateAsync("detay sayfasını aç", currentLanguage.Code, Context.RequestAborted);
                var productImageLabel = await SiteLocalization.TranslateAsync("ürün görseli", currentLanguage.Code, Context.RequestAborted);
                var productDetailsOpenAria = $"{localizedProductName} {detailsOpenLabel}";
                var localizedProductImageAlt = $"{localizedProductName} {productImageLabel}";
                var imageRecord = product.Images?.OrderByDescending(x => x.IsMain).ThenBy(x => x.SortOrder).FirstOrDefault();
                var originalImage = imageRecord?.ImagePath ?? "/nsx-assets/logo-brand.webp";
                var image = ProductThumb(originalImage, 960, imageRecord?.Id);
                var imageSrcSet = ProductThumbSrcSet(originalImage, imageRecord?.Id);
                var isFree = product.YearlyPrice <= 0 && product.LifetimePrice <= 0;
                var price = product.YearlyPrice > 0 ? product.YearlyPrice : product.LifetimePrice;
                var category = ProductCategoryHelper.GetKey(product);
                var cardAccent = string.Equals(product.Slug, "nsx-security-auditor-pro-2", StringComparison.OrdinalIgnoreCase)
                    ? "#2563eb"
                    : Accent(category);
                var features = ProductFeatures(product.Name);
                var localizedFeatures = new List<string>(features.Count);
                foreach (var feature in features)
                    localizedFeatures.Add(await SiteLocalization.TranslateAsync(feature, currentLanguage.Code, Context.RequestAborted));
                var avg = ratingAverage.TryGetValue(product.Id, out var rating) ? rating : 0;
                var count = ratingCount.TryGetValue(product.Id, out var votes) ? votes : 0;
                productCampaigns.TryGetValue(product.Id, out var campaign);
                var discountAmount = campaign == null ? 0 : CampaignDiscount(price, campaign);
                var campaignPrice = Math.Max(0, price - discountAmount);
                var localizedCategoryLabel = await SiteLocalization.TranslateAsync(ProductCategoryHelper.GetLabel(category), currentLanguage.Code, Context.RequestAborted);
                var localizedNewLabel = await SiteLocalization.TranslateAsync("Yeni", currentLanguage.Code, Context.RequestAborted);
                var localizedFreeLabel = await SiteLocalization.TranslateAsync("Ücretsiz", currentLanguage.Code, Context.RequestAborted);
                var localizedDigitalLicense = await SiteLocalization.TranslateAsync("Dijital lisans", currentLanguage.Code, Context.RequestAborted);
                var localizedOutOfStock = await SiteLocalization.TranslateAsync("Stokta yok", currentLanguage.Code, Context.RequestAborted);
                var localizedCampaignPrice = await SiteLocalization.TranslateAsync("Kampanyalı fiyat", currentLanguage.Code, Context.RequestAborted);
                var localizedStarting = await SiteLocalization.TranslateAsync("Başlangıç", currentLanguage.Code, Context.RequestAborted);
                var localizedViewProduct = await SiteLocalization.TranslateAsync("Ürünü İncele", currentLanguage.Code, Context.RequestAborted);
                <article class="product-card home-product-card" data-category="@category" style="--accent:@cardAccent">
                    <a class="product-visual" href="@ProductUrl(product)" aria-label="@productDetailsOpenAria"><img src="@image" srcset="@imageSrcSet" sizes="(max-width:680px) calc(100vw - 36px), (max-width:1180px) 46vw, 470px" alt="@localizedProductImageAlt" width="1581" height="995" loading="@(index == 0 ? "eager" : "lazy")" decoding="async" fetchpriority="@(index == 0 ? "high" : "low")" /><span class="product-tag">@(product.StockQuantity > 0 ? (isFree ? localizedFreeLabel : localizedDigitalLicense) : localizedOutOfStock)</span>@if(discountAmount > 0){<span class="product-campaign-badge home-product-campaign-badge">@CampaignLabel(campaign!, localizedDiscountWord)</span>}<span class="product-number">@((index + 1).ToString("00"))</span></a>
                    <div class="product-body"><div class="product-meta"><span>@localizedCategoryLabel</span><span class="rating">★★★★★ <b>@(count > 0 ? avg.ToString("0.0") : localizedNewLabel)</b></span></div><h3>@localizedProductName</h3><p>@localizedProductDescription</p><ul>@foreach (var feature in localizedFeatures.Take(3)) { <li><b class="nsx-public-check" aria-hidden="true">✓</b> @feature</li> }</ul><div class="product-footer"><div class="product-price @(discountAmount > 0 ? "has-campaign" : "")"><small>@(discountAmount > 0 ? localizedCampaignPrice : localizedStarting)</small><strong>@(isFree ? localizedFreeLabel : campaignPrice.ToString("C0", CultureInfo.GetCultureInfo("tr-TR")))</strong>@if(discountAmount > 0){<del>@price.ToString("C0", CultureInfo.GetCultureInfo("tr-TR"))</del>}</div><a class="product-cta" href="@ProductUrl(product)"><span>@localizedViewProduct</span><b class="nsx-dir-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5.5 6.5 6.5L9 18.5"></path></svg></b></a></div></div>
                </article>
            }
            </div>
        }
        else
        {
            <div class="software-empty"><h2>Ürün bulunamadı</h2><p>Arama kriterlerinizi değiştirerek tekrar deneyin.</p><a href="/store">Tüm yazılımları göster</a></div>
        }
    </div></section>
    @await Html.PartialAsync("_ModernDetailFooter")
</main>
<link rel="stylesheet" href="/css/nsx-public-light-parity.css" asp-append-version="true" />
<script src="/js/online-presence.js" asp-append-version="true" defer></script>
<script src="/js/nsx-pro-v2.js" asp-append-version="true" defer></script>
</body></html>
@functions {
    private static string ProductThumb(string imagePath, int width, int? version)
    {
        if (string.IsNullOrWhiteSpace(imagePath) || !imagePath.StartsWith("/uploads/products/images/", StringComparison.OrdinalIgnoreCase)) return imagePath;
        var fileName = System.IO.Path.GetFileName(imagePath);
        if (string.IsNullOrWhiteSpace(fileName)) return imagePath;
        return $"{NSYazilim.Web.Services.ProductThumbnailGenerator.GetRelativePath(fileName, width)}?v={version ?? 0}";
    }
    private static string? ProductThumbSrcSet(string imagePath, int? version)
    {
        if (string.IsNullOrWhiteSpace(imagePath) || !imagePath.StartsWith("/uploads/products/images/", StringComparison.OrdinalIgnoreCase)) return null;
        var fileName = System.IO.Path.GetFileName(imagePath);
        if (string.IsNullOrWhiteSpace(fileName)) return null;
        var v = version ?? 0;
        return $"{NSYazilim.Web.Services.ProductThumbnailGenerator.GetRelativePath(fileName, 480)}?v={v} 480w, {NSYazilim.Web.Services.ProductThumbnailGenerator.GetRelativePath(fileName, 720)}?v={v} 720w, {NSYazilim.Web.Services.ProductThumbnailGenerator.GetRelativePath(fileName, 960)}?v={v} 960w";
    }
    private static string Accent(string c) => c switch { "organizasyon"=>"#f97316", "klinik"=>"#059669", "otomotiv"=>"#dc2626", "servis"=>"#0891b2", "cari"=>"#7c3aed", "performans"=>"#ca8a04", "gelistirici-araclari"=>"#2563eb", _=>"#ff7417" };
    private static decimal CampaignDiscount(decimal amount, NSYazilim.Web.Models.Campaign campaign) { if(amount<=0||campaign.DiscountValue<=0||(campaign.MinimumCartTotal>0&&amount<campaign.MinimumCartTotal))return 0; var fixedDiscount=string.Equals(campaign.DiscountType,"Fixed",StringComparison.OrdinalIgnoreCase)||string.Equals(campaign.DiscountType,"FixedAmount",StringComparison.OrdinalIgnoreCase)||string.Equals(campaign.DiscountType,"Amount",StringComparison.OrdinalIgnoreCase); return Math.Round(Math.Clamp(fixedDiscount?campaign.DiscountValue:amount*campaign.DiscountValue/100m,0,amount),2,MidpointRounding.AwayFromZero); }
    private static string CampaignLabel(NSYazilim.Web.Models.Campaign campaign, string discountLabel) { var fixedDiscount=string.Equals(campaign.DiscountType,"Fixed",StringComparison.OrdinalIgnoreCase)||string.Equals(campaign.DiscountType,"FixedAmount",StringComparison.OrdinalIgnoreCase)||string.Equals(campaign.DiscountType,"Amount",StringComparison.OrdinalIgnoreCase); return fixedDiscount?$"{campaign.DiscountValue:N0} TL {discountLabel}":$"%{campaign.DiscountValue:N0} {discountLabel}"; }
    private static List<string> ProductFeatures(string name) { var n=(name??"").ToLowerInvariant(); if(n.Contains("düğün"))return new(){"Rezervasyon","Salon planlama","Cari takip"}; if(n.Contains("klinik"))return new(){"Hasta monitörü","Kapı üstü sıra","Randevu takibi"}; if(n.Contains("oto tamir"))return new(){"Servis kabul","Parça ve işçilik","Araç geçmişi"}; if(n.Contains("oto galeri"))return new(){"Araç stok","Kapora takibi","Kâr-zarar"}; if(n.Contains("servispro"))return new(){"QR canlı takip","SMS bildirim","Müşteri onayı"}; if(n.Contains("teknik servis"))return new(){"Servis fişi","Müşteri geçmişi","Teslim takibi"}; if(n.Contains("veresiye")||n.Contains("cari"))return new(){"Cari kartlar","Tahsilat takibi","Raporlar"}; return new(){"Hızlı kullanım","Güvenli işlem","Teknik destek"}; }
}

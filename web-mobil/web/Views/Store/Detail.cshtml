    body.detail-gallery-lock{overflow:hidden!important;}
    .detail-zoom-modal{z-index:1200!important;display:flex!important;align-items:center!important;justify-content:center!important;padding:24px!important;cursor:default!important;background:rgba(8,12,17,.88)!important;-webkit-backdrop-filter:blur(18px)!important;backdrop-filter:blur(18px)!important;opacity:0;transition:opacity .2s ease!important;}

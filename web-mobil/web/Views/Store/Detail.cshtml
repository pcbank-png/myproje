@model NSYazilim.Web.Models.Product
@using NSYazilim.Web.Services
@inject NSYazilim.Web.Services.SiteLocalizationService SiteLocalization
@inject NSYazilim.Web.Services.SeoLanguageUrlService SeoLanguageUrls
@using System.Globalization
@{
    Layout = null;
    var currentLanguage = await SiteLocalization.GetCurrentLanguageAsync();
    var images = Model.Images?.OrderByDescending(x => x.IsMain).ThenBy(x => x.SortOrder).ToList() ?? new List<NSYazilim.Web.Models.ProductImage>();
    var mainImage = images.FirstOrDefault()?.ImagePath ?? "/nsx-assets/logo-brand.webp";
    var comments = ViewBag.Comments as List<NSYazilim.Web.Models.ProductComment> ?? new();
    var averageRating = ViewBag.AverageRating is double rating ? rating : 0;
    var commentCount = ViewBag.CommentCount is int count ? count : comments.Count;
    var isFree = Model.YearlyPrice <= 0 && Model.LifetimePrice <= 0;
    var hasStock = Model.StockQuantity > 0;
    var category = ProductCategoryHelper.GetLabel(Model);
    var localizedCategory = await SiteLocalization.TranslateAsync(category, currentLanguage.Code, Context.RequestAborted);
    var seoProfile = ProductSeoCatalog.Find(Model);
    var isFreeVeresiye = isFree && seoProfile?.ProductCode == "NSXVERESIYETAKIPPROFREE";
    var sourceProductName = isFreeVeresiye
        ? seoProfile!.Name
        : Model.Name;
    var localizedProductName = await SiteLocalization.TranslateAsync(sourceProductName, currentLanguage.Code, Context.RequestAborted);
    // Özet yalnızca hero/SEO içindir. Ürün detay gövdesi aşağıda her dilde TAM
    // Model.Description ile render edilir; yabancı dilde kısa SEO metnine düşürülmez.
    var sourceSummary = string.IsNullOrWhiteSpace(Model.MetaDescription)
        ? (seoProfile?.MetaDescription ?? ProductContentSanitizer.ToPlainText(Model.Description, 700))
        : Model.MetaDescription;
    var localizedSummary = await SiteLocalization.TranslateAsync(sourceSummary, currentLanguage.Code, Context.RequestAborted);
    var canonicalSource = ViewData["Canonical"]?.ToString() ?? $"/urun/{Model.Slug}";
    var productSeoLinks = await SeoLanguageUrls.BuildAsync(canonicalSource, currentLanguage, Context.RequestAborted);
    var canonical = productSeoLinks.CurrentUrl;
    var title = currentLanguage.Code.StartsWith("tr", StringComparison.OrdinalIgnoreCase)
        ? SeoTextHelper.BuildTitle(ViewData["MetaTitle"]?.ToString() ?? Model.Name)
        : SeoTextHelper.BuildTitle(await SiteLocalization.TranslateAsync(
            ViewData["MetaTitle"]?.ToString() ?? sourceProductName,
            currentLanguage.Code,
            Context.RequestAborted));
    var description = currentLanguage.Code.StartsWith("tr", StringComparison.OrdinalIgnoreCase)
        ? SeoTextHelper.BuildDescription(ViewData["MetaDescription"]?.ToString() ?? sourceSummary)
        : SeoTextHelper.BuildDescription(localizedSummary);
    var ogImage = SeoTextHelper.AbsoluteUrl(ViewData["OgImage"]?.ToString() ?? mainImage);
    var metaKeywords = currentLanguage.Code.StartsWith("tr", StringComparison.OrdinalIgnoreCase)
        ? (ViewData["MetaKeywords"]?.ToString() ?? SeoTextHelper.ProductKeywords(Model.Name))
        : localizedProductName;
    var localizedBrandName = await SiteLocalization.TranslateAsync("NSX Yazılım", currentLanguage.Code, Context.RequestAborted);
    var productImageLabel = await SiteLocalization.TranslateAsync("ürün görseli", currentLanguage.Code, Context.RequestAborted);
    var imageZoomLabel = await SiteLocalization.TranslateAsync("görselini büyüt", currentLanguage.Code, Context.RequestAborted);
    var screenImageLabel = await SiteLocalization.TranslateAsync("program ekranı ve ürün görseli", currentLanguage.Code, Context.RequestAborted);
    var largeProductImageLabel = await SiteLocalization.TranslateAsync("büyük ürün görseli", currentLanguage.Code, Context.RequestAborted);
    var aboutInfoLabel = await SiteLocalization.TranslateAsync("hakkında bilgi almak istiyorum.", currentLanguage.Code, Context.RequestAborted);
    var accelerateLabel = await SiteLocalization.TranslateAsync("İşinizi hızlandırın.", currentLanguage.Code, Context.RequestAborted);
    var localizedProductImageAlt = $"{localizedProductName} {productImageLabel}";
    var localizedZoomAria = $"{localizedProductName} {imageZoomLabel}";
    var localizedScreenImageAlt = $"{localizedProductName} {screenImageLabel}";
    var localizedLargeImageAlt = $"{localizedProductName} {largeProductImageLabel}";
    var bankName = ViewBag.BankTransferBankName?.ToString() ?? "";
    var accountHolder = ViewBag.BankTransferAccountHolder?.ToString() ?? "";
    var iban = ViewBag.BankTransferIban?.ToString() ?? "";
    var bankBranch = ViewBag.BankTransferBranch?.ToString() ?? "";
    var whatsappText = Uri.EscapeDataString($"{localizedProductName} {aboutInfoLabel}");
    var productFeatures = ProductFeatures(Model.Name);
    var isSignedIn = User.Identity?.IsAuthenticated == true && User.IsInRole("User");
    var commentReturnUrl = $"{Context.Request.PathBase}{Context.Request.Path}#yorumlar";
    var commentLoginUrl = Url.Action("Login", "Account", new { returnUrl = commentReturnUrl, uiLang = currentLanguage.Code }) ?? "/Account/Login";
    var activeCampaign = ViewBag.ActiveCampaign as NSYazilim.Web.Models.Campaign;
    var localizedCustomerRatingLabel = await SiteLocalization.TranslateAsync("müşteri puanı", currentLanguage.Code, Context.RequestAborted);
    var localizedDiscountWord = await SiteLocalization.TranslateAsync("İNDİRİM", currentLanguage.Code, Context.RequestAborted);
    var localizedCampaignName = activeCampaign == null ? string.Empty : await SiteLocalization.TranslateAsync(activeCampaign.Name, currentLanguage.Code, Context.RequestAborted);
    if (activeCampaign != null
        && !currentLanguage.Code.StartsWith("tr", StringComparison.OrdinalIgnoreCase)
        && string.Equals(localizedCampaignName, activeCampaign.Name, StringComparison.Ordinal))
    {
        localizedCampaignName = await SiteLocalization.TranslateAsync("Kampanya", currentLanguage.Code, Context.RequestAborted);
    }
    var yearlyDiscount = activeCampaign == null ? 0 : CampaignDiscount(Model.YearlyPrice, activeCampaign);
    var lifetimeDiscount = activeCampaign == null ? 0 : CampaignDiscount(Model.LifetimePrice, activeCampaign);
    var yearlyPayable = Math.Max(0, Model.YearlyPrice - yearlyDiscount);
    var lifetimePayable = Math.Max(0, Model.LifetimePrice - lifetimeDiscount);
}

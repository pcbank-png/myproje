    .detail-zoom-stage>img{position:relative;z-index:1;display:block;width:auto!important;height:auto!important;max-width:100%!important;max-height:min(calc(72vh - 60px),760px)!important;object-fit:contain!important;object-position:center!important;border-radius:16px!important;background:transparent!important;box-shadow:0 26px 70px rgba(18,27,38,.18)!important;transition:opacity .14s ease,transform .2s ease!important;}
    .detail-zoom-stage>img.is-switching{opacity:.28;transform:scale(.985);}
    .detail-zoom-close,.detail-zoom-nav{z-index:5;display:grid;place-items:center;border:1px solid rgba(18,27,38,.13);color:#26313d;background:rgba(255,255,255,.92);box-shadow:0 12px 28px rgba(18,27,38,.14);cursor:pointer;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);transition:color .18s ease,background .18s ease,border-color .18s ease,transform .18s ease,box-shadow .18s ease;}
    .detail-zoom-close{position:absolute;top:20px;right:20px;width:46px;height:46px;border-radius:14px;}
    .detail-zoom-nav{position:absolute;top:50%;width:54px;height:54px;border-radius:17px;transform:translateY(-50%);}
    .detail-zoom-prev{left:22px;}.detail-zoom-next{right:22px;}
    .detail-zoom-close svg{width:19px;height:19px}.detail-zoom-nav svg{width:22px;height:22px}
    .detail-zoom-close:hover,.detail-zoom-nav:hover{color:#fff;border-color:#ff6e04;background:linear-gradient(145deg,#ff8121,#ed5900);box-shadow:0 16px 32px rgba(222,89,0,.24);}
    .detail-zoom-nav:hover{transform:translateY(-50%) scale(1.05);}
    .detail-zoom-close:hover{transform:rotate(4deg) scale(1.05);}
    .detail-zoom-close:focus-visible,.detail-zoom-nav:focus-visible,.detail-zoom-thumbs button:focus-visible{outline:3px solid rgba(255,110,4,.28);outline-offset:3px;}
    .detail-zoom-counter{position:absolute;z-index:4;top:20px;left:20px;display:inline-flex;align-items:center;min-height:38px;padding:0 13px;border:1px solid rgba(18,27,38,.10);border-radius:12px;color:#384553;background:rgba(255,255,255,.90);box-shadow:0 9px 22px rgba(18,27,38,.08);font-size:11px;font-weight:850;letter-spacing:.04em;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);}
    .detail-zoom-footer{display:grid;grid-template-columns:minmax(190px,.55fr) minmax(260px,1.45fr) auto;align-items:center;gap:22px;min-height:102px;padding:14px 20px;border-top:1px solid #dfe4e9;background:#fff;}
    .detail-zoom-title{display:flex;min-width:0;flex-direction:column;gap:4px;}
    .detail-zoom-title small{color:#df5900;font-size:8px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;}
    .detail-zoom-title strong{overflow:hidden;color:#17212c;font-size:13px;font-weight:850;text-overflow:ellipsis;white-space:nowrap;}
    .detail-zoom-thumbs{display:flex;align-items:center;justify-content:center;gap:8px;min-width:0;padding:4px;overflow-x:auto;scrollbar-width:thin;scrollbar-color:#ff9b56 #eef1f4;}
    .detail-zoom-thumbs button{display:grid;place-items:center;flex:0 0 72px;width:72px;height:54px;padding:4px;overflow:hidden;border:1px solid #dfe4e9;border-radius:11px;background:#f8fafb;cursor:pointer;transition:border-color .18s ease,box-shadow .18s ease,transform .18s ease;}
    .detail-zoom-thumbs button:hover,.detail-zoom-thumbs button.active{border-color:#ff6e04;box-shadow:0 0 0 2px rgba(255,110,4,.12),0 7px 16px rgba(18,27,38,.09);transform:translateY(-1px);}
    .detail-zoom-thumbs img{display:block;width:100%;height:100%;object-fit:contain;border-radius:7px;background:transparent;}
    .detail-zoom-keyboard{display:flex;align-items:center;gap:7px;color:#7a8693;font-size:9px;font-weight:750;white-space:nowrap;}
    .detail-zoom-keyboard kbd{display:grid;place-items:center;width:27px;height:27px;border:1px solid #dce2e7;border-bottom-width:2px;border-radius:8px;color:#df5900;background:#f8fafb;font-family:inherit;font-size:13px;font-weight:850;line-height:1;}

    @@media (max-width:1180px){
        .detail-page .public-site-header .service-ribbon > .container,.detail-page .public-site-header .detail-nav.container,.detail-page .nsx-product-short-hero > .container,.detail-page .detail-product-stage.container,.detail-page .detail-content.container{width:calc(100% - 32px)!important;}
        .nsx-product-short-hero h1{font-size:38px!important;}
        .detail-page .detail-layout{grid-template-columns:minmax(0,1fr) minmax(370px,.88fr)!important;}
    }
    @@media (max-width:980px){
        .detail-page .public-site-header .service-ribbon > .container,.detail-page .public-site-header .detail-nav.container{width:calc(100% - 24px)!important;}
        .detail-page .detail-layout{grid-template-columns:1fr!important;}
        .detail-page .detail-main-image{height:400px!important;min-height:400px!important;}
        .detail-page .detail-main-image img{max-height:400px!important;transform:translateY(-6px) scale(1.035)!important;}
        .detail-page .detail-main-image:hover img{transform:translateY(-6px) scale(1.06)!important;}
    }
    @@media (max-width:680px){
        .detail-page .nsx-product-short-hero > .container,.detail-page .detail-product-stage.container,.detail-page .detail-content.container{width:calc(100% - 18px)!important;}
        .nsx-product-short-hero > .container{padding-top:20px!important;padding-bottom:20px!important;}
        .nsx-product-short-hero h1{font-size:30px!important;}
        .nsx-product-short-hero p{font-size:13px!important;}
        .nsx-product-short-points{gap:7px!important;}
        .nsx-product-short-points span{min-height:31px!important;padding:0 9px!important;font-size:9px!important;}
        .detail-page .detail-product-stage{padding:24px 0 28px!important;}
        .detail-page .detail-main-image{height:300px!important;min-height:300px!important;padding:12px!important;}
        .detail-page .detail-main-image img{max-height:300px!important;transform:translateY(-3px) scale(1.02)!important;}
        .detail-page .detail-main-image:hover img{transform:translateY(-3px) scale(1.04)!important;}
        .detail-page .detail-purchase{padding:20px!important;}
        .detail-page .detail-primary-actions{grid-template-columns:1fr!important;}
        .detail-page .detail-product-name{font-size:23px!important;}
        .detail-page .detail-tabs{padding:6px!important;}
        .detail-zoom-modal{padding:8px!important;}
        .detail-zoom-shell{width:calc(100vw - 16px);max-height:calc(100vh - 16px);border-radius:19px;}
        .detail-zoom-stage{height:68vh;min-height:300px;padding:66px 14px 20px;}
        .detail-zoom-stage>img{max-height:calc(68vh - 86px)!important;}
        .detail-zoom-nav{top:50%;width:44px;height:44px;border-radius:14px;}
        .detail-zoom-prev{left:9px}.detail-zoom-next{right:9px}
        .detail-zoom-close{top:12px;right:12px;width:42px;height:42px;border-radius:13px;}
        .detail-zoom-counter{top:14px;left:14px;min-height:34px;}
        .detail-zoom-footer{grid-template-columns:1fr;gap:9px;min-height:0;padding:11px 12px 13px;}
        .detail-zoom-title{display:none;}
        .detail-zoom-thumbs{justify-content:flex-start;width:100%;}
        .detail-zoom-thumbs button{flex-basis:62px;width:62px;height:47px;}
        .detail-zoom-keyboard{display:none;}
    }
    </style>
    @Html.Raw(ViewData["JsonLd"])
<link rel="stylesheet" href="/css/nsx-home-light.css" asp-append-version="true">
<link rel="stylesheet" href="/css/nsx-global-type.css" asp-append-version="true">
</head>
<body class="home-light-theme public-light-theme">
<main class="detail-page @(isFree ? "free-product-detail" : "")">
    @await Html.PartialAsync("_PublicHeader")

    <section class="nsx-product-short-hero">
        <div class="container">
            <div class="nsx-product-short-copy">
                <span class="nsx-product-short-kicker">@localizedBrandName · @localizedCategory</span>
                <h1>@localizedProductName <em>NSX güvencesiyle.</em></h1>
                <p>@localizedSummary</p>
                <div class="nsx-product-short-points" aria-label="Ürün avantajları">
                    @if (isFree)
                    {
                        <span><b>✓</b> Ömür boyu ücretsiz</span>
                        <span><b>✓</b> Bulut + Mobil erişim</span>
                        <span><b>✓</b> Windows cari / veresiye takibi</span>
                    }
                    else
                    {
                        <span><b>✓</b> Windows uyumlu</span>
                        <span><b>✓</b> Dijital teslimat</span>
                        <span><b>✓</b> NSX teknik destek</span>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="detail-hero detail-product-stage container">
        <div class="detail-layout">
            <div class="detail-media">
                <div class="detail-status"><span>NSX ORİJİNAL YAZILIM</span><b>@(hasStock ? (isFree ? "Ücretsiz · Dijital indirme" : "Stokta · Dijital teslimat") : "Şu anda stokta yok")</b></div>
                <button class="detail-main-image" id="zoomOpen" type="button" aria-label="@localizedZoomAria">
                    <img id="mainProductImage" src="@mainImage" alt="@localizedScreenImageAlt" width="1581" height="995" fetchpriority="high" decoding="async" />
                    <span class="detail-zoom-hint">⌕ Büyüt</span>
                </button>
                @if (images.Count > 1)
                {
                    <div class="detail-thumbs" aria-label="Ürün görselleri">
                        @foreach (var image in images)
                        {
                            <button type="button" class="detail-thumb" data-image="@image.ImagePath"><img src="@ProductThumb(image.ImagePath, 360, image.Id)" alt="@localizedProductImageAlt" width="1581" height="995" loading="lazy" decoding="async" fetchpriority="low" /></button>
                        }
                    </div>
                }
                <div class="detail-media-note"><span>Görsele tıklayarak tam boy inceleyin</span><span>Windows masaüstü yazılımı</span></div>
            </div>

            <div class="detail-purchase">
                <div class="detail-category">@localizedCategory <span>★★★★★ <b>@(commentCount > 0 ? averageRating.ToString("0.0") : "Yeni")</b></span></div>
                <h2 class="detail-product-name">@localizedProductName</h2>
                <p class="detail-summary">@localizedSummary</p>
                <div class="detail-trust">
                    @if (isFree)
                    {
                        <span><b class="nsx-public-check" aria-hidden="true">✓</b> Ömür boyu ücretsiz</span><span><b class="nsx-public-check" aria-hidden="true">✓</b> Bulut + Mobil erişim</span><span><b class="nsx-public-check" aria-hidden="true">✓</b> NSX teknik destek</span>
                    }
                    else
                    {
                        <span><b class="nsx-public-check" aria-hidden="true">✓</b> Hızlı kurulum</span><span><b class="nsx-public-check" aria-hidden="true">✓</b> Teknik destek</span><span><b class="nsx-public-check" aria-hidden="true">✓</b> Güvenli lisans</span>
                    }
                </div>

                @if (isFree)
                {
                    <div class="free-license-panel"><div><small>Kullanım lisansı</small><strong>Ücretsiz</strong><span>Üye girişiyle doğrudan indirme</span></div><div><b>✓</b><span><strong>Ödeme adımı yok</strong><small>Hemen kullanmaya başlayın</small></span></div></div>
                }
                else
                {
                    @if (yearlyDiscount > 0 || lifetimeDiscount > 0)
                    {
                        <div class="detail-campaign-note"><b>@CampaignLabel(activeCampaign!, localizedDiscountWord)</b><span>@localizedCampaignName · <span>İndirim havale bildiriminde otomatik uygulanır.</span></span></div>
                    }
                    <div class="license-options" role="radiogroup" aria-label="Lisans türü">
                        <button class="license-card selected" type="button" data-license="Yearly" data-price="@yearlyPayable.ToString("0.##", CultureInfo.InvariantCulture)"><small>Yıllık lisans</small><strong>@yearlyPayable.ToString("C0", CultureInfo.GetCultureInfo("tr-TR"))</strong>@if(yearlyDiscount > 0){<del>@Model.YearlyPrice.ToString("C0", CultureInfo.GetCultureInfo("tr-TR"))</del>}<span>365 gün kullanım</span></button>
                        <button class="license-card" type="button" data-license="Lifetime" data-price="@lifetimePayable.ToString("0.##", CultureInfo.InvariantCulture)"><small>Sınırsız lisans</small><strong>@lifetimePayable.ToString("C0", CultureInfo.GetCultureInfo("tr-TR"))</strong>@if(lifetimeDiscount > 0){<del>@Model.LifetimePrice.ToString("C0", CultureInfo.GetCultureInfo("tr-TR"))</del>}<span>Ömür boyu kullanım</span></button>
                    </div>
                }

                <div class="detail-primary-actions">
                    @if (hasStock)
                    {
                        <a class="detail-buy" id="buyLink" href="@(isFree ? $"/store/free-download-start?productId={Model.Id}" : $"/Odeme?productId={Model.Id}&licenseType=Yearly")" data-free-download="@(isFree ? "true" : null)">@(isFree ? "Ücretsiz İndir" : "Satın Al")<span>→</span></a>
                        @if (isFree)
                        {
                            <a class="detail-demo" href="#features"><strong>Özellikleri İncele</strong><small>Programın tüm özelliklerini görün</small></a>
                        }
                        else
                        {
                            <a class="detail-demo" href="/store/downloaddemo?productId=@Model.Id"><strong>Demo / İndirme</strong><small>Kurulum dosyasını alın</small></a>
                        }
                    }
                    else
                    {
                        <span class="detail-buy is-disabled">Stokta Yok</span><a class="detail-demo" href="/iletisim">Bilgi Al</a>
                    }
                </div>
                <button class="nsx-install-guide-spotlight" type="button" data-guide-open aria-haspopup="dialog">
                    <span class="nsx-install-guide-spotlight__shield" aria-hidden="true">✓</span>
                    <span class="nsx-install-guide-spotlight__copy"><small>Dosya açılmıyor mu?</small><strong>Güvenli Kurulum Rehberini İnceleyin</strong><em>Sağ tık → Engellemeyi kaldır</em></span>
                    <span class="nsx-install-guide-spotlight__action">Rehberi Aç <b aria-hidden="true">→</b></span>
                </button>
                <a class="detail-whatsapp" href="https://wa.me/905434624226?text=@whatsappText" target="_blank" rel="noreferrer"><span>WA</span><div><small>Ürün uzmanına sorun</small><strong>WhatsApp ile bilgi alın</strong></div><b>↗</b></a>
                <div class="detail-delivery"><div><b>01</b><span><strong>@(isFree ? "Ücretsiz indirme" : "Dijital teslimat")</strong><small>@(isFree ? "Üye girişi sonrası anında erişim" : "Onay sonrası hızlı erişim")</small></span></div><div><b>02</b><span><strong>Uzaktan kurulum</strong><small>NSX destek ekibi yanınızda</small></span></div></div>
            </div>
        </div>
    </section>

    <section class="detail-content container">
        <div class="detail-tabs" role="tablist">
            <button class="active" type="button" data-tab="features">Ürün Özellikleri</button>
            <button type="button" data-tab="technical">Teknik Bilgiler</button>
            <button type="button" data-tab="support">Kurulum &amp; Destek</button>
            <button type="button" data-tab="reviews"><span>Yorumlar</span> (@commentCount)</button>
            <button type="button" data-tab="questions">Soru &amp; Cevap</button>
            <button type="button" data-tab="bank">@(isFree ? "İndirme Bilgileri" : "Havale Bilgileri")</button>
        </div>
        <div class="detail-tab-panel" id="features" data-panel="features">
            <div>
                <span class="detail-eyebrow">ÜRÜNÜ TANIYIN</span>
                <h2>@localizedProductName · @accelerateLabel</h2>
                <div class="detail-rich-copy">
                    @* Tam ürün içeriği hiçbir dilde kısaltılmaz. HTML dil middleware'i,
                       DB'den gelen paragraf/metin düğümlerini hedef dile çevirir. *@
                    @Html.Raw(ProductContentSanitizer.NormalizeForEditor(Model.Description))
                </div>
            </div>
            <div class="detail-feature-grid">
                @for (var i = 0; i < productFeatures.Count; i++)
                {
                    <span><b>@((i + 1).ToString("00"))</b>@productFeatures[i]</span>
                }
            </div>
            @if (isFreeVeresiye)
            {
                <div class="detail-free-video">
                    <div class="detail-free-video__copy">
                        <span class="detail-eyebrow">KURULUM VE KULLANIM</span>
                        <h3>NSX Veresiye Takip Pro Free'yi yakından görün.</h3>
                        <p>Kurulum ve temel kullanım videosunu izleyin; ardından ücretsiz lisansınızla güvenli indirmeyi başlatın.</p>
                    </div>
                    <div class="detail-free-video__frame">
                        <iframe src="https://www.youtube-nocookie.com/embed/ypsXQY6iOl4?rel=0" title="NSX Veresiye Takip Pro Free kurulum ve kullanım videosu" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                    </div>
                </div>
            }
        </div>
        <div class="detail-tab-panel" data-panel="technical" hidden><div><span class="detail-eyebrow">TEKNİK BİLGİLER</span><h2>Kuruluma hazır, anlaşılır yapı.</h2><p>@(isFree ? "İndirmeden önce temel kullanım, lisans ve kurulum bilgilerini tek bakışta inceleyin." : "Satın almadan önce temel kullanım ve teslimat bilgilerini tek bakışta inceleyin.")</p></div><dl class="detail-specs"><div><dt>Platform</dt><dd>Windows masaüstü</dd></div><div><dt>Teslimat</dt><dd>@(isFree ? "Dijital indirme" : "Dijital lisans / indirme")</dd></div><div><dt>Lisans</dt><dd>@(isFree ? "Ücretsiz" : "Yıllık veya sınırsız")</dd></div><div><dt>Ürün kodu</dt><dd>@(Model.ProductCode ?? $"NSX-{Model.Id}")</dd></div></dl></div>
        <div class="detail-tab-panel" data-panel="support" hidden><div><span class="detail-eyebrow">NSX DESTEK</span><h2>Kurulumda yalnız değilsiniz.</h2><p>@(isFree ? "Ücretsiz indirme sonrasında ihtiyaç halinde uzaktan bağlantıyla kurulum ve başlangıç desteği alabilirsiniz." : "Lisans ve indirme sonrasında ihtiyaç halinde uzaktan bağlantıyla kurulum ve başlangıç desteği alabilirsiniz.")</p></div><div class="detail-support-steps"><span><b>1</b>@(isFree ? "Hesabınıza giriş yapın" : "Ürünü ve lisansı seçin")</span><span><b>2</b>@(isFree ? "Ücretsiz indirin" : "İşlemi tamamlayın")</span><span><b>3</b>Kurulum desteği alın</span></div></div>
        <div class="detail-tab-panel" id="yorumlar" data-panel="reviews" hidden>
            <div class="detail-review-intro">
                <span class="detail-eyebrow">MÜŞTERİ YORUMLARI</span>
                <h2>
                    @if (commentCount > 0)
                    {
                        <span>@averageRating.ToString("0.0") / 5 @localizedCustomerRatingLabel</span>
                    }
                    else
                    {
                        <span>İlk yorumu siz yapın</span>
                    }
                </h2>
                <p>Yorumlar gerçek kullanıcı deneyimlerini yansıtır ve yayın öncesi kontrol edilir.</p>
                @if (isSignedIn)
                {
                    @await Html.PartialAsync("_CommentForm", Model)
                }
                else
                {
                    <a class="detail-review-action" href="@commentLoginUrl">Yorum yapmak için giriş yap</a>
                }
            </div>
            <div class="detail-review-list">
                @if (comments.Any())
                {
                    foreach (var review in comments.Take(3))
                    {
                        <article class="detail-review-card"><div><strong>@review.FullName</strong><span>@(new string('★', Math.Clamp(review.Rating, 1, 5)))</span></div><p>@review.Comment</p><small>@review.CreatedAt.ToString("dd.MM.yyyy")</small></article>
                    }
                }
                else
                {
                    <article class="detail-review-card"><strong>Henüz yorum yok</strong><p>Bu ürün hakkındaki deneyiminizi paylaşan ilk kişi olabilirsiniz.</p></article>
                }
            </div>
        </div>
        <div class="detail-tab-panel" data-panel="questions" hidden>
            <div><span class="detail-eyebrow">SIK SORULAN SORULAR</span><h2>@(isFree ? "İndirmeden önce bilmeniz gerekenler." : "Satın almadan önce bilmeniz gerekenler.")</h2><p>Ürün, lisans veya kurulum hakkında farklı bir sorunuz varsa destek ekibimize ulaşabilirsiniz.</p></div>
            <div class="detail-faq-list">
                <details open><summary>Program hangi işletim sisteminde çalışır?</summary><p>NSX masaüstü yazılımları Windows ortamında çalışır. Ürün özel gereksinimleri destek ekibinden doğrulanabilir.</p></details>
                <details><summary>Kurulum desteği veriliyor mu?</summary><p>Evet. İhtiyaç halinde uzaktan bağlantı ile kurulum ve ilk kullanım desteği sağlanır.</p></details>
                @if (isFree)
                {
                    <details><summary>Ücretsiz lisansımı nasıl alırım?</summary><p>Hesabınıza giriş yaptıktan sonra Ücretsiz İndir düğmesine basmanız yeterlidir. Ücretsiz kullanım lisansı hesabınıza otomatik tanımlanır; ödeme veya havale gerekmez.</p></details>
                }
                else
                {
                    <details><summary>Lisansı nasıl teslim alırım?</summary><p>Ödeme onayından sonra lisans kullanıcı hesabına tanımlanır ve indirme erişimi açılır.</p></details>
                }
                <a href="/iletisim">Başka bir soru sorun →</a>
            </div>
        </div>
        <div class="detail-tab-panel" data-panel="bank" hidden>
            <div><span class="detail-eyebrow">@(isFree ? "GÜVENLİ İNDİRME" : "GÜVENLİ ÖDEME")</span><h2>@(isFree ? "Üye girişiyle hemen indirin." : "Havale / EFT bilgileri.")</h2><p>@(isFree ? "Bu ürün için ödeme veya havale bildirimi gerekmez." : "Satın alma bildirimini gönderdikten sonra ödeme kontrol edilir; lisans ve indirme erişimi hesabınıza tanımlanır.")</p></div>
            @if (!isFree && !string.IsNullOrWhiteSpace(iban))
            {
                <dl class="detail-specs detail-bank-specs"><div><dt>Banka</dt><dd>@bankName</dd></div><div><dt>Alıcı</dt><dd>@accountHolder</dd></div><div><dt>IBAN</dt><dd>@iban</dd></div><div><dt>Açıklama</dt><dd>Lütfen boş bırakınız</dd></div><div><dt>Tutar</dt><dd id="bankAmount">@Model.YearlyPrice.ToString("C0", CultureInfo.GetCultureInfo("tr-TR"))</dd></div></dl>
            }
            else
            {
                <div class="detail-support-steps"><span><b>1</b>Hesabınıza giriş yapın</span><span><b>2</b>@(isFree ? "Ücretsiz İndir düğmesine basın" : "Demo / İndirme düğmesine basın")</span><span><b>3</b>Dosyanıza güvenli şekilde erişin</span></div>
            }
        </div>
    </section>

    @await Html.PartialAsync("_ModernDetailFooter")
</main>

@if (isFreeVeresiye)
{
    <style>
    .detail-free-video{grid-column:1/-1;display:grid;grid-template-columns:minmax(260px,.75fr) minmax(420px,1.25fr);gap:24px;align-items:center;margin-top:14px;padding:24px;border:1px solid #e2e7eb;border-radius:18px;background:linear-gradient(135deg,#fff 0%,#fafbfc 100%)}
    .detail-free-video__copy h3{margin:7px 0 9px;color:#171c22;font-size:24px;line-height:1.15;font-weight:900;letter-spacing:-.03em}.detail-free-video__copy p{margin:0;color:#6f7a85;font-size:12px;line-height:1.7}
    .detail-free-video__frame{position:relative;overflow:hidden;aspect-ratio:16/9;border-radius:14px;background:#0d1117;box-shadow:0 14px 34px rgba(15,23,42,.12)}.detail-free-video__frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
    @@media(max-width:850px){.detail-free-video{grid-template-columns:1fr;padding:17px}.detail-free-video__copy h3{font-size:21px}}
    </style>
}

@if (isFree)
{
    <script>
    document.addEventListener('click', function (event) {
        var link = event.target.closest('a[data-free-download="true"]');
        if (!link || typeof window.gtag !== 'function') return;
        window.gtag('event', 'free_download_intent', {
            product_id: '@Model.Id',
            product_name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sourceProductName)),
            signed_in: @(isSignedIn ? "true" : "false")
        });
    });
    </script>
}

<link rel="stylesheet" href="/css/nsx-public-light-parity.css" asp-append-version="true" />
<div class="detail-zoom-modal" id="zoomModal" role="dialog" aria-modal="true" aria-labelledby="zoomModalTitle" aria-hidden="true" hidden>
    <div class="detail-zoom-shell">
        <div class="detail-zoom-stage" id="zoomStage">
            <span class="detail-zoom-counter" id="zoomCounter">1 / @Math.Max(images.Count, 1)</span>
            <button class="detail-zoom-close" id="zoomClose" type="button" aria-label="Galeriyi kapat">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg>
            </button>
            <button class="detail-zoom-nav detail-zoom-prev" id="zoomPrev" type="button" aria-label="Önceki görsel">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5-7 7 7 7" /></svg>
            </button>
            <img id="zoomImage" src="@mainImage" alt="@localizedLargeImageAlt" width="1581" height="995" loading="lazy" decoding="async" fetchpriority="low" />
            <button class="detail-zoom-nav detail-zoom-next" id="zoomNext" type="button" aria-label="Sonraki görsel">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7" /></svg>
            </button>
        </div>
        <div class="detail-zoom-footer">
            <span class="detail-zoom-title"><small>NSX ürün galerisi</small><strong id="zoomModalTitle">@localizedProductName</strong></span>
            <div class="detail-zoom-thumbs" id="zoomThumbs" aria-label="Galeri küçük görselleri">
                @if (images.Count > 0)
                {
                    @for (var imageIndex = 0; imageIndex < images.Count; imageIndex++)
                    {
                        var galleryImage = images[imageIndex];
                        <button type="button" data-zoom-index="@imageIndex" aria-label="@(imageIndex + 1). görseli göster"><img src="@ProductThumb(galleryImage.ImagePath, 360, galleryImage.Id)" alt="" width="1581" height="995" loading="lazy" decoding="async" /></button>
                    }
                }
            </div>
            <span class="detail-zoom-keyboard" aria-hidden="true"><kbd>←</kbd><kbd>→</kbd> ile gezinin</span>
        </div>
    </div>
</div>
@await Html.PartialAsync("_InstallGuide", false)
<script>
(() => {
  const productId = @Model.Id;
  const buy = document.getElementById('buyLink');
  document.querySelectorAll('.license-card').forEach(card => card.addEventListener('click', () => {
    document.querySelectorAll('.license-card').forEach(x => x.classList.remove('selected'));
    card.classList.add('selected');
    if (buy) buy.href = `/Odeme?productId=${productId}&licenseType=${card.dataset.license}`;
    const bankAmount = document.getElementById('bankAmount');
    if (bankAmount) bankAmount.textContent = new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY', maximumFractionDigits: 0 }).format(Number(card.dataset.price));
  }));
  document.querySelectorAll('.detail-tabs [data-tab]').forEach(button => button.addEventListener('click', () => {
    document.querySelectorAll('.detail-tabs [data-tab]').forEach(x => x.classList.toggle('active', x === button));
    document.querySelectorAll('[data-panel]').forEach(panel => panel.hidden = panel.dataset.panel !== button.dataset.tab);
  }));
  const openHashTab = () => {
    if (window.location.hash === '#yorumlar') document.querySelector('.detail-tabs [data-tab="reviews"]')?.click();
  };
  openHashTab();
  window.addEventListener('hashchange', openHashTab);
  const ratingInput = document.getElementById('ratingInput');
  const ratingButtons = [...document.querySelectorAll('#ratingPicker [data-rating]')];
  ratingButtons.forEach(button => button.addEventListener('click', () => {
    const rating = Number(button.dataset.rating || 5);
    if (ratingInput) ratingInput.value = String(rating);
    ratingButtons.forEach(star => {
      const selected = Number(star.dataset.rating) <= rating;
      star.classList.toggle('selected', selected);
      star.setAttribute('aria-pressed', String(star === button));
    });
  }));
  const mainImage = document.getElementById('mainProductImage');
  const pageThumbs = [...document.querySelectorAll('.detail-thumb')];
  const modal = document.getElementById('zoomModal');
  const modalImage = document.getElementById('zoomImage');
  const modalCounter = document.getElementById('zoomCounter');
  const modalThumbs = [...document.querySelectorAll('[data-zoom-index]')];
  const modalStage = document.getElementById('zoomStage');
  const imageSources = pageThumbs.length
    ? pageThumbs.map(thumb => thumb.dataset.image).filter(Boolean)
    : (mainImage?.src ? [mainImage.src] : []);
  let currentImageIndex = Math.max(0, imageSources.findIndex(src => mainImage && (mainImage.getAttribute('src') === src || mainImage.src === src)));
  let galleryReturnFocus = null;
  let touchStartX = 0;

  const renderGalleryImage = index => {
    if (!imageSources.length || !mainImage || !modalImage) return;
    currentImageIndex = (index + imageSources.length) % imageSources.length;
    const nextSource = imageSources[currentImageIndex];
    modalImage.classList.add('is-switching');
    modalImage.src = nextSource;
    mainImage.src = nextSource;
    if (modalCounter) modalCounter.textContent = `${currentImageIndex + 1} / ${imageSources.length}`;
    pageThumbs.forEach((thumb, thumbIndex) => thumb.classList.toggle('active', thumbIndex === currentImageIndex));
    modalThumbs.forEach((thumb, thumbIndex) => {
      thumb.classList.toggle('active', thumbIndex === currentImageIndex);
      thumb.setAttribute('aria-current', thumbIndex === currentImageIndex ? 'true' : 'false');
    });
    modalThumbs[currentImageIndex]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    const reveal = () => modalImage.classList.remove('is-switching');
    if (modalImage.complete) requestAnimationFrame(reveal);
    else modalImage.addEventListener('load', reveal, { once: true });
  };

  pageThumbs.forEach((thumb, index) => {
    thumb.addEventListener('click', () => renderGalleryImage(index));
    thumb.addEventListener('mouseenter', () => {
      if (currentImageIndex !== index) renderGalleryImage(index);
    });
  });
  modalThumbs.forEach((thumb, index) => {
    thumb.addEventListener('click', () => renderGalleryImage(index));
    thumb.addEventListener('mouseenter', () => {
      if (modal && !modal.hidden && currentImageIndex !== index) renderGalleryImage(index);
    });
  });

  const openModal = () => {
    if (!modal || !imageSources.length) return;
    galleryReturnFocus = document.activeElement;
    modal.hidden = false;
    modal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('detail-gallery-lock');
    renderGalleryImage(currentImageIndex);
    requestAnimationFrame(() => {
      modal.classList.add('is-open');
      document.getElementById('zoomClose')?.focus({ preventScroll: true });
    });
  };
  const closeModal = () => {
    if (!modal || modal.hidden) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('detail-gallery-lock');
    window.setTimeout(() => { modal.hidden = true; }, 200);
    if (galleryReturnFocus instanceof HTMLElement) galleryReturnFocus.focus({ preventScroll: true });
  };

  document.getElementById('zoomOpen')?.addEventListener('click', openModal);
  document.getElementById('zoomClose')?.addEventListener('click', closeModal);
  document.getElementById('zoomPrev')?.addEventListener('click', () => renderGalleryImage(currentImageIndex - 1));
  document.getElementById('zoomNext')?.addEventListener('click', () => renderGalleryImage(currentImageIndex + 1));
  modal?.addEventListener('click', event => { if (event.target === modal) closeModal(); });
  modalStage?.addEventListener('touchstart', event => { touchStartX = event.changedTouches[0]?.clientX || 0; }, { passive: true });
  modalStage?.addEventListener('touchend', event => {
    const distance = (event.changedTouches[0]?.clientX || 0) - touchStartX;
    if (Math.abs(distance) > 48) renderGalleryImage(currentImageIndex + (distance < 0 ? 1 : -1));
  }, { passive: true });
  document.addEventListener('keydown', event => {
    if (!modal || modal.hidden) return;
    if (event.key === 'Escape') closeModal();
    if (event.key === 'ArrowLeft') { event.preventDefault(); renderGalleryImage(currentImageIndex - 1); }
    if (event.key === 'ArrowRight') { event.preventDefault(); renderGalleryImage(currentImageIndex + 1); }
  });
  const hasMultipleImages = imageSources.length > 1;
  document.getElementById('zoomPrev')?.toggleAttribute('hidden', !hasMultipleImages);
  document.getElementById('zoomNext')?.toggleAttribute('hidden', !hasMultipleImages);
  document.getElementById('zoomThumbs')?.toggleAttribute('hidden', !hasMultipleImages);
  renderGalleryImage(currentImageIndex);
})();
</script>
<script src="/js/online-presence.js" asp-append-version="true" defer></script>
<script src="/js/nsx-pro-v2.js" asp-append-version="true" defer></script>
<script src="/js/nsx-install-guide.js" asp-append-version="true" defer></script>
</body>

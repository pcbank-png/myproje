@functions {
    private static string ProductThumb(string imagePath, int width, int version)
    {
        if (string.IsNullOrWhiteSpace(imagePath) || !imagePath.StartsWith("/uploads/products/images/", StringComparison.OrdinalIgnoreCase)) return imagePath;
        var fileName = System.IO.Path.GetFileName(imagePath);
        return string.IsNullOrWhiteSpace(fileName) ? imagePath : $"{NSYazilim.Web.Services.ProductThumbnailGenerator.GetRelativePath(fileName, width)}?v={version}";
    }

    private static decimal CampaignDiscount(decimal amount, NSYazilim.Web.Models.Campaign campaign)
    {
        if (amount <= 0 || campaign.DiscountValue <= 0 || (campaign.MinimumCartTotal > 0 && amount < campaign.MinimumCartTotal)) return 0;
        var fixedDiscount = string.Equals(campaign.DiscountType, "Fixed", StringComparison.OrdinalIgnoreCase) || string.Equals(campaign.DiscountType, "FixedAmount", StringComparison.OrdinalIgnoreCase) || string.Equals(campaign.DiscountType, "Amount", StringComparison.OrdinalIgnoreCase);
        return Math.Round(Math.Clamp(fixedDiscount ? campaign.DiscountValue : amount * campaign.DiscountValue / 100m, 0, amount), 2, MidpointRounding.AwayFromZero);
    }

    private static string CampaignLabel(NSYazilim.Web.Models.Campaign campaign, string discountLabel)
    {
        var fixedDiscount = string.Equals(campaign.DiscountType, "Fixed", StringComparison.OrdinalIgnoreCase) || string.Equals(campaign.DiscountType, "FixedAmount", StringComparison.OrdinalIgnoreCase) || string.Equals(campaign.DiscountType, "Amount", StringComparison.OrdinalIgnoreCase);
        return fixedDiscount ? $"{campaign.DiscountValue:N0} TL {discountLabel}" : $"%{campaign.DiscountValue:N0} {discountLabel}";
    }

    private static List<string> ProductFeatures(string name)
    {
        var value = (name ?? "").ToLowerInvariant();
        if (value.Contains("düğün")) return new() { "Rezervasyon ve salon planlama", "Sözleşme oluşturma", "Cari ve kasa takibi", "SMS bilgilendirme", "Müşteri yönetimi", "Etkinlik takvimi" };
        if (value.Contains("komisyon")) return new() { "Çok kullanıcılı yapı", "Cari hesap yönetimi", "Komisyon hesaplama", "Tahsilat takibi", "Gelişmiş raporlar", "Veri yedekleme" };
        if (value.Contains("oto tamir")) return new() { "Servis kabul", "Parça ve işçilik", "Araç geçmişi", "Cari hesap", "Müşteri takibi", "Servis raporları" };
        if (value.Contains("oto galeri")) return new() { "Araç stok yönetimi", "Kapora takibi", "Kâr ve zarar", "Müşteri yönetimi", "Cari takip", "Satış raporları" };
        if (value.Contains("servispro live")) return new() { "QR canlı takip", "SMS bildirimi", "Müşteri onayı", "Servis kabul", "Cihaz geçmişi", "Canlı durum takibi" };
        if (value.Contains("klinik") || value.Contains("randevu")) return new() { "Hasta yönetimi", "Randevu takibi", "Kapı üstü sıra", "Hasta monitörü", "Sesli çağrı", "Tahsilat takibi" };
        if (value.Contains("teknik servis")) return new() { "Servis fişi", "Müşteri geçmişi", "Cihaz kabul", "Arıza takibi", "Teslim yönetimi", "Servis raporları" };
        if (value.Contains("veresiye")) return new() { "Cari kartlar", "Borç ve alacak", "Tahsilat takibi", "Hatırlatmalar", "Detaylı raporlar", "Veri yedekleme" };
        if (value.Contains("turbo") || value.Contains("performans")) return new() { "Hızlı temizlik", "Performans modu", "Tek tık optimizasyon", "Başlangıç yönetimi", "Sistem araçları", "Kolay kullanım" };
        return new() { "Kolay kullanım", "Güvenli veri", "Detaylı raporlar", "Windows uyumu", "Uzaktan kurulum", "Teknik destek" };
    }
}

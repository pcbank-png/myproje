@model List<NSYazilim.Web.Models.Order>

@{
    ViewData["Title"] = "Sipariş Yönetimi";
}

<section class="nsx-admin-page">
    <div class="nsx-admin-page-head">
        <div>
            <span>NSX Admin</span>
            <h1>Sipariş Yönetimi</h1>
            <p>Siparişleri, ödeme durumlarını ve alınan ürünleri hızlıca inceleyin.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="nsx-admin-btn" href="/Admin/ManualSale">Manuel Satış Gir</a>
            <a class="nsx-admin-btn light" href="/Admin">Admin Panel</a>
        </div>
    </div>

    <div class="nsx-admin-card">
        <div class="nsx-admin-card-head">
            <div>
                <strong>Sipariş Listesi</strong>
                <small>@Model.Count kayıt</small>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="nsx-admin-empty">Henüz sipariş yok.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table nsx-admin-table align-middle">
                    <thead>
                        <tr>
                            <th>Sipariş No</th>
                            <th>Üye</th>
                            <th>Satın Alınan Ürün</th>
                            <th>Tutar</th>
                            <th>Ödeme</th>
                            <th>Tarih</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var order in Model)
                    {
                        var isPaid = order.PaymentStatus == "Paid" || order.PaymentStatus == "Completed";
                        var isFailed = order.PaymentStatus == "Failed" || order.PaymentStatus == "Rejected";

                        <tr>
                            <td>
                                <strong>@order.OrderNumber</strong>
                                <small>#@order.Id</small>
                                @if ((order.OrderNumber ?? string.Empty).StartsWith("NSX-MAN-", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="nsx-admin-pill ok mt-1">Manuel Satış</span>
                                }
                            </td>
                            <td>@(order.User?.Email ?? "Üye bilgisi yok")</td>
                            <td>
                                @if (order.OrderItems != null && order.OrderItems.Any())
                                {
                                    <div class="d-flex flex-column gap-1">
                                        @foreach (var item in order.OrderItems)
                                        {
                                            var productName = item.Product?.Name ?? "Ürün bilgisi yok";
                                            var licenseLabel = item.LicenseType == "Lifetime" ? "Sınırsız" : "Yıllık";

                                            <div>
                                                <span class="fw-semibold">@productName</span>
                                                <span class="text-muted small">x @item.Quantity</span>
                                                <span class="nsx-admin-pill neutral">@licenseLabel</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">Ürün bilgisi yok</span>
                                }
                            </td>
                            <td>
                                <form method="post" action="/Admin/OrderAmountUpdate" class="d-flex align-items-center gap-1" style="min-width: 190px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <div class="input-group input-group-sm flex-nowrap">
                                        <input type="number" name="amount" value="@order.TotalAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" step="0.01" min="0.01" class="form-control" aria-label="Sipariş tutarı" required />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                    <button type="submit" class="nsx-admin-btn sm">Kaydet</button>
                                </form>
                            </td>
                            <td><span class="nsx-admin-pill @(isPaid ? "ok" : isFailed ? "bad" : "warn")">@StatusTextHelper.PaymentStatus(order.PaymentStatus)</span></td>
                            <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end">
                                <form method="post" action="/Admin/OrderDelete" class="d-inline" onsubmit="return confirm('Bu sipariş kaydı silinsin mi? Lisanslar silinmez, sadece sipariş bağlantısı kaldırılır.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <button type="submit" class="nsx-admin-btn danger sm">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

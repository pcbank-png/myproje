@model NSYazilim.Web.ViewModels.CampaignCouponListViewModel

@{
    ViewData["Title"] = "Kampanya / Kupon";
    var form = Model?.Form ?? new NSYazilim.Web.ViewModels.CampaignCouponFormViewModel();
    var coupons = Model?.Coupons ?? new List<NSYazilim.Web.Models.CampaignCoupon>();
    string DateInput(DateTime? date) => date.HasValue ? date.Value.ToString("yyyy-MM-ddTHH:mm") : string.Empty;
}

<div class="nsx-campaign-page">
    <section class="nsx-campaign-hero">
        <div>
            <div class="nsx-campaign-kicker">NSX Admin</div>
            <h1>Kampanya & Kupon Sistemi</h1>
            <p>Yüzde veya sabit indirimli kuponlar oluştur, kullanım limiti ve tarih aralığı belirle.</p>
        </div>
        <a href="/Admin" class="btn btn-light rounded-4 fw-bold px-4">Admin Panel</a>
    </section>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 mt-3">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 mt-3">@TempData["Error"]</div>
    }

    <div class="row g-4 mt-1">
        <div class="col-xl-5">
            <section class="nsx-campaign-card">
                <h2>@(form.Id > 0 ? "Kupon Güncelle" : "Yeni Kupon Oluştur")</h2>

                <form class="nsx-standard-form" method="post" action="/Admin/CampaignSave" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@form.Id" />

                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Kupon Kodu</label>
                        <input name="Code" class="form-control" value="@form.Code" placeholder="NSX10" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Başlık</label>
                        <input name="Title" class="form-control" value="@form.Title" placeholder="Yeni üyeye özel indirim" required />
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">İndirim Tipi</label>
                            <select name="DiscountType" class="form-select">
                                <option value="Percent" selected="@(form.DiscountType != "Fixed")">Yüzde (%)</option>
                                <option value="Fixed" selected="@(form.DiscountType == "Fixed")">Sabit Tutar</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">İndirim Değeri</label>
                            <input name="DiscountValue" value="@form.DiscountValue.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" class="form-control" required />
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Minimum Tutar</label>
                            <input name="MinimumCartAmount" value="@(form.MinimumCartAmount?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "0")" type="number" step="0.01" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Kullanım Limiti</label>
                            <input name="UsageLimit" value="@form.UsageLimit" type="number" class="form-control" />
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Başlangıç</label>
                            <input name="StartDate" value="@DateInput(form.StartDate)" type="datetime-local" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Bitiş</label>
                            <input name="EndDate" value="@DateInput(form.EndDate)" type="datetime-local" class="form-control" />
                        </div>
                    </div>

                    <label class="nsx-campaign-check mt-3">
                        <input type="hidden" name="IsActive" value="false" />
                        <input type="checkbox" name="IsActive" value="true" @(form.IsActive ? "checked" : "") />
                        <span>Kupon aktif olsun</span>
                    </label>

                    <button type="submit" class="btn btn-primary rounded-4 fw-bold px-4 mt-3">
                        @(form.Id > 0 ? "Güncelle" : "Oluştur")
                    </button>

                    @if (form.Id > 0)
                    {
                        <a href="/Admin/Campaigns" class="btn btn-outline-secondary rounded-4 fw-bold mt-3">Vazgeç</a>
                    }
                </form>
            </section>
        </div>

        <div class="col-xl-7">
            <section class="nsx-campaign-card">
                <h2>Kuponlar</h2>

                @if (!coupons.Any())
                {
                    <div class="nsx-campaign-empty">Henüz kupon yok.</div>
                }
                else
                {
                    <div class="nsx-campaign-list">
                        @foreach (var item in coupons)
                        {
                            <div class="nsx-campaign-item">
                                <div>
                                    <span class="nsx-campaign-code">@item.Code</span>
                                    <h3>@item.Title</h3>
                                    <p>
                                        @(item.DiscountType == "Fixed" ? $"{item.DiscountValue:N2} ₺" : $"%{item.DiscountValue:N0}") indirim
                                        · Minimum: @((item.MinimumCartAmount ?? 0).ToString("N2")) ₺
                                        · Kullanım: @item.UsedCount@(item.UsageLimit != null ? $"/{item.UsageLimit}" : "")
                                    </p>
                                    <small>
                                        @(item.StartDate?.ToString("dd.MM.yyyy HH:mm") ?? "Başlangıç yok")
                                        -
                                        @(item.EndDate?.ToString("dd.MM.yyyy HH:mm") ?? "Bitiş yok")
                                    </small>
                                </div>

                                <div class="nsx-campaign-actions">
                                    <span class="@(item.IsActive ? "ok" : "bad")">@(item.IsActive ? "Aktif" : "Pasif")</span>

                                    <a class="btn btn-sm btn-outline-primary rounded-4 fw-bold" href="/Admin/CampaignEdit/@item.Id">Düzenle</a>

                                    <form method="post" action="/Admin/CampaignToggle">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="btn btn-sm btn-outline-warning rounded-4 fw-bold" type="submit">Aktif/Pasif</button>
                                    </form>

                                    <form method="post" action="/Admin/CampaignDelete" onsubmit="return confirm('Kupon silinsin mi?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="btn btn-sm btn-outline-danger rounded-4 fw-bold" type="submit">Sil</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

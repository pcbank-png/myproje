@model NSYazilim.Web.ViewModels.BulkMailViewModel

@{
    ViewData["Title"] = "Toplu Mail";
}

<div class="nsx-bulkmail-page">
    <section class="nsx-bulkmail-hero">
        <div>
            <div class="nsx-bulkmail-kicker">NSX Admin</div>
            <h1>Toplu Mail Merkezi</h1>
            <p>Müşterilere kampanya, bilgilendirme ve ürün duyurularını profesyonel şablonla gönder.</p>
        </div>
        <a href="/Admin" class="btn btn-light rounded-4 fw-bold px-4">Admin Panel</a>
    </section>

    <div class="row g-4 mt-1">
        <div class="col-xl-7">
            <section class="nsx-bulkmail-card">
                <h2>Yeni Mail Gönder</h2>
                <p class="text-muted">Seçilen hedef gruptaki aktif müşteri hesaplarına gönderilir.</p>

                <form id="bulkMailForm" class="nsx-standard-form" method="post" action="/Admin/BulkMail">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Alıcı Grubu</label>
                        <select asp-for="TargetGroup" class="form-select">
                            <option value="all">Tüm aktif üyeler</option>
                            <option value="ordered">Sipariş veren üyeler</option>
                            <option value="licensed">Lisans sahibi üyeler</option>
                        </select>
                        <span asp-validation-for="TargetGroup" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Konu</label>
                        <input asp-for="Subject" class="form-control" placeholder="Örn: NSX Turbo yeni sürüm duyurusu" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mesaj</label>
                        <textarea asp-for="Message" class="form-control" rows="9" placeholder="Müşterilere gönderilecek mesaj..."></textarea>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>

                    <label class="nsx-bulkmail-check">
                        <input asp-for="SendAsHtml" />
                        <span>NSX premium mail şablonu ile gönder</span>
                    </label>

                    <button id="bulkMailSubmit" type="submit" class="btn btn-primary rounded-4 fw-bold px-4 mt-3">
                        Toplu Mail Gönder
                    </button>

                    <div id="bulkMailProgress" class="alert alert-info mt-3 mb-0 d-none" role="status"></div>
                </form>
            </section>
        </div>

        <div class="col-xl-5">
            <section class="nsx-bulkmail-card">
                <h2>Gönderim Özeti</h2>

                <div class="nsx-bulkmail-stats">
                    <div>
                        <span>Başarılı</span>
                        <strong>@Model.SentCount</strong>
                    </div>
                    <div>
                        <span>Hatalı</span>
                        <strong>@Model.FailedCount</strong>
                    </div>
                </div>

                <div class="nsx-bulkmail-info">
                    <strong>Not</strong>
                    <p>Mail gönderimi SMTP ayarlarını kullanır. Gmail için uygulama şifresi gereklidir.</p>
                </div>
            </section>

            <section class="nsx-bulkmail-card mt-4">
                <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                    <h2 class="mb-0">Son Gönderimler</h2>
                    @if (Model.LatestLogs.Any())
                    {
                        <form method="post" action="/Admin/BulkMailLogsClear" onsubmit="return confirm('Tüm toplu mail geçmişi silinsin mi?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-4 fw-bold">Tümünü Sil</button>
                        </form>
                    }
                </div>

                @if (!Model.LatestLogs.Any())
                {
                    <div class="nsx-bulkmail-empty">Henüz mail kaydı yok.</div>
                }
                else
                {
                    <div class="nsx-bulkmail-log-list">
                        @foreach (var item in Model.LatestLogs)
                        {
                            <div class="nsx-bulkmail-log">
                                <div>
                                    <strong>@(item.ToName ?? item.ToEmail)</strong>
                                    <small>@item.ToEmail · @item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                    <em>@item.Subject</em>
                                    @if (!item.IsSuccess && !string.IsNullOrWhiteSpace(item.ErrorMessage))
                                    {
                                        <code>@item.ErrorMessage</code>
                                    }
                                </div>
                                <div class="d-flex flex-column align-items-end gap-2">
                                    <span class="@(item.IsSuccess ? "ok" : "bad")">
                                        @(item.IsSuccess ? "Başarılı" : "Hatalı")
                                    </span>
                                    <form method="post" action="/Admin/BulkMailLogDelete" onsubmit="return confirm('Bu mail kaydı silinsin mi?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-4">Sil</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById('bulkMailForm');
            const submitButton = document.getElementById('bulkMailSubmit');
            const progressBox = document.getElementById('bulkMailProgress');

            if (!form || !submitButton || !progressBox) return;

            let running = false;

            const setProgress = (text, isError = false) => {
                progressBox.classList.remove('d-none', 'alert-info', 'alert-danger', 'alert-success');
                progressBox.classList.add(isError ? 'alert-danger' : 'alert-info');
                progressBox.textContent = text;
            };

            const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));

            form.addEventListener('submit', async (event) => {
                event.preventDefault();
                if (running) return;

                if (window.jQuery && !window.jQuery(form).valid()) return;
                if (!confirm('Toplu mail gönderilsin mi?')) return;

                running = true;
                submitButton.disabled = true;
                submitButton.textContent = 'Gönderim Devam Ediyor...';

                let offset = 0;
                let totalSent = 0;
                let totalFailed = 0;
                let total = 0;
                let consecutiveRequestErrors = 0;

                try {
                    while (true) {
                        const payload = new FormData(form);
                        payload.append('offset', offset.toString());

                        let response;
                        try {
                            response = await fetch('/Admin/BulkMailBatch', {
                                method: 'POST',
                                body: payload,
                                credentials: 'same-origin'
                            });
                        } catch (requestError) {
                            consecutiveRequestErrors++;
                            if (consecutiveRequestErrors >= 3) throw requestError;
                            setProgress(`Bağlantı geçici olarak kesildi. ${offset}/${total || '?'} işlendi. 10 saniye sonra devam ediliyor...`);
                            await sleep(10000);
                            continue;
                        }

                        if (!response.ok) {
                            consecutiveRequestErrors++;
                            if (consecutiveRequestErrors >= 3) {
                                const message = await response.text();
                                throw new Error(message || 'Sunucu toplu mail isteğini tamamlayamadı.');
                            }
                            setProgress(`Sunucu geçici hata verdi. ${offset}/${total || '?'} işlendi. 10 saniye sonra aynı partiden devam ediliyor...`);
                            await sleep(10000);
                            continue;
                        }

                        consecutiveRequestErrors = 0;
                        const result = await response.json();
                        if (!result.ok) throw new Error(result.message || 'Toplu mail gönderimi başlatılamadı.');

                        total = result.total || total;
                        totalSent += result.sent || 0;
                        totalFailed += result.failed || 0;
                        offset = result.nextOffset || offset;

                        setProgress(`İşlenen: ${Math.min(offset, total)}/${total} · Başarılı: ${totalSent} · Hatalı: ${totalFailed}`);

                        if (result.done) {
                            progressBox.classList.remove('alert-info');
                            progressBox.classList.add('alert-success');
                            progressBox.textContent = `Toplu mail tamamlandı. Başarılı: ${totalSent} · Hatalı: ${totalFailed} · Toplam: ${total}`;
                            break;
                        }

                        // Partiler arasında da kısa nefes vererek 1000+ alıcıda SMTP hız limitini azalt.
                        await sleep(3000);
                    }
                } catch (error) {
                    setProgress(`Gönderim durdu. İşlenen: ${offset}/${total || '?'} · Başarılı: ${totalSent} · Hatalı: ${totalFailed}. ${error?.message || 'Beklenmeyen hata.'}`, true);
                } finally {
                    running = false;
                    submitButton.disabled = false;
                    submitButton.textContent = 'Toplu Mail Gönder';
                }
            });
        })();
    </script>
}

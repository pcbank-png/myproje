@model string
@using NSYazilim.Web.Services
@{
    var editorValue = ProductContentSanitizer.NormalizeForEditor(Model);
}

<div class="nsx-rich-editor" data-rich-editor>
    <div class="nsx-editor-heading">
        <div>
            <label for="DescriptionEditor">Geniş Ürün Açıklaması</label>
            <small>Buradaki başlık, paragraf, liste ve vurgular ürün detay sayfasında aynı düzenle gösterilir.</small>
        </div>
        <span data-editor-count>0 karakter</span>
    </div>
    <div class="nsx-editor-toolbar" role="toolbar" aria-label="Açıklama biçimlendirme araçları">
        <select id="DescriptionBlockType" data-editor-block aria-label="Metin biçimi">
            <option value="p">Paragraf</option>
            <option value="h2">Büyük Başlık</option>
            <option value="h3">Alt Başlık</option>
            <option value="blockquote">Alıntı / Önemli Not</option>
        </select>
        <span class="nsx-editor-separator"></span>
        <button type="button" data-editor-command="bold" title="Kalın"><b>K</b></button>
        <button type="button" data-editor-command="italic" title="İtalik"><i>İ</i></button>
        <button type="button" data-editor-command="underline" title="Altı çizili"><u>A</u></button>
        <span class="nsx-editor-separator"></span>
        <button type="button" data-editor-command="insertUnorderedList" title="Madde işaretli liste">• Liste</button>
        <button type="button" data-editor-command="insertOrderedList" title="Numaralı liste">1. Liste</button>
        <button type="button" data-editor-link title="Bağlantı ekle">Bağlantı</button>
        <span class="nsx-editor-separator"></span>
        <button type="button" data-editor-command="removeFormat" title="Biçimi temizle">Temizle</button>
        <button type="button" data-editor-command="undo" title="Geri al">↶</button>
        <button type="button" data-editor-command="redo" title="Yinele">↷</button>
        <button type="button" class="nsx-source-toggle" data-editor-source>HTML</button>
    </div>
    <div id="DescriptionEditor" class="nsx-editor-surface" contenteditable="true" role="textbox" aria-multiline="true" data-placeholder="Ürünü ayrıntılı anlatın; başlıklar, paragraflar ve listeler kullanabilirsiniz."></div>
    <textarea id="Description" name="Description" class="nsx-editor-source" spellcheck="false">@editorValue</textarea>
</div>

<style>
    .nsx-rich-editor{border:1px solid #d7dde5;border-radius:18px;background:#fff;overflow:hidden;box-shadow:0 9px 24px rgba(15,23,42,.05)}
    .nsx-editor-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;padding:16px 17px;background:linear-gradient(135deg,#f8fafc,#fff);border-bottom:1px solid #e5e9ef}
    .nsx-editor-heading label{margin:0 0 5px;font-size:15px}.nsx-editor-heading small{margin:0!important;line-height:1.5}.nsx-editor-heading>span{color:#64748b;background:#eef2f6;border-radius:999px;padding:6px 9px;font-size:11px;font-weight:800;white-space:nowrap}
    .nsx-editor-toolbar{display:flex;align-items:center;gap:6px;flex-wrap:wrap;padding:10px 12px;background:#f8fafc;border-bottom:1px solid #e5e9ef}
    .nsx-editor-toolbar button,.nsx-editor-toolbar select{width:auto;min-height:34px;border:1px solid #d8dee7;border-radius:9px;background:#fff;color:#263244;padding:0 10px;font-size:12px;font-weight:800;cursor:pointer;box-shadow:none}
    .nsx-editor-toolbar button:hover,.nsx-editor-toolbar button.is-active,.nsx-editor-toolbar select:focus{border-color:#f56800;background:#fff6ef;color:#c64f00}
    .nsx-editor-separator{width:1px;height:24px;background:#dce2e9;margin:0 2px}.nsx-source-toggle{margin-left:auto}
    .nsx-editor-surface,.nsx-editor-source{width:100%;min-height:320px;border:0!important;border-radius:0!important;padding:24px!important;background:#fff;outline:0;box-shadow:none!important;color:#263244;font:15px/1.78 Arial,Helvetica,sans-serif;overflow:auto}
    #nsxUploadForm [data-rich-editor] #DescriptionBlockType{display:inline-block!important;width:160px!important;min-width:160px!important;max-width:160px!important;min-height:36px!important;padding:0 10px!important}
    #nsxUploadForm [data-rich-editor] #DescriptionEditor,
    #nsxUploadForm [data-rich-editor] #Description.nsx-editor-source{width:100%!important;min-width:100%!important;max-width:100%!important;min-height:320px!important;height:320px!important;padding:22px!important;box-sizing:border-box!important}
    #nsxUploadForm [data-rich-editor] #Description.nsx-editor-source{display:none!important;resize:vertical!important;border:0!important;border-radius:0!important;background:#0f172a!important;color:#e2e8f0!important;font-family:Consolas,"Cascadia Mono",monospace!important;font-size:13px!important;line-height:1.6!important;box-shadow:none!important}
    .nsx-editor-surface:empty:before{content:attr(data-placeholder);color:#94a3b8;pointer-events:none}.nsx-editor-surface h2{font-size:28px;line-height:1.2;margin:4px 0 15px}.nsx-editor-surface h3{font-size:21px;line-height:1.3;margin:20px 0 10px}.nsx-editor-surface p{margin:0 0 14px}.nsx-editor-surface ul,.nsx-editor-surface ol{padding-left:24px;margin:0 0 16px}.nsx-editor-surface blockquote{margin:18px 0;padding:14px 17px;border-left:4px solid #f56800;background:#fff7ed;color:#7c2d12;border-radius:0 12px 12px 0}.nsx-editor-surface a{color:#e95d00;text-decoration:underline}.nsx-editor-source{display:none;resize:vertical;font-family:Consolas,monospace;font-size:13px;line-height:1.6;background:#0f172a;color:#e2e8f0}
    .nsx-rich-editor.is-source .nsx-editor-surface{display:none!important}.nsx-rich-editor.is-source .nsx-editor-source{display:block!important}.nsx-rich-editor.is-source .nsx-source-toggle{color:#fff;background:#0f172a;border-color:#0f172a}
    #nsxUploadForm [data-rich-editor].is-source #DescriptionEditor{display:none!important}
    #nsxUploadForm [data-rich-editor].is-source #Description.nsx-editor-source{display:block!important}
    @@media(max-width:760px){.nsx-editor-heading{display:block}.nsx-editor-heading>span{display:inline-block;margin-top:10px}.nsx-editor-toolbar select{width:100%}.nsx-source-toggle{margin-left:0}.nsx-editor-surface,.nsx-editor-source{min-height:270px;padding:18px!important}#nsxUploadForm [data-rich-editor] #DescriptionBlockType{width:100%!important;min-width:100%!important;max-width:100%!important}#nsxUploadForm [data-rich-editor] #DescriptionEditor,#nsxUploadForm [data-rich-editor] #Description.nsx-editor-source{min-height:270px!important;height:270px!important;padding:18px!important}}
</style>

<script>
(() => {
    const root = document.currentScript.previousElementSibling.previousElementSibling;
    if (!root || !root.matches('[data-rich-editor]')) return;
    const editor = root.querySelector('.nsx-editor-surface');
    const source = root.querySelector('.nsx-editor-source');
    const counter = root.querySelector('[data-editor-count]');
    const form = root.closest('form');

    const syncSource = () => {
        source.value = editor.innerHTML.trim();
        const length = (editor.textContent || '').trim().length;
        counter.textContent = `${length} karakter`;
    };
    const syncEditor = () => {
        editor.innerHTML = source.value;
        syncSource();
    };
    const run = (command, value = null) => {
        editor.focus();
        document.execCommand(command, false, value);
        syncSource();
    };

    editor.innerHTML = source.value;
    syncSource();
    editor.addEventListener('input', syncSource);
    source.addEventListener('input', () => {
        const text = source.value.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
        counter.textContent = `${text.length} karakter`;
    });
    root.querySelectorAll('[data-editor-command]').forEach(button => button.addEventListener('click', () => run(button.dataset.editorCommand)));
    root.querySelector('[data-editor-block]').addEventListener('change', event => run('formatBlock', `<${event.target.value}>`));
    root.querySelector('[data-editor-link]').addEventListener('click', () => {
        const url = prompt('Bağlantı adresini yazın (https://... veya /sayfa):');
        if (url) run('createLink', url.trim());
    });
    root.querySelector('[data-editor-source]').addEventListener('click', () => {
        const openingSource = !root.classList.contains('is-source');
        if (openingSource) syncSource(); else syncEditor();
        root.classList.toggle('is-source', openingSource);
    });
    form?.addEventListener('submit', () => {
        if (root.classList.contains('is-source')) syncEditor();
        syncSource();
    });
})();
</script>

<section class="nsx-purchase-page">
    <div class="nsx-purchase-hero">
        <div class="container nsx-purchase-hero-inner">
            <div><span>SATIN ALMA BİLDİRİMİ</span><h1>Ödemenizi bildirin,<br /><em>lisansınızı hazırlayalım.</em></h1><p>Havale veya EFT işleminizden sonra bilgileri gönderin. Ödemeniz kontrol edildiğinde lisansınız hesabınıza tanımlanır.</p></div>
            <div class="nsx-purchase-steps" aria-label="Satın alma adımları"><div class="done"><b>1</b><span><strong>Ürünü seçin</strong><small>Tamamlandı</small></span></div><div class="active"><b>2</b><span><strong>Ödemeyi bildirin</strong><small>Şu anki adım</small></span></div><div><b>3</b><span><strong>Lisansı alın</strong><small>Onay sonrası</small></span></div></div>
        </div>
    </div>
    <div class="nsx-info-divider"></div>

    <div class="container nsx-purchase-layout">
        <main class="nsx-purchase-form-panel">
            @if (TempData["Error"] is string error) { <div class="nsx-form-message is-error">@error</div> }
            <div class="nsx-purchase-section-head"><span>01</span><div><small>LİSANS SEÇİMİ</small><h2>Lisans türünü seçin</h2><p>İhtiyacınıza uygun lisans seçeneğini belirleyin. Ödenecek tutar otomatik güncellenir.</p></div></div>
            <form method="post" action="/Havale-Bildirimi" class="nsx-purchase-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ProductId" />
                <div asp-validation-summary="ModelOnly" class="nsx-validation"></div>
                <div class="nsx-purchase-license-grid">
                    <label class="nsx-purchase-license @(Model.LicenseType != "Lifetime" ? "active" : "")" data-price="@Money(Model.YearlyPayableAmount)" data-base-price="@Money(Model.YearlyPrice)" data-discount="@Money(Model.YearlyCampaignDiscountAmount)" data-campaign-name="@Model.YearlyCampaignName" data-campaign-text="@Model.YearlyCampaignDiscountText" data-license-name="Yıllık Lisans" data-transfer-description="@localizedTransferDescription"><input type="radio" name="LicenseType" value="Yearly" @yearlyChecked /><span>YILLIK LİSANS</span><strong>@Money(Model.YearlyPayableAmount)</strong><small>365 gün kullanım</small></label>
                    <label class="nsx-purchase-license @(Model.LicenseType == "Lifetime" ? "active" : "")" data-price="@Money(Model.LifetimePayableAmount)" data-base-price="@Money(Model.LifetimePrice)" data-discount="@Money(Model.LifetimeCampaignDiscountAmount)" data-campaign-name="@Model.LifetimeCampaignName" data-campaign-text="@Model.LifetimeCampaignDiscountText" data-license-name="Sınırsız Lisans" data-transfer-description="@localizedTransferDescription"><input type="radio" name="LicenseType" value="Lifetime" @lifetimeChecked /><span>SINIRSIZ LİSANS</span><strong>@Money(Model.LifetimePayableAmount)</strong><small>Ömür boyu kullanım</small></label>
                </div>

                <div class="nsx-purchase-section-head form-head"><span>02</span><div><small>BİLDİRİM BİLGİLERİ</small><h2>Ödeme bilgilerini girin</h2><p>Hesabınızdaki bilgiler otomatik alınmıştır. Havalenin kim tarafından gönderildiğini belirtin.</p></div></div>
                <div class="nsx-purchase-fields">
                    <label>Ad soyad<input type="text" value="@Model.FullName" readonly /></label>
                    <label>E-posta<input type="email" value="@Model.Email" readonly /></label>
                    <label>Telefon<input type="text" value="@(Model.Phone ?? "-")" readonly /></label>
                    <label>Ödenecek tutar<input id="bankTransferAmountDisplay" type="text" value="@Money(Model.Amount)" readonly /></label>
                    <label>Gönderen ad soyad<input asp-for="SenderName" autocomplete="name" required /><span asp-validation-for="SenderName" class="nsx-field-error"></span></label>
                    <label>Gönderen banka<input asp-for="SenderBank" placeholder="Örnek: Ziraat Bankası" /></label>
                    <label>Dekont / işlem numarası<input asp-for="ReceiptNumber" placeholder="Varsa yazın" /></label>
                    <label>Havale tarihi<input asp-for="TransferDate" type="date" /></label>
                    <label class="full">Ek not<textarea asp-for="Note" rows="4" placeholder="Eklemek istediğiniz bir not varsa yazın"></textarea></label>
                </div>
                <div class="nsx-purchase-warning"><b>!</b><div><strong>Önemli ödeme bilgisi</strong><p>Lütfen Havale/EFT yaparken açıklama kısmını boş bırakınız.</p></div></div>
                <button type="submit" class="nsx-purchase-submit">Satın Alma Bildirimini Gönder <span>→</span></button>
            </form>
        </main>

        <aside class="nsx-purchase-summary">
            <section><span>SİPARİŞ ÖZETİ</span><div class="nsx-purchase-product"><img src="@image" alt="@(product?.Name ?? "Ürün") ürün görseli" /><div><strong>@(product?.Name ?? "Ürün")</strong><small><span id="bankSummaryLicense">@licenseName</span> · Dijital teslimat</small></div></div><dl><div><dt>Ürün tutarı</dt><dd id="bankSummaryLinePrice">@Money(Model.OriginalAmount)</dd></div><div id="bankSummaryDiscountRow" class="discount" style="@(Model.HasCampaignDiscount ? "" : "display:none")"><dt>Kampanya indirimi</dt><dd id="bankSummaryDiscount">-@Money(Model.CampaignDiscountAmount)</dd></div><div><dt>Teslimat</dt><dd>Ücretsiz</dd></div><div><dt>Ödeme yöntemi</dt><dd>Havale / EFT</dd></div></dl><div class="nsx-purchase-total"><span>Ödenecek toplam</span><strong id="bankSummaryTotal">@Money(Model.Amount)</strong></div><div id="bankCampaignInfo" class="nsx-purchase-campaign" style="@(Model.HasCampaignDiscount ? "" : "display:none")"><strong id="bankCampaignName">@Model.CampaignName</strong><span id="bankCampaignText">@Model.CampaignDiscountText</span></div></section>
            <section class="nsx-bank-box"><span>BANKA BİLGİLERİ</span>@if(Model.HasBankInfo){<p>Ödemeyi aşağıdaki hesaba yaptıktan sonra formu gönderin.</p><dl><div><dt>Banka</dt><dd>@Model.BankName</dd></div><div><dt>Alıcı</dt><dd>@Model.AccountHolder</dd></div><div><dt>IBAN</dt><dd class="iban">@Model.Iban</dd></div>@if(!string.IsNullOrWhiteSpace(Model.BankBranch)){<div><dt>Şube</dt><dd>@Model.BankBranch</dd></div>}<div><dt>Açıklama</dt><dd id="bankTransferDescription">@localizedTransferDescription</dd></div></dl>}else{<div class="nsx-form-message is-error">Banka bilgileri henüz tanımlanmamış. Lütfen destek ekibiyle iletişime geçin.</div>}<div class="nsx-bank-help"><strong>Yardıma mı ihtiyacınız var?</strong><a href="https://wa.me/905434624226" target="_blank" rel="noreferrer">WhatsApp destek →</a></div></section>
        </aside>
    </div>
</section>


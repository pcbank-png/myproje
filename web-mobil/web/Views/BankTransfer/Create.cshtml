@model NSYazilim.Web.ViewModels.BankTransferNotificationViewModel
@inject NSYazilim.Web.Services.SiteLocalizationService SiteLocalization
@{
    ViewData["Robots"] = "noindex, nofollow, noarchive";
    ViewData["Title"] = "Satın Alma Bildirimi";
    ViewData["SkipActiveCampaign"] = true;
    var product = Model.Product;
    var image = product?.Images?.OrderByDescending(x => x.IsMain).ThenBy(x => x.SortOrder).FirstOrDefault()?.ImagePath ?? "/assets/img/01_veresiye_kutu.webp";
    var licenseName = Model.LicenseType == "Lifetime" ? "Sınırsız Lisans" : "Yıllık Lisans";
    var yearlyChecked = Model.LicenseType != "Lifetime" ? "checked" : null;
    var lifetimeChecked = Model.LicenseType == "Lifetime" ? "checked" : null;
    var currentLanguage = await SiteLocalization.GetCurrentLanguageAsync(Context.RequestAborted);
    const string transferDescriptionSource = "Lütfen Havale/EFT yaparken açıklama kısmını boş bırakınız.";
    var localizedTransferDescription = await SiteLocalization.TranslateAsync(transferDescriptionSource, currentLanguage.Code, Context.RequestAborted);
    string Money(decimal value) => $"{value:N2} TL";
}


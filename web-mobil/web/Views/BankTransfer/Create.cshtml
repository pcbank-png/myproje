        .nsx-purchase-page .nsx-purchase-steps .active strong{color:#fff!important;}
        .nsx-purchase-page .nsx-purchase-steps .active small{color:#fff0e5!important;opacity:1!important;}
        @@media(max-width:680px){
            .nsx-purchase-page .nsx-purchase-steps{min-width:0!important;}
            .nsx-purchase-page .nsx-purchase-steps > div{min-height:44px!important;padding:4px 12px!important;}
        }
    </style>
    <script src="~/lib/jquery/dist/jquery.min.js"></script><partial name="_ValidationScriptsPartial" />
    <script>
    (() => {
        const cards = document.querySelectorAll('.nsx-purchase-license');
        cards.forEach(card => card.querySelector('input')?.addEventListener('change', () => {
            cards.forEach(item => item.classList.remove('active')); card.classList.add('active');
            const price = card.dataset.price || '', base = card.dataset.basePrice || price, discount = card.dataset.discount || '';
            const campaignTextValue = card.dataset.campaignText || '', hasDiscount = campaignTextValue && !discount.startsWith('0,00') && !discount.startsWith('0.00');
            const set = (id, value) => { const el = document.getElementById(id); if (el) el.textContent = value; };
            const amount = document.getElementById('bankTransferAmountDisplay'); if (amount) amount.value = price;
            set('bankSummaryLicense', card.dataset.licenseName || ''); set('bankSummaryLinePrice', base); set('bankSummaryDiscount', `-${discount}`); set('bankSummaryTotal', price); set('bankCampaignName', card.dataset.campaignName || ''); set('bankCampaignText', campaignTextValue); set('bankTransferDescription', card.dataset.transferDescription || '');
            const row = document.getElementById('bankSummaryDiscountRow'); if(row) row.style.display = hasDiscount ? '' : 'none';
            const info = document.getElementById('bankCampaignInfo'); if(info) info.style.display = hasDiscount ? '' : 'none';
        }));
    })();
    </script>

@model NSYazilim.Web.Models.BankTransferNotification
@{
    ViewData["Robots"] = "noindex, nofollow, noarchive";
    ViewData["Title"] = "Satın Alma Bildirimi Alındı";
    ViewData["SkipActiveCampaign"] = true;
}
<style id="nsx-bank-transfer-success-pro-standard">
.public-content-page{--nsx-subpage-hero-height:286px;background:#fff!important;}
.public-content-page > .container{width:100%!important;max-width:none!important;margin:0!important;padding:0!important;}
.public-content-page .public-site-header .service-ribbon > .container,.public-content-page .public-site-header .detail-nav.container,.nsx-purchase-success-hero > .container,.nsx-purchase-success-page > .container{width:min(1505px,calc(100% - 48px))!important;max-width:1505px!important;margin-left:auto!important;margin-right:auto!important;}
@@media (min-width:981px){.public-content-page .public-site-header .detail-nav.container{display:flex!important;align-items:center!important;min-height:78px!important;gap:8px!important}.public-content-page .public-site-header .brand{flex:0 0 auto!important;margin:0 auto 0 0!important}.public-content-page .public-site-header .brand-logo{width:clamp(142px,10.8vw,184px)!important;max-width:184px!important;height:auto!important}.public-content-page .public-site-header .nav-links{margin-left:auto!important;margin-right:7px!important;gap:7px!important}.public-content-page .public-site-header .nav-cta{margin-left:0!important}.public-content-page .public-site-header .menu-toggle{display:none!important}}
body:has(.nsx-purchase-success-page) .public-site-header .nav-links > a[href="/store"]{color:#fff!important;border-color:#ff6e04!important;background:#ff6e04!important;box-shadow:0 0 0 1px rgba(255,110,4,.18),0 12px 26px rgba(255,110,4,.20)!important}body:has(.nsx-purchase-success-page) .public-site-header .nav-links > a[href="/store"]::after{background:#fff!important}
.nsx-purchase-success-page{padding:0 0 70px!important;background:#fff!important;}
.nsx-purchase-success-hero{position:relative;height:var(--nsx-subpage-hero-height)!important;min-height:var(--nsx-subpage-hero-height)!important;max-height:var(--nsx-subpage-hero-height)!important;overflow:hidden;color:#fff;background:radial-gradient(ellipse at 80% 50%,rgba(255,110,4,.10) 0%,rgba(255,110,4,.03) 26%,transparent 48%),linear-gradient(118deg,#030405 0%,#06080b 42%,#0a1219 100%);border-top:1px solid rgba(255,255,255,.04);border-bottom:1px solid rgba(255,255,255,.06);box-shadow:inset 0 1px 0 rgba(255,255,255,.03),inset 0 -50px 90px rgba(0,0,0,.22)}
.nsx-purchase-success-hero:before{content:"";position:absolute;inset:0;pointer-events:none;opacity:.10;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:72px 72px;-webkit-mask-image:linear-gradient(90deg,rgba(0,0,0,.95) 0%,rgba(0,0,0,.55) 58%,transparent 100%);mask-image:linear-gradient(90deg,rgba(0,0,0,.95) 0%,rgba(0,0,0,.55) 58%,transparent 100%)}
.nsx-purchase-success-hero > .container{position:relative;z-index:2;height:100%;display:flex;align-items:flex-start;padding-top:24px!important;padding-bottom:24px!important}.nsx-purchase-success-copy{max-width:980px}.nsx-purchase-success-kicker{display:flex;align-items:center;gap:10px;margin:0 0 14px;color:#39d98a;font-size:12px;font-weight:900;letter-spacing:.11em;text-transform:uppercase}.nsx-purchase-success-kicker:before{content:"";width:7px;height:7px;border-radius:50%;background:#39d98a;box-shadow:0 0 0 5px rgba(57,217,138,.12)}.nsx-purchase-success-hero h1{max-width:900px;margin:0;color:#fff;font-size:42px;font-weight:900;line-height:1.06;letter-spacing:-.04em}.nsx-purchase-success-hero h1 em{display:block;color:#ff6e04;font-style:normal}.nsx-purchase-success-hero p{max-width:900px;margin:12px 0 0;color:#d3d8df;font-size:14px;line-height:1.7;font-weight:520}.nsx-purchase-success-points{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}.nsx-purchase-success-points span{display:inline-flex;align-items:center;gap:7px;min-height:34px;padding:0 11px;border:1px solid rgba(255,255,255,.15);border-radius:999px;background:rgba(255,255,255,.045);color:#d9dee4;font-size:10px;font-weight:800}.nsx-purchase-success-points b{color:#39d98a;font-size:11px}
.nsx-purchase-success-page > .container{padding-top:38px!important}.nsx-purchase-success{max-width:980px!important;margin:0 auto!important;padding:34px!important;border:1px solid #e1e6eb!important;border-radius:20px!important;background:#fff!important;box-shadow:0 16px 42px rgba(15,23,42,.065)!important;text-align:center}.nsx-purchase-success-icon{display:grid;place-items:center;width:58px;height:58px;margin:0 auto 18px;border-radius:16px;background:#eaf8f1;color:#159054;font-size:24px;font-weight:900}.nsx-purchase-success > span{color:#ff6e04!important;font-size:11px!important;font-weight:900!important;letter-spacing:.11em!important}.nsx-purchase-success h2{margin:9px 0 10px;color:#171b20;font-size:27px;line-height:1.12;font-weight:900;letter-spacing:-.035em}.nsx-purchase-success > p{max-width:720px;margin:0 auto;color:#687586;font-size:13px;line-height:1.7}.nsx-purchase-success-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:10px!important;margin-top:26px!important}.nsx-purchase-success-grid > div{padding:15px!important;border:1px solid #e8ebef!important;border-radius:12px!important;background:#fafbfc!important}.nsx-purchase-next{margin-top:18px!important;border:1px solid #ffd9bd!important;border-left:3px solid #ff6e04!important;border-radius:12px!important;background:#fff8f2!important}.nsx-purchase-next b{color:#ff6e04!important}.nsx-purchase-success-actions a{min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:10px!important;padding:0 18px!important;border-radius:11px!important;white-space:nowrap!important}.nsx-purchase-success-actions a:first-child{min-width:205px!important;padding-left:22px!important;padding-right:16px!important;border-color:#ff6e04!important;background:#ff6e04!important;color:#fff!important;box-shadow:0 9px 20px rgba(255,110,4,.20)!important}.nsx-purchase-success-actions a:first-child span{display:inline-grid!important;place-items:center!important;flex:0 0 28px!important;width:28px!important;height:28px!important;margin-left:2px!important;border-radius:8px!important;background:rgba(255,255,255,.96)!important;color:#e85d00!important;font-size:16px!important;line-height:1!important}.nsx-purchase-success-actions a:first-child:hover{background:#171b20!important;border-color:#171b20!important}.nsx-purchase-success-actions a:first-child:hover span{color:#171b20!important}
@@media(max-width:1180px){.public-content-page .public-site-header .service-ribbon > .container,.public-content-page .public-site-header .detail-nav.container,.nsx-purchase-success-hero > .container,.nsx-purchase-success-page > .container{width:calc(100% - 32px)!important}.nsx-purchase-success-hero h1{font-size:38px!important}}
@@media(max-width:980px){.public-content-page .public-site-header .service-ribbon > .container,.public-content-page .public-site-header .detail-nav.container{width:calc(100% - 24px)!important}}
@@media(max-width:680px){.nsx-purchase-success-hero > .container,.nsx-purchase-success-page > .container{width:calc(100% - 18px)!important}.nsx-purchase-success-hero > .container{padding-top:20px!important;padding-bottom:20px!important}.nsx-purchase-success-hero h1{font-size:30px!important}.nsx-purchase-success-hero p{font-size:13px!important}.nsx-purchase-success-points{gap:7px!important;flex-wrap:nowrap!important;overflow-x:auto!important;scrollbar-width:none!important}.nsx-purchase-success-points::-webkit-scrollbar{display:none!important}.nsx-purchase-success-points span{flex:0 0 auto!important;min-height:31px!important;padding:0 9px!important;font-size:9px!important}.nsx-purchase-success-page > .container{padding-top:26px!important}.nsx-purchase-success{padding:24px 18px!important}.nsx-purchase-success-grid{grid-template-columns:1fr 1fr!important}.nsx-purchase-success-actions{flex-direction:column!important}.nsx-purchase-success-actions a{width:100%!important}}
</style>
<section class="nsx-purchase-success-hero">
    <div class="container">
        <div class="nsx-purchase-success-copy">
            <span class="nsx-purchase-success-kicker">NSX Güvenli Satın Alma</span>
            <h1>Ödeme bildiriminiz <em>başarıyla kaydedildi.</em></h1>
            <p>Ödemeniz kontrol edildikten sonra lisansınız ve indirme erişiminiz NSX hesabınıza tanımlanacaktır.</p>
            <div class="nsx-purchase-success-points" aria-label="Bildirim durumu"><span><b>✓</b> Bildirim alındı</span><span><b>✓</b> Kontrol sırasına alındı</span><span><b>✓</b> Lisans hesabınıza tanımlanacak</span></div>
        </div>
    </div>
</section>
<section class="nsx-purchase-page nsx-purchase-success-page">
    <div class="container">
        <div class="nsx-purchase-success">
            <div class="nsx-purchase-success-icon">✓</div><span>BİLDİRİMİNİZ ALINDI</span><h2>Satın alma bildiriminiz işleme alındı.</h2><p>Bilgileriniz güvenli şekilde kaydedildi. Onay süreci tamamlandığında lisansınız hesabınızda görünecektir.</p>
            <div class="nsx-purchase-success-grid"><div><small>Bildirim No</small><strong>#@Model.Id</strong></div><div><small>Sipariş No</small><strong>@(Model.Order?.OrderNumber ?? "-")</strong></div><div><small>Ürün</small><strong>@(Model.Product?.Name ?? "Ürün")</strong></div><div><small>Lisans</small><strong>@(Model.LicenseType == "Lifetime" ? "Sınırsız Lisans" : "Yıllık Lisans")</strong></div><div><small>Tutar</small><strong>@Model.Amount.ToString("N2") ₺</strong></div><div><small>Durum</small><strong class="pending">Onay bekliyor</strong></div></div>
            <div class="nsx-purchase-next"><b>SONRAKİ ADIM</b><p>Ödeme onaylandığında lisansınız hazırlanır ve hesabınızdaki Lisanslarım ile İndirmelerim bölümleri aktif olur.</p></div>
            <div class="nsx-purchase-success-actions"><a href="/Account/Orders">Siparişlerime Git <span>→</span></a><a href="/store">Yazılımlara Dön</a></div>
        </div>
    </div>
</section>

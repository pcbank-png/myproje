    }
    @@media(max-width:520px){
        .public-content-page .public-site-header .service-ribbon > .container,.public-content-page .public-site-header .detail-nav.container{width:calc(100% - 18px)!important;}
        .public-content-page .public-site-header .brand-logo{width:clamp(112px,34vw,136px)!important;}
    }
</style>

<section class="nsx-video-detail-page">
    <div class="container">
        <header class="nsx-video-detail-head">
            <div>
                <span>@(string.IsNullOrWhiteSpace(Model.Video.VideoType) ? "Program Videosu" : Model.Video.VideoType)</span>
                <h1><span class="nsx-short-hero-white">@videoHeroMain</span> <span class="nsx-short-hero-orange">@videoHeroAccent</span></h1>
                <p>@Model.ProductDescription</p>
                <div class="nsx-video-detail-points" aria-label="Video özellikleri">
                    <span><b>✓</b> NSX program videosu</span>
                    <span><b>✓</b> Kurulum ve kullanım rehberi</span>
                    <span><b>✓</b> Hızlı video erişimi</span>
                </div>
            </div>
        </header>

        <div class="nsx-video-detail-grid">
            <div class="nsx-video-player-shell" id="video-player">
                <div class="nsx-video-player">
                    <iframe
                        src="@Model.EmbedUrl"
                        title="@Model.DisplayTitle"
                        loading="eager"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen></iframe>
                </div>
                <div class="nsx-video-youtube-link">
                    <span>Video YouTube üzerinden oynatılıyor.</span>
                    <a href="@Model.Video.YouTubeUrl" target="_blank" rel="noopener noreferrer">YouTube'da Aç</a>
                </div>
            </div>

            <aside class="nsx-video-product-panel">
                <span class="nsx-video-panel-kicker">Video ile Bağlı Program</span>
                <h2>@Model.Product.Name</h2>
                <p>@Model.ProductDescription</p>

                <div class="nsx-video-product-facts">
                    <div><small>Durum</small><strong>@(Model.HasStock ? "Kullanıma Hazır" : "Stokta Yok")</strong></div>
                    <div><small>Lisans</small><strong>@(Model.IsFreeProduct ? "Ücretsiz" : "Yıllık / Sınırsız")</strong></div>
                    <div><small>Teslimat</small><strong>Dijital</strong></div>
                </div>

                @if (Model.HasStock)
                {
                    <div class="nsx-video-product-actions">
                        <a class="primary" href="@primaryActionUrl">@primaryActionText</a>
                        <a href="@secondaryActionUrl">@secondaryActionText</a>
                        @if (!Model.IsFreeProduct)
                        {
                            <a href="@Model.ProductUrl">Program Detayı</a>
                        }
                    </div>
                }
                else
                {
                    <div class="nsx-video-stock-warning">Bu program şu anda stokta olmadığı için indirme ve satın alma işlemleri kapalıdır.</div>
                    <a class="nsx-video-detail-only" href="@Model.ProductUrl">Program Detayını Aç</a>
                }
            </aside>
        </div>

        <section class="nsx-video-description-panel">
            <span>Program Hakkında</span>
            <h2>@Model.Product.Name</h2>
            <p>@Model.ProductDescription</p>
            @if (string.Equals(Model.Product.Slug, "nsx-veresiye-takip-pro-free", StringComparison.OrdinalIgnoreCase))
            {
                <p><strong>Güncel v1.0.5 sürüm notu:</strong> Bu kurulum videosu temel masaüstü kullanımını gösterir. Güncel programda ayrıca Cloud Bağlantısı üzerinden QR ile mobil erişim, Toplam Borç / Toplam Tahsilat / Açık Bakiye özeti, müşteri arama, cari hareket görüntüleme, borç-tahsilat girişi ve canlı senkronizasyon bulunur.</p>
            }
            <a href="@Model.ProductUrl">Tüm ürün özelliklerini incele →</a>
        </section>

        @if (Model.RelatedVideos.Any())
        {
            <section class="nsx-related-videos">
                <div class="nsx-related-head">
                    <div><span>Diğer İçerikler</span><h2>İzleyebileceğiniz videolar</h2></div>
                    <a href="/videolar">Tüm Videolar</a>
                </div>
                <div class="nsx-related-grid">
                    @foreach (var item in Model.RelatedVideos)
                    {
                        <article>
                            <a class="media" href="/videolar/@item.Slug">
                                <img src="@item.ThumbnailUrl" alt="@item.DisplayTitle" width="480" height="360" loading="lazy" decoding="async" />
                                <span>▶</span>
                            </a>
                            <div><small>@item.VideoType</small><h3><a href="/videolar/@item.Slug">@item.DisplayTitle</a></h3></div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
</section>

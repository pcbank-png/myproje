@model NSYazilim.Web.ViewModels.ProductVideoDetailViewModel
@{
    ViewData["SkipActiveCampaign"] = true;
    var primaryActionUrl = Model.IsFreeProduct
        ? $"/store/downloadfree?productId={Model.Product.Id}"
        : $"/Havale-Bildirimi?productId={Model.Product.Id}&licenseType=Yearly";
    var primaryActionText = Model.IsFreeProduct ? "Ücretsiz İndir" : "Satın Al";
    var secondaryActionText = Model.IsFreeProduct ? "Programı İncele" : "Ücretsiz İndir";
    var secondaryActionUrl = Model.IsFreeProduct
        ? Model.ProductUrl
        : $"/store/downloaddemo?productId={Model.Product.Id}";
    var videoHeroWords = (Model.DisplayTitle ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var videoHeroAccentCount = videoHeroWords.Length >= 4 ? 2 : 1;
    var videoHeroMain = videoHeroWords.Length > videoHeroAccentCount
        ? string.Join(" ", videoHeroWords.Take(videoHeroWords.Length - videoHeroAccentCount))
        : string.Empty;
    var videoHeroAccent = videoHeroWords.Length > 0
        ? string.Join(" ", videoHeroWords.Skip(Math.Max(0, videoHeroWords.Length - videoHeroAccentCount)))
        : Model.DisplayTitle;
}


@model NSYazilim.Web.Controllers.NasPageViewModel
@using System.IO
@{
    Layout = null;
    var pathSegments = (Model.CurrentPath ?? string.Empty)
        .Split('/', StringSplitOptions.RemoveEmptyEntries);
}
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light" />
    <title>NSX Kişisel Bulut | NAS</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <style>
        :root {
            color-scheme: light;
            --orange: #f56800;
            --orange-dark: #c65300;
            --orange-soft: #fff4ec;
            --ink: #20242a;
            --muted: #667085;
            --line: #e4e7ec;
            --bg: #f7f9fc;
            --white: #fff;
            --green: #16a34a;
            --red: #d92d20;
            --blue: #2563eb;
            --shadow: 0 24px 70px rgba(16, 24, 40, .10);
        }

        * { box-sizing: border-box; }
        html, body { min-height: 100%; }
        body {
            margin: 0;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: var(--ink);
            background:
                radial-gradient(circle at 7% 5%, rgba(245, 104, 0, .10), transparent 26rem),
                radial-gradient(circle at 96% 88%, rgba(245, 104, 0, .06), transparent 30rem),
                var(--bg);
        }

        button, input { font: inherit; }
        button { -webkit-tap-highlight-color: transparent; }
        a { color: inherit; }

        .page {
            width: min(1240px, calc(100% - 32px));
            margin: 0 auto;
            padding: 34px 0 42px;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 18px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            text-decoration: none;
        }

        .brand img {
            width: min(210px, 48vw);
            height: auto;
            display: block;
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border: 1px solid #bbf7d0;
            border-radius: 999px;
            background: #f0fdf4;
            color: #166534;
            font-size: 12px;
            font-weight: 850;
            white-space: nowrap;
        }

        .status::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 0 4px rgba(22, 163, 74, .12);
        }

        .card {
            overflow: hidden;
            border: 1px solid var(--line);
            border-radius: 26px;
            background: rgba(255,255,255,.97);
            box-shadow: var(--shadow);
        }

        .login-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 360px;
            min-height: 570px;
        }

        .login-main {
            padding: 58px 64px 52px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 16px;
            color: var(--orange-dark);
            font-size: 12px;
            font-weight: 900;
            letter-spacing: .09em;
            text-transform: uppercase;
        }

        .eyebrow::before {
            content: "";
            width: 30px;
            height: 3px;
            border-radius: 99px;
            background: var(--orange);
        }

        h1 {
            margin: 0;
            max-width: 720px;
            font-size: clamp(36px, 5vw, 62px);
            line-height: 1;
            letter-spacing: -.045em;
            font-weight: 920;
        }

        .lead {
            max-width: 690px;
            margin: 20px 0 0;
            color: var(--muted);
            font-size: 16px;
            line-height: 1.65;
        }

        .alert {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin: 20px 0 0;
            padding: 13px 15px;
            border: 1px solid #fecaca;
            border-radius: 13px;
            background: #fef2f2;
            color: #991b1b;
            font-size: 13px;
            line-height: 1.5;
        }

        .login-form {
            max-width: 520px;
            margin-top: 30px;
            display: grid;
            gap: 14px;
        }

        .field label {
            display: block;
            margin-bottom: 7px;
            color: #344054;
            font-size: 13px;
            font-weight: 800;
        }

        .input-wrap { position: relative; }
        .input {
            width: 100%;
            height: 50px;
            padding: 0 14px;
            border: 1px solid #d0d5dd;
            border-radius: 13px;
            outline: none;
            background: #fff;
            color: var(--ink);
            transition: border-color .16s ease, box-shadow .16s ease;
        }

        .input:focus {
            border-color: #f6a56b;
            box-shadow: 0 0 0 4px rgba(245,104,0,.10);
        }

        .password-input { padding-right: 74px; }
        .show-pass {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            border: 0;
            background: transparent;
            color: #667085;
            padding: 8px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 800;
        }

        .btn {
            border: 0;
            border-radius: 13px;
            min-height: 48px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            padding: 0 17px;
            font-size: 14px;
            font-weight: 850;
            cursor: pointer;
            text-decoration: none;
            transition: transform .15s ease, box-shadow .15s ease, background .15s ease, border-color .15s ease;
        }

        .btn:hover { transform: translateY(-1px); }
        .btn-primary {
            color: #fff;
            background: linear-gradient(135deg, #ff740f, var(--orange));
            box-shadow: 0 12px 26px rgba(245,104,0,.23);
        }
        .btn-primary:hover { box-shadow: 0 15px 32px rgba(245,104,0,.29); }
        .btn-light {
            border: 1px solid var(--line);
            background: #fff;
            color: #344054;
        }
        .btn-light:hover { background: #fffaf6; border-color: #fed7aa; }
        .btn-danger {
            color: #fff;
            background: var(--red);
        }
        .btn-sm { min-height: 38px; padding: 0 12px; font-size: 12.5px; }

        .login-form .btn { width: 100%; min-height: 52px; margin-top: 2px; }
        .security-note {
            display: flex;
            gap: 10px;
            margin-top: 18px;
            color: #667085;
            font-size: 12.5px;
            line-height: 1.55;
        }
        .security-note strong { color: #475467; }

        .login-side {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 44px 32px;
            border-left: 1px solid var(--line);
            background: linear-gradient(180deg, #fffaf6, #fff3e9);
            text-align: center;
        }

        .qr-box {
            width: 216px;
            aspect-ratio: 1;
            padding: 12px;
            border: 1px solid #fed7aa;
            border-radius: 22px;
            background: #fff;
            box-shadow: 0 16px 36px rgba(196, 86, 0, .12);
        }
        .qr-box img { width: 100%; height: 100%; object-fit: contain; display: block; }
        .login-side h2 { margin: 20px 0 7px; font-size: 19px; letter-spacing: -.02em; }
        .login-side p { max-width: 260px; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.55; }
        .short-url {
            margin-top: 14px;
            padding: 8px 11px;
            border-radius: 10px;
            background: rgba(255,255,255,.85);
            color: var(--orange-dark);
            font-size: 12px;
            font-weight: 850;
        }

        .manager {
            min-height: 650px;
        }

        .manager-head {
            padding: 24px 26px 20px;
            border-bottom: 1px solid var(--line);
            background: linear-gradient(180deg, #fff, #fffdfb);
        }

        .manager-topline {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .manager-title {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .drive-icon {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            border-radius: 13px;
            background: var(--orange-soft);
            color: var(--orange-dark);
        }
        .drive-icon svg { width: 23px; height: 23px; }
        .manager-title h1 { font-size: 23px; letter-spacing: -.025em; line-height: 1.15; }
        .manager-title p { margin: 3px 0 0; color: var(--muted); font-size: 12.5px; }

        .head-actions { display: flex; align-items: center; gap: 8px; }
        .logout-form { margin: 0; }

        .toolbar {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .search {
            position: relative;
            min-width: 220px;
            flex: 1 1 260px;
        }
        .search svg {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            width: 17px;
            height: 17px;
            color: #98a2b3;
        }
        .search input {
            width: 100%;
            height: 42px;
            padding: 0 14px 0 39px;
            border: 1px solid var(--line);
            border-radius: 12px;
            outline: none;
            background: #fff;
            color: #344054;
            font-size: 13px;
        }
        .search input:focus { border-color: #f6a56b; box-shadow: 0 0 0 3px rgba(245,104,0,.08); }

        .breadcrumbs {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 16px;
            min-width: 0;
            overflow-x: auto;
            scrollbar-width: none;
            color: #667085;
            font-size: 13px;
        }
        .breadcrumbs::-webkit-scrollbar { display: none; }
        .breadcrumbs a { color: #344054; font-weight: 750; text-decoration: none; white-space: nowrap; }
        .breadcrumbs a:hover { color: var(--orange-dark); }
        .crumb-sep { color: #d0d5dd; }

        .manager-body { padding: 20px 22px 24px; }

        .dropzone {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 15px;
            padding: 13px 16px;
            border: 1px dashed #f6b98c;
            border-radius: 14px;
            background: #fffaf6;
            color: #475467;
            transition: border-color .16s ease, background .16s ease, transform .16s ease;
        }
        .dropzone.is-dragging {
            border-color: var(--orange);
            background: #fff1e6;
            transform: scale(.998);
        }
        .dropzone strong { color: #344054; font-size: 13px; }
        .dropzone span { color: #98a2b3; font-size: 12px; }
        .drop-copy { min-width: 0; }
        #fileInput { display: none; }

        .selection-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 0 0 12px;
            padding: 10px 12px;
            border: 1px solid var(--line);
            border-radius: 14px;
            background: linear-gradient(180deg, #fff, #fffdfb);
        }
        .selection-summary {
            display: flex;
            align-items: center;
            gap: 9px;
            min-width: 118px;
            color: #475467;
            font-size: 12.5px;
            font-weight: 850;
        }
        .selection-summary::before {
            content: "";
            width: 8px;
            height: 8px;
            flex: 0 0 auto;
            border-radius: 50%;
            background: #d0d5dd;
            box-shadow: 0 0 0 4px rgba(208,213,221,.22);
            transition: background .16s ease, box-shadow .16s ease;
        }
        .selection-toolbar.has-selection .selection-summary::before {
            background: var(--orange);
            box-shadow: 0 0 0 4px rgba(245,104,0,.12);
        }
        .selection-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 7px;
            flex-wrap: wrap;
        }
        .selection-actions .btn[disabled] {
            opacity: .46;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }
        .btn-copy {
            border: 1px solid #bfdbfe;
            background: #eff6ff;
            color: #1d4ed8;
        }
        .btn-copy:hover { border-color: #93c5fd; background: #dbeafe; }
        .btn-paste {
            border: 1px solid #fed7aa;
            background: #fff7ed;
            color: #c2410c;
        }
        .btn-paste:hover { border-color: #fdba74; background: #ffedd5; }
        .select-check {
            width: 17px;
            height: 17px;
            margin: 0;
            accent-color: var(--orange);
            cursor: pointer;
        }
        .col-select { width: 5%; text-align: center !important; }
        .select-cell { text-align: center; }
        .file-row.is-selected td { background: #fff7f0; }
        .file-row.is-selected:hover td { background: #fff3e8; }

        .table-wrap {
            overflow: hidden;
            border: 1px solid var(--line);
            border-radius: 16px;
            background: #fff;
        }

        .file-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }
        .file-table th {
            height: 43px;
            padding: 0 14px;
            border-bottom: 1px solid var(--line);
            background: #f9fafb;
            color: #667085;
            font-size: 11px;
            font-weight: 850;
            letter-spacing: .035em;
            text-align: left;
            text-transform: uppercase;
        }
        .file-table td {
            height: 58px;
            padding: 8px 14px;
            border-bottom: 1px solid #f0f1f3;
            color: #475467;
            font-size: 13px;
            vertical-align: middle;
        }
        .file-table tr:last-child td { border-bottom: 0; }
        .file-row:hover td { background: #fffcfa; }
        .col-name { width: 45%; }
        .col-size { width: 12%; }
        .folder-size-loading { display:inline-flex; align-items:center; gap:7px; color:#98a2b3; white-space:nowrap; }
        .folder-size-loading::before { content:""; width:11px; height:11px; border:2px solid #e4e7ec; border-top-color:var(--orange); border-radius:50%; animation:nassFolderSizeSpin .72s linear infinite; flex:0 0 auto; }
        .folder-size-ready { color:#344054; font-weight:700; }
        .folder-size-error { color:#98a2b3; }
        @@keyframes nassFolderSizeSpin { to { transform:rotate(360deg); } }
        .col-date { width: 21%; }
        .col-actions { width: 17%; text-align: right !important; }

        .entry {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }
        .entry-icon {
            width: 36px;
            height: 36px;
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            border-radius: 10px;
            background: #f2f4f7;
            color: #667085;
        }
        .entry-icon.folder { background: #fff3e8; color: var(--orange); }
        .entry-icon svg { width: 21px; height: 21px; }
        .entry-name {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: #344054;
            font-weight: 760;
            text-decoration: none;
        }
        a.entry-name:hover { color: var(--orange-dark); }
        .entry-sub {
            margin-top: 2px;
            color: #98a2b3;
            font-size: 11px;
        }

        .row-actions {
            display: flex;
            justify-content: flex-end;
            gap: 5px;
        }
        .icon-btn {
            width: 34px;
            height: 34px;
            display: inline-grid;
            place-items: center;
            border: 1px solid transparent;
            border-radius: 9px;
            background: transparent;
            color: #667085;
            cursor: pointer;
        }
        .icon-btn:hover { border-color: var(--line); background: #f9fafb; color: #344054; }
        .icon-btn.delete:hover { border-color: #fecaca; background: #fff5f5; color: var(--red); }
        .icon-btn svg { width: 17px; height: 17px; }

        .empty {
            display: grid;
            place-items: center;
            min-height: 280px;
            padding: 34px;
            text-align: center;
        }
        .empty-icon {
            width: 68px;
            height: 68px;
            display: grid;
            place-items: center;
            border-radius: 20px;
            background: var(--orange-soft);
            color: var(--orange);
        }
        .empty-icon svg { width: 34px; height: 34px; }
        .empty h3 { margin: 16px 0 5px; font-size: 18px; }
        .empty p { margin: 0; color: var(--muted); font-size: 13px; }

        .manager-foot {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            margin-top: 12px;
            padding: 0 3px;
            color: #98a2b3;
            font-size: 11.5px;
        }

        body.nass-uploading { overflow: hidden; }

        .upload-progress {
            position: fixed;
            inset: 0;
            z-index: 140;
            display: grid;
            place-items: center;
            padding: 22px;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity .2s ease, visibility .2s ease;
        }
        .upload-progress::before {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(16, 24, 40, .42);
            backdrop-filter: blur(7px);
            -webkit-backdrop-filter: blur(7px);
        }
        .upload-progress.show {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }
        .upload-progress-card {
            position: relative;
            z-index: 1;
            width: min(340px, calc(100vw - 32px));
            min-height: 350px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 34px 30px 30px;
            border: 1px solid rgba(255,255,255,.86);
            border-radius: 28px;
            background: rgba(255,255,255,.96);
            box-shadow: 0 34px 90px rgba(16,24,40,.28), 0 8px 26px rgba(245,104,0,.10);
            text-align: center;
            transform: translateY(10px) scale(.97);
            transition: transform .24s cubic-bezier(.2,.9,.2,1);
        }
        .upload-progress.show .upload-progress-card { transform: translateY(0) scale(1); }
        .progress-orbit {
            position: relative;
            width: 164px;
            height: 164px;
            display: grid;
            place-items: center;
        }
        .progress-ring-svg {
            position: absolute;
            inset: 14px;
            width: 136px;
            height: 136px;
            overflow: visible;
            filter: drop-shadow(0 8px 14px rgba(245,104,0,.12));
        }
        .progress-ring-bg,
        .progress-ring-value {
            fill: none;
            stroke-width: 8;
        }
        .progress-ring-bg { stroke: #f1f3f6; }
        .progress-ring-value {
            stroke: url(#nassProgressGradient);
            stroke-linecap: round;
            stroke-dasharray: 100;
            stroke-dashoffset: 100;
            transform: rotate(-90deg);
            transform-origin: 50% 50%;
            transition: stroke-dashoffset .16s ease-out;
        }
        .progress-spinner {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 2px solid rgba(245,104,0,.10);
            border-top-color: var(--orange);
            border-right-color: #ffad70;
            animation: nassProgressSpin .9s linear infinite;
        }
        .progress-spinner::after {
            content: "";
            position: absolute;
            width: 9px;
            height: 9px;
            top: 9px;
            left: 50%;
            border-radius: 50%;
            background: var(--orange);
            box-shadow: 0 0 0 7px rgba(245,104,0,.10), 0 4px 12px rgba(245,104,0,.32);
            transform: translateX(-50%);
        }
        .progress-number {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: baseline;
            justify-content: center;
            min-width: 96px;
            color: var(--ink);
            font-size: 34px;
            line-height: 1;
            font-weight: 920;
            letter-spacing: -.045em;
            font-variant-numeric: tabular-nums;
        }
        .progress-label {
            max-width: 270px;
            margin-top: 18px;
            color: #20242a;
            font-size: 15px;
            line-height: 1.35;
            font-weight: 850;
            overflow-wrap: anywhere;
        }
        .progress-subtext {
            margin-top: 7px;
            color: #7b8494;
            font-size: 12.5px;
            line-height: 1.5;
        }
        .progress-bytes {
            min-height: 19px;
            margin-top: 5px;
            color: #344054;
            font-size: 12px;
            line-height: 1.45;
            font-weight: 800;
            font-variant-numeric: tabular-nums;
        }
        .progress-pulse {
            width: 46px;
            height: 4px;
            margin-top: 20px;
            overflow: hidden;
            border-radius: 999px;
            background: #f2f4f7;
        }
        .progress-pulse::after {
            content: "";
            display: block;
            width: 20px;
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #ffb375, var(--orange));
            animation: nassProgressPulse 1.1s ease-in-out infinite alternate;
        }
        @@keyframes nassProgressSpin { to { transform: rotate(360deg); } }
        @@keyframes nassProgressPulse { from { transform: translateX(-4px); } to { transform: translateX(30px); } }
        @@media (prefers-reduced-motion: reduce) {
            .progress-spinner,
            .progress-pulse::after { animation-duration: 2.4s; }
        }

        .toast {
            position: fixed;
            left: 50%;
            bottom: 24px;
            z-index: 80;
            transform: translate(-50%, 18px);
            max-width: min(520px, calc(100vw - 30px));
            padding: 11px 15px;
            border-radius: 999px;
            background: #20242a;
            color: #fff;
            font-size: 12.5px;
            font-weight: 760;
            opacity: 0;
            pointer-events: none;
            transition: opacity .18s ease, transform .18s ease;
            box-shadow: 0 12px 32px rgba(0,0,0,.20);
        }
        .toast.show { opacity: 1; transform: translate(-50%, 0); }
        .toast.error { background: #b42318; }

        dialog.modal {
            width: min(460px, calc(100% - 28px));
            padding: 0;
            border: 0;
            border-radius: 18px;
            background: #fff;
            color: var(--ink);
            box-shadow: 0 24px 70px rgba(16,24,40,.24);
        }
        dialog.modal::backdrop { background: rgba(16,24,40,.44); backdrop-filter: blur(2px); }
        .modal-body { padding: 24px; }
        .modal-body h3 { margin: 0; font-size: 19px; letter-spacing: -.02em; }
        .modal-body p { margin: 8px 0 0; color: var(--muted); font-size: 13px; line-height: 1.55; }
        .modal-input { margin-top: 18px; }
        .modal-actions { display: flex; justify-content: flex-end; gap: 9px; margin-top: 22px; }

        .footer {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            margin-top: 14px;
            padding: 0 4px;
            color: #98a2b3;
            font-size: 11.5px;
        }


        /* NSX NASS - Pro visual polish (design only) */
        .manager {
            position: relative;
            border-color: rgba(228, 231, 236, .92);
            background:
                linear-gradient(180deg, rgba(255,255,255,.995), rgba(255,255,255,.985)),
                radial-gradient(circle at 88% 0%, rgba(245,104,0,.05), transparent 28rem);
            box-shadow:
                0 28px 74px rgba(16,24,40,.105),
                0 1px 0 rgba(255,255,255,.85) inset;
        }

        .manager::before {
            content: "";
            position: absolute;
            left: 28px;
            right: 28px;
            top: 0;
            height: 2px;
            border-radius: 0 0 999px 999px;
            background: linear-gradient(90deg, transparent, rgba(245,104,0,.72), transparent);
            opacity: .7;
            pointer-events: none;
        }

        .manager-head {
            padding: 25px 27px 21px;
            background:
                linear-gradient(180deg, rgba(255,255,255,.99), rgba(255,253,251,.97)),
                radial-gradient(circle at 92% 6%, rgba(245,104,0,.055), transparent 18rem);
        }

        .drive-icon {
            border: 1px solid #ffe1c7;
            background: linear-gradient(145deg, #fff8f2, #ffead8);
            box-shadow: 0 8px 18px rgba(245,104,0,.10), 0 1px 0 rgba(255,255,255,.9) inset;
        }

        .manager-title h1 {
            font-weight: 900;
            letter-spacing: -.032em;
        }

        .manager-title p {
            color: #7b8494;
            font-weight: 650;
        }

        .toolbar {
            gap: 10px;
        }

        .search input {
            border-color: #dfe3e8;
            background: rgba(255,255,255,.98);
            box-shadow: 0 1px 2px rgba(16,24,40,.025) inset;
            transition: border-color .16s ease, box-shadow .16s ease, background .16s ease;
        }

        .search input:hover {
            border-color: #d6dbe2;
            background: #fff;
        }

        .search input:focus {
            border-color: #f3a36a;
            box-shadow: 0 0 0 4px rgba(245,104,0,.09), 0 1px 2px rgba(16,24,40,.03) inset;
        }

        .btn {
            border-radius: 12px;
            letter-spacing: -.008em;
        }

        .btn-primary {
            background: linear-gradient(135deg, #ff7b1c 0%, #f56800 58%, #e95f00 100%);
            box-shadow: 0 10px 22px rgba(245,104,0,.22), 0 1px 0 rgba(255,255,255,.22) inset;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 14px 28px rgba(245,104,0,.27), 0 1px 0 rgba(255,255,255,.24) inset;
        }

        .btn-light {
            border-color: #dde2e8;
            box-shadow: 0 1px 2px rgba(16,24,40,.025);
        }

        .breadcrumbs {
            margin-top: 17px;
            padding-top: 1px;
            gap: 8px;
            font-weight: 650;
        }

        .breadcrumbs a {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            min-height: 30px;
            padding: 0 9px;
            border: 1px solid transparent;
            border-radius: 9px;
            color: #475467;
            font-weight: 820;
            transition: color .16s ease, background .16s ease, border-color .16s ease, transform .16s ease;
        }

        .breadcrumbs a:hover {
            color: var(--orange-dark);
            border-color: #fed7aa;
            background: #fff7ed;
            transform: translateY(-1px);
        }

        .breadcrumbs a:first-child {
            color: #344054;
            background: #f8fafc;
            border-color: #e4e7ec;
        }

        .breadcrumbs a:first-child:hover {
            color: var(--orange-dark);
            background: #fff7ed;
            border-color: #fed7aa;
        }

        .crumb-home-icon {
            width: 15px;
            height: 15px;
            flex: 0 0 auto;
        }

        .crumb-sep {
            width: 18px;
            height: 18px;
            display: inline-grid;
            place-items: center;
            flex: 0 0 auto;
            color: #b8c0cc;
        }

        .crumb-sep svg {
            width: 14px;
            height: 14px;
            display: block;
        }

        .manager-body {
            padding: 20px 22px 25px;
            background: linear-gradient(180deg, rgba(248,250,252,.28), rgba(255,255,255,0) 150px);
        }

        .dropzone {
            min-height: 64px;
            padding: 14px 16px;
            border-color: #f4b685;
            background:
                linear-gradient(180deg, #fffaf6, #fffdfb),
                repeating-linear-gradient(135deg, rgba(245,104,0,.02) 0 8px, transparent 8px 16px);
            box-shadow: 0 1px 0 rgba(255,255,255,.9) inset;
        }

        .dropzone:hover {
            border-color: #f39c5c;
            background: #fff8f2;
        }

        .selection-toolbar {
            min-height: 58px;
            padding: 10px 12px;
            border-color: #e0e4ea;
            background: linear-gradient(180deg, #ffffff, #fbfcfd);
            box-shadow: 0 5px 14px rgba(16,24,40,.025);
        }

        .selection-summary {
            color: #344054;
        }

        .selection-toolbar.has-selection {
            border-color: #fed7aa;
            background: linear-gradient(180deg, #fffdfb, #fff8f2);
            box-shadow: 0 8px 20px rgba(245,104,0,.055);
        }

        .table-wrap {
            border-color: #dfe3e8;
            border-radius: 18px;
            background: #fff;
            box-shadow: 0 8px 24px rgba(16,24,40,.035), 0 1px 0 rgba(255,255,255,.9) inset;
        }

        .file-table th {
            height: 46px;
            background: linear-gradient(180deg, #fbfcfd, #f8fafc);
            color: #70798a;
            letter-spacing: .055em;
        }

        .file-table td {
            height: 62px;
            transition: background .14s ease;
        }

        .file-row:hover td {
            background: #fffaf6;
        }

        .file-row.is-selected td {
            background: linear-gradient(90deg, #fff6ee, #fffaf7);
        }

        .entry-icon {
            border: 1px solid #e8ebef;
            box-shadow: 0 3px 10px rgba(16,24,40,.035);
        }

        .entry-icon.folder {
            border-color: #ffe0c2;
            background: linear-gradient(145deg, #fff8f1, #ffead8);
            box-shadow: 0 5px 14px rgba(245,104,0,.075);
        }

        .entry-name {
            font-weight: 800;
            letter-spacing: -.01em;
        }

        .icon-btn {
            border-radius: 10px;
            transition: color .14s ease, background .14s ease, border-color .14s ease, transform .14s ease;
        }

        .icon-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(16,24,40,.06);
        }

        /* Empty state: icon and copy are now mathematically centered in the panel. */
        .empty {
            position: relative;
            width: 100%;
            min-height: 320px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 46px 24px;
            overflow: hidden;
            text-align: center;
            background:
                radial-gradient(circle at 50% 48%, rgba(245,104,0,.055), transparent 12rem),
                linear-gradient(180deg, rgba(255,255,255,.98), rgba(252,253,255,.98));
        }

        .empty::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            border-radius: 50%;
            border: 1px solid rgba(245,104,0,.05);
            box-shadow:
                0 0 0 34px rgba(245,104,0,.018),
                0 0 0 72px rgba(245,104,0,.012);
            pointer-events: none;
        }

        .empty > div {
            position: relative;
            z-index: 1;
            width: min(430px, 100%);
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .empty-icon {
            width: 78px;
            height: 78px;
            margin: 0 auto;
            border: 1px solid #ffd9b8;
            border-radius: 24px;
            background: linear-gradient(145deg, #fffaf5 0%, #ffead8 100%);
            color: var(--orange);
            box-shadow:
                0 16px 34px rgba(245,104,0,.12),
                0 1px 0 rgba(255,255,255,.9) inset;
        }

        .empty-icon svg {
            width: 36px;
            height: 36px;
            filter: drop-shadow(0 3px 6px rgba(245,104,0,.08));
        }

        .empty h3 {
            margin: 18px 0 6px;
            color: #20242a;
            font-size: 19px;
            line-height: 1.25;
            font-weight: 900;
            letter-spacing: -.025em;
        }

        .empty p {
            max-width: 360px;
            margin: 0 auto;
            color: #7b8494;
            font-size: 13px;
            line-height: 1.6;
        }

        .manager-foot {
            margin-top: 13px;
            color: #9098a8;
        }

        .status {
            border-color: #b8efc8;
            background: linear-gradient(180deg, #f3fff6, #ecfbf1);
            box-shadow: 0 5px 15px rgba(22,163,74,.055);
        }

        .footer {
            color: #9aa2b1;
        }

        @@media (max-width: 860px) {
            .login-layout { grid-template-columns: 1fr; }
            .login-side { border-left: 0; border-top: 1px solid var(--line); }
            .login-main { padding: 44px 34px 36px; }
            .manager-topline { align-items: flex-start; }
            .col-select { width: 7%; }
            .col-size { width: 15%; }
            .col-date { display: none; }
            .file-table .date-cell { display: none; }
            .col-name { width: 54%; }
            .col-actions { width: 24%; }
        }

        @@media (max-width: 620px) {
            .page { width: min(100% - 18px, 1240px); padding: 16px 0 24px; }
            .topbar { margin-bottom: 12px; }
            .brand img { width: 160px; }
            .status { font-size: 10.5px; padding: 7px 9px; }
            .card { border-radius: 20px; }
            .login-main { padding: 34px 22px 28px; }
            .login-side { padding: 34px 22px; }
            .qr-box { width: 190px; }
            .manager-head { padding: 18px 16px 16px; }
            .manager-title h1 { font-size: 20px; }
            .manager-title p { display: none; }
            .head-actions .user-label { display: none; }
            .toolbar { display: grid; grid-template-columns: 1fr 1fr; }
            .search { grid-column: 1 / -1; min-width: 0; }
            .toolbar .btn { width: 100%; }
            .manager-body { padding: 13px 12px 18px; }
            .empty { min-height: 290px; padding: 38px 18px; }
            .empty-icon { width: 72px; height: 72px; border-radius: 22px; }
            .empty-icon svg { width: 33px; height: 33px; }
            .dropzone { align-items: flex-start; }
            .dropzone > .btn { flex: 0 0 auto; }
            .selection-toolbar { align-items: flex-start; flex-direction: column; padding: 10px; }
            .selection-actions { width: 100%; justify-content: flex-start; }
            .selection-actions .btn { flex: 1 1 auto; }
            .file-table th { display: none; }
            .file-table, .file-table tbody, .file-table tr, .file-table td { display: block; width: 100%; }
            .file-table tr { position: relative; padding: 10px 118px 10px 44px; border-bottom: 1px solid #f0f1f3; }
            .file-table tr:last-child { border-bottom: 0; }
            .file-table td { height: auto; padding: 0; border: 0; }
            .file-table .select-cell { position: absolute; left: 12px; top: 50%; width: 20px; transform: translateY(-50%); }
            .file-table .size-cell { margin: 5px 0 0 48px; color: #98a2b3; font-size: 11px; }
            .file-table .date-cell { display: none; }
            .file-table .actions-cell { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); width: auto; }
            .manager-foot { flex-direction: column; align-items: flex-start; }
            .footer { flex-direction: column; text-align: center; }
            .upload-progress { padding: 14px; }
            .upload-progress-card { min-height: 320px; padding: 28px 22px 24px; border-radius: 24px; }
            .progress-orbit { width: 150px; height: 150px; }
            .progress-ring-svg { inset: 13px; width: 124px; height: 124px; }
        }
    </style>
</head>
<body data-current-path="@Model.CurrentPath" translate="no" data-nsx-localization="off">
    <main class="page">
        <header class="topbar">
            <a class="brand" href="/" aria-label="NSX Yazılım ana sayfa">
                <img src="/nsx-assets/logo-brand.webp" alt="NSX Yazılım" />
            </a>
            <div class="status">HTTPS / WebDAV</div>
        </header>

        @if (!Model.IsAuthenticated)
        {
            <section class="card login-layout" aria-labelledby="loginTitle">
                <div class="login-main">
                    <div class="eyebrow">NSX Kişisel Bulut</div>
                    <h1 id="loginTitle">NAS dosyaların artık burada.</h1>
                    <p class="lead">
                        Klasörleri aç, dosya indir, yükle, yeniden adlandır veya sil. Keenetic'in düz WebDAV ekranı yerine NAS'ı doğrudan NSX arayüzünden yönet.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert" role="alert">
                            <span aria-hidden="true">⚠</span>
                            <span>@Model.ErrorMessage</span>
                        </div>
                    }

                    <form class="login-form" method="post" action="/nas/login">
                        @Html.AntiForgeryToken()
                        <div class="field">
                            <label for="userName">WebDAV kullanıcı adı</label>
                            <input class="input" id="userName" name="userName" value="@Model.UserName" autocomplete="username" autocapitalize="none" spellcheck="false" required />
                        </div>
                        <div class="field">
                            <label for="password">Parola</label>
                            <div class="input-wrap">
                                <input class="input password-input" id="password" name="password" type="password" autocomplete="current-password" required />
                                <button class="show-pass" id="togglePassword" type="button">Göster</button>
                            </div>
                        </div>
                        <button class="btn btn-primary" type="submit">
                            <span aria-hidden="true">↗</span>
                            NAS'a Güvenli Bağlan
                        </button>
                    </form>

                    <div class="security-note">
                        <span aria-hidden="true">🔒</span>
                        <span><strong>Güvenlik:</strong> Kullanıcı adı ve parola veri tabanına yazılmaz. Oturum bilgisi yalnızca bu tarayıcı oturumu için sunucuda şifreli tutulur. Mümkünse yalnız WebDAV yetkili ayrı bir NAS hesabı kullan.</span>
                    </div>
                </div>

                <aside class="login-side">
                    <div class="qr-box">
                        <img src="/nsx-assets/nass-access-qr.png" alt="NSX NAS giriş sayfası QR kodu" />
                    </div>
                    <h2>Her cihazdan hızlı erişim</h2>
                    <p>QR kodu telefonundan okut veya herhangi bir bilgisayarda kısa adresi aç.</p>
                    <div class="short-url">www.nsxyazilim.com/nas</div>
                </aside>
            </section>
        }
        else
        {
            <section class="card manager" aria-labelledby="managerTitle">
                <div class="manager-head">
                    <div class="manager-topline">
                        <div class="manager-title">
                            <div class="drive-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6.8A2.8 2.8 0 0 1 6.8 4h10.4A2.8 2.8 0 0 1 20 6.8v10.4a2.8 2.8 0 0 1-2.8 2.8H6.8A2.8 2.8 0 0 1 4 17.2V6.8Z"/><path d="M7 15.5h10M7.5 8.5h.01M11 8.5h.01"/></svg>
                            </div>
                            <div>
                                <h1 id="managerTitle">NAS Dosya Yöneticisi</h1>
                                <p><span class="user-label">@Model.UserName · </span>nsxnas.keenetic.pro</p>
                            </div>
                        </div>
                        <div class="head-actions">
                            <form class="logout-form" method="post" action="/nas/logout">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-light btn-sm" type="submit">Oturumu Kapat</button>
                            </form>
                        </div>
                    </div>

                    <div class="toolbar">
                        <div class="search">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
                            <input id="fileSearch" type="search" placeholder="Bu klasörde ara..." autocomplete="off" />
                        </div>
                        <button class="btn btn-primary btn-sm" type="button" id="uploadButton">↑ Dosya Yükle</button>
                        <button class="btn btn-light btn-sm" type="button" id="newFolderButton">＋ Yeni Klasör</button>
                        <button class="btn btn-light btn-sm" type="button" id="refreshButton">↻ Yenile</button>
                    </div>

                    <nav class="breadcrumbs" aria-label="Klasör yolu">
                        <a href="/nas" aria-label="NAS anasayfasına git">
                            <svg class="crumb-home-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M3.5 10.5 12 3.8l8.5 6.7"/><path d="M5.5 9.6V20h13V9.6"/><path d="M9.5 20v-6h5v6"/></svg>
                            <span>Anasayfa</span>
                        </a>
                        @{
                            var crumbPath = string.Empty;
                        }
                        @foreach (var segment in pathSegments)
                        {
                            crumbPath = string.IsNullOrEmpty(crumbPath) ? segment : $"{crumbPath}/{segment}";
                            <span class="crumb-sep" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"><path d="m9 6 6 6-6 6"/></svg>
                            </span>
                            <a href="@Url.Action("Index", "Nas", new { path = crumbPath })">@segment</a>
                        }
                    </nav>
                </div>

                <div class="manager-body">
                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert" role="alert" style="margin:0 0 15px">
                            <span aria-hidden="true">⚠</span>
                            <span>@Model.ErrorMessage</span>
                        </div>
                    }

                    <form id="csrfToken" hidden>@Html.AntiForgeryToken()</form>
                    <input id="fileInput" type="file" multiple />

                    <div class="dropzone" id="dropzone">
                        <div class="drop-copy">
                            <strong>Dosyaları buraya sürükleyip bırak</strong><br />
                            <span>Aynı isimde dosya varsa üzerine yazılır.</span>
                        </div>
                        <button class="btn btn-light btn-sm" type="button" id="chooseFiles">Dosya Seç</button>
                    </div>

                    <div class="selection-toolbar" id="selectionToolbar" aria-label="Toplu dosya işlemleri">
                        <div class="selection-summary"><span id="selectedCount">0 seçili</span></div>
                        <div class="selection-actions">
                            <button class="btn btn-light btn-sm" type="button" id="selectAllButton">✓ Tümünü Seç</button>
                            <button class="btn btn-light btn-sm" type="button" id="clearSelectionButton" disabled>× Seçimi Temizle</button>
                            <button class="btn btn-copy btn-sm" type="button" id="copySelectionButton" disabled>⧉ Seçilenleri Kopyala</button>
                            <button class="btn btn-paste btn-sm" type="button" id="pasteSelectionButton" hidden>↳ Buraya Yapıştır</button>
                            <button class="btn btn-danger btn-sm" type="button" id="deleteSelectionButton" disabled>Sil</button>
                        </div>
                    </div>

                    <div class="table-wrap">
                        @if (Model.Items.Count == 0)
                        {
                            <div class="empty" id="emptyState">
                                <div>
                                    <div class="empty-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3.5 7.5A2.5 2.5 0 0 1 6 5h4l2 2h6a2.5 2.5 0 0 1 2.5 2.5v7A2.5 2.5 0 0 1 18 19H6a2.5 2.5 0 0 1-2.5-2.5v-9Z"/></svg>
                                    </div>
                                    <h3>Bu klasör boş</h3>
                                    <p>Dosya yükleyebilir veya yeni bir klasör oluşturabilirsin.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <table class="file-table" aria-label="NAS dosyaları">
                                <thead>
                                    <tr>
                                        <th class="col-select"><input class="select-check" id="selectAllCheckbox" type="checkbox" aria-label="Görünen tüm öğeleri seç" /></th>
                                        <th class="col-name">Ad</th>
                                        <th class="col-size">Boyut</th>
                                        <th class="col-date">Değiştirilme</th>
                                        <th class="col-actions">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody id="fileRows">
                                @foreach (var item in Model.Items)
                                {
                                    var fileExtension = item.IsDirectory
                                        ? string.Empty
                                        : (System.IO.Path.GetExtension(item.Name) ?? string.Empty);
                                    var extension = item.IsDirectory
                                        ? "Klasör"
                                        : (string.IsNullOrWhiteSpace(fileExtension) ? "Dosya" : fileExtension.TrimStart('.').ToUpperInvariant());
                                    <tr class="file-row" data-name="@item.Name" data-path="@item.Path" data-directory="@item.IsDirectory.ToString().ToLowerInvariant()">
                                        <td class="select-cell">
                                            <input class="select-check row-select" type="checkbox" aria-label="@item.Name seç" />
                                        </td>
                                        <td class="name-cell">
                                            <div class="entry">
                                                <div class="entry-icon @(item.IsDirectory ? "folder" : string.Empty)" aria-hidden="true">
                                                    @if (item.IsDirectory)
                                                    {
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3.5 7.5A2.5 2.5 0 0 1 6 5h4l2 2h6a2.5 2.5 0 0 1 2.5 2.5v7A2.5 2.5 0 0 1 18 19H6a2.5 2.5 0 0 1-2.5-2.5v-9Z"/></svg>
                                                    }
                                                    else
                                                    {
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3.5h7l5 5v12H6v-17Z"/><path d="M13 3.5v5h5"/></svg>
                                                    }
                                                </div>
                                                <div style="min-width:0">
                                                    @if (item.IsDirectory)
                                                    {
                                                        <a class="entry-name" href="@Url.Action("Index", "Nas", new { path = item.Path })">@item.Name</a>
                                                    }
                                                    else
                                                    {
                                                        <a class="entry-name" href="@Url.Action("Download", "Nas", new { path = item.Path })">@item.Name</a>
                                                    }
                                                    <div class="entry-sub">@extension</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="size-cell">
                                            @if (item.IsDirectory)
                                            {
                                                <span class="js-folder-size folder-size-loading" data-path="@item.Path" title="Alt klasörler dahil toplam boyut hesaplanıyor">Hesaplanıyor</span>
                                            }
                                            else
                                            {
                                                @item.SizeText
                                            }
                                        </td>
                                        <td class="date-cell js-date" data-date="@(item.LastModified?.UtcDateTime.ToString("O") ?? string.Empty)">—</td>
                                        <td class="actions-cell">
                                            <div class="row-actions">
                                                @if (!item.IsDirectory)
                                                {
                                                    <a class="icon-btn" href="@Url.Action("Download", "Nas", new { path = item.Path })" title="İndir" aria-label="@item.Name dosyasını indir">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v12m0 0 4-4m-4 4-4-4"/><path d="M5 20h14"/></svg>
                                                    </a>
                                                }
                                                <button class="icon-btn rename-action" type="button" title="Yeniden adlandır" aria-label="@item.Name adını değiştir" data-path="@item.Path" data-name="@item.Name" data-directory="@item.IsDirectory.ToString().ToLowerInvariant()">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 16.5-.5 4 4-.5L19 8.5 15.5 5 4 16.5Z"/><path d="m13.5 7 3.5 3.5"/></svg>
                                                </button>
                                                <button class="icon-btn delete delete-action" type="button" title="Sil" aria-label="@item.Name sil" data-path="@item.Path" data-name="@item.Name" data-directory="@item.IsDirectory.ToString().ToLowerInvariant()">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M9 7V4h6v3m-8 0 1 13h8l1-13"/><path d="M10 11v5m4-5v5"/></svg>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }
                    </div>

                    <div class="manager-foot">
                        <span>@Model.Items.Count öğe · @Model.Items.Count(x => x.IsDirectory) klasör · @Model.Items.Count(x => !x.IsDirectory) dosya</span>
                        <span>WebDAV üzerinden güvenli HTTPS bağlantısı</span>
                    </div>
                </div>
            </section>
        }

        <footer class="footer">
            <span>NSX Yazılım · Kişisel Bulut</span>
            <span>Kimlik bilgileri veri tabanına kaydedilmez</span>
        </footer>
    </main>

    @if (Model.IsAuthenticated)
    {
        <dialog class="modal" id="actionModal">
            <div class="modal-body">
                <h3 id="modalTitle">İşlem</h3>
                <p id="modalText"></p>
                <div class="modal-input" id="modalInputWrap">
                    <input class="input" id="modalInput" maxlength="180" autocomplete="off" />
                </div>
                <div class="modal-actions">
                    <button class="btn btn-light btn-sm" type="button" id="modalCancel">Vazgeç</button>
                    <button class="btn btn-primary btn-sm" type="button" id="modalConfirm">Tamam</button>
                </div>
            </div>
        </dialog>

        <div class="upload-progress" id="uploadProgress" aria-live="polite" aria-hidden="true">
            <div class="upload-progress-card" role="status" aria-label="Dosya yükleme durumu">
                <div class="progress-orbit" aria-hidden="true">
                    <svg class="progress-ring-svg" viewBox="0 0 128 128">
                        <defs>
                            <linearGradient id="nassProgressGradient" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0%" stop-color="#ff9a52" />
                                <stop offset="52%" stop-color="#f56800" />
                                <stop offset="100%" stop-color="#d94f00" />
                            </linearGradient>
                        </defs>
                        <circle class="progress-ring-bg" cx="64" cy="64" r="54" pathLength="100"></circle>
                        <circle class="progress-ring-value" id="uploadRing" cx="64" cy="64" r="54" pathLength="100"></circle>
                    </svg>
                    <div class="progress-spinner"></div>
                    <div class="progress-number" id="uploadPercent">0%</div>
                </div>
                <div class="progress-label" id="uploadLabel">Dosya yükleniyor...</div>
                <div class="progress-subtext" id="uploadSubtext">NAS'a güvenli şekilde aktarılıyor</div>
                <div class="progress-bytes" id="uploadBytes">0 B / 0 B</div>
                <div class="progress-pulse" aria-hidden="true"></div>
            </div>
        </div>
    }

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
        (() => {
            const togglePassword = document.getElementById('togglePassword');
            const password = document.getElementById('password');
            togglePassword?.addEventListener('click', () => {
                const show = password.type === 'password';
                password.type = show ? 'text' : 'password';
                togglePassword.textContent = show ? 'Gizle' : 'Göster';
            });

            document.querySelectorAll('.js-date').forEach(el => {
                const raw = el.dataset.date;
                if (!raw) return;
                const date = new Date(raw);
                if (Number.isNaN(date.getTime())) return;
                el.textContent = new Intl.DateTimeFormat('tr-TR', {
                    day: '2-digit', month: '2-digit', year: 'numeric',
                    hour: '2-digit', minute: '2-digit'
                }).format(date);
            });

            const search = document.getElementById('fileSearch');
            search?.addEventListener('input', () => {
                const q = search.value.trim().toLocaleLowerCase('tr-TR');
                document.querySelectorAll('.file-row').forEach(row => {
                    const name = (row.dataset.name || '').toLocaleLowerCase('tr-TR');
                    row.style.display = !q || name.includes(q) ? '' : 'none';
                });
                if (typeof updateSelectionUi === 'function') updateSelectionUi();
            });

            const csrf = document.querySelector('#csrfToken input[name="__RequestVerificationToken"]')?.value || '';
            const currentPath = document.body.dataset.currentPath || '';
            const toast = document.getElementById('toast');
            let toastTimer;

            const showToast = (message, error = false) => {
                if (!toast) return;
                clearTimeout(toastTimer);
                toast.textContent = message;
                toast.classList.toggle('error', error);
                toast.classList.add('show');
                toastTimer = setTimeout(() => toast.classList.remove('show'), error ? 3600 : 2200);
            };

            const post = async (url, values) => {
                const form = new FormData();
                form.append('__RequestVerificationToken', csrf);
                Object.entries(values || {}).forEach(([key, value]) => form.append(key, String(value ?? '')));
                const response = await fetch(url, {
                    method: 'POST',
                    body: form,
                    credentials: 'same-origin',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (response.status === 401) {
                    window.location.href = '/nas';
                    return null;
                }

                let payload = null;
                try { payload = await response.json(); } catch { }
                if (!response.ok || !payload?.ok)
                    throw new Error(payload?.message || 'İşlem tamamlanamadı.');
                return payload;
            };

            const loadFolderSizes = async () => {
                const targets = Array.from(document.querySelectorAll('.js-folder-size'));
                if (!targets.length) return;

                const paths = targets
                    .map(el => el.dataset.path || '')
                    .filter(Boolean);
                if (!paths.length) return;

                try {
                    const result = await post('/nas/folder-sizes', { pathsJson: JSON.stringify(paths) });
                    if (!result?.sizes) return;

                    const byPath = new Map(result.sizes.map(item => [item.path, item]));
                    targets.forEach(el => {
                        const item = byPath.get(el.dataset.path || '');
                        el.classList.remove('folder-size-loading');
                        if (item?.ok) {
                            el.textContent = item.sizeText || '0 B';
                            el.classList.add('folder-size-ready');
                            el.title = 'Alt klasörler dahil toplam boyut';
                        } else {
                            el.textContent = '—';
                            el.classList.add('folder-size-error');
                            el.title = 'Klasör boyutu hesaplanamadı';
                        }
                    });
                } catch (error) {
                    targets.forEach(el => {
                        el.classList.remove('folder-size-loading');
                        el.classList.add('folder-size-error');
                        el.textContent = '—';
                        el.title = 'Klasör boyutu hesaplanamadı';
                    });
                }
            };

            void loadFolderSizes();

            const modal = document.getElementById('actionModal');
            const modalTitle = document.getElementById('modalTitle');
            const modalText = document.getElementById('modalText');
            const modalInputWrap = document.getElementById('modalInputWrap');
            const modalInput = document.getElementById('modalInput');
            const modalConfirm = document.getElementById('modalConfirm');
            const modalCancel = document.getElementById('modalCancel');
            let modalAction = null;

            const openModal = ({ title, text, value = '', input = true, danger = false, action }) => {
                if (!modal) return;
                modalTitle.textContent = title;
                modalText.textContent = text || '';
                modalInputWrap.style.display = input ? '' : 'none';
                modalInput.value = value;
                modalConfirm.textContent = danger ? 'Sil' : 'Tamam';
                modalConfirm.className = `btn ${danger ? 'btn-danger' : 'btn-primary'} btn-sm`;
                modalAction = action;
                modal.showModal();
                if (input) setTimeout(() => { modalInput.focus(); modalInput.select(); }, 40);
            };

            const closeModal = () => {
                modal?.close();
                modalAction = null;
            };

            modalCancel?.addEventListener('click', closeModal);
            modal?.addEventListener('cancel', event => { event.preventDefault(); closeModal(); });
            modalConfirm?.addEventListener('click', async () => {
                if (!modalAction) return;
                modalConfirm.disabled = true;
                try {
                    await modalAction(modalInput.value);
                    closeModal();
                } catch (error) {
                    showToast(error.message || 'İşlem tamamlanamadı.', true);
                } finally {
                    modalConfirm.disabled = false;
                }
            });
            modalInput?.addEventListener('keydown', event => {
                if (event.key === 'Enter') modalConfirm?.click();
            });

            document.getElementById('newFolderButton')?.addEventListener('click', () => {
                openModal({
                    title: 'Yeni klasör',
                    text: 'Klasör adını yaz.',
                    action: async value => {
                        const result = await post('/nas/create-folder', { currentPath, name: value });
                        if (result) { showToast(result.message); window.location.reload(); }
                    }
                });
            });

            document.querySelectorAll('.rename-action').forEach(button => {
                button.addEventListener('click', () => {
                    openModal({
                        title: 'Yeniden adlandır',
                        text: 'Yeni adı yaz.',
                        value: button.dataset.name || '',
                        action: async value => {
                            const result = await post('/nas/rename', {
                                path: button.dataset.path || '',
                                newName: value,
                                isDirectory: button.dataset.directory || 'false'
                            });
                            if (result) { showToast(result.message); window.location.reload(); }
                        }
                    });
                });
            });

            document.querySelectorAll('.delete-action').forEach(button => {
                button.addEventListener('click', () => {
                    const isDirectory = button.dataset.directory === 'true';
                    openModal({
                        title: isDirectory ? 'Klasörü sil' : 'Dosyayı sil',
                        text: `“${button.dataset.name || ''}” kalıcı olarak silinecek. Bu işlem geri alınamaz.`,
                        input: false,
                        danger: true,
                        action: async () => {
                            const result = await post('/nas/delete', {
                                path: button.dataset.path || '',
                                isDirectory: button.dataset.directory || 'false'
                            });
                            if (result) { showToast(result.message); window.location.reload(); }
                        }
                    });
                });
            });

            const selectionToolbar = document.getElementById('selectionToolbar');
            const selectedCount = document.getElementById('selectedCount');
            const selectAllButton = document.getElementById('selectAllButton');
            const clearSelectionButton = document.getElementById('clearSelectionButton');
            const copySelectionButton = document.getElementById('copySelectionButton');
            const pasteSelectionButton = document.getElementById('pasteSelectionButton');
            const deleteSelectionButton = document.getElementById('deleteSelectionButton');
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            const clipboardKey = 'nsx-nass-copy-clipboard-v1';

            const allRows = () => Array.from(document.querySelectorAll('.file-row'));
            const visibleRows = () => allRows().filter(row => row.style.display !== 'none');
            const selectedRows = () => allRows().filter(row => row.querySelector('.row-select')?.checked);
            const toBatchItem = row => ({
                Path: row.dataset.path || '',
                IsDirectory: row.dataset.directory === 'true',
                Name: row.dataset.name || ''
            });

            const getClipboard = () => {
                try {
                    const parsed = JSON.parse(sessionStorage.getItem(clipboardKey) || 'null');
                    if (!parsed || !Array.isArray(parsed.items) || !parsed.items.length) return null;
                    return parsed;
                } catch {
                    return null;
                }
            };

            const updateSelectionUi = () => {
                const selected = selectedRows();
                const visible = visibleRows();
                const visibleSelected = visible.filter(row => row.querySelector('.row-select')?.checked).length;
                const clipboard = getClipboard();

                if (selectedCount) selectedCount.textContent = `${selected.length} seçili`;
                selectionToolbar?.classList.toggle('has-selection', selected.length > 0);
                if (clearSelectionButton) clearSelectionButton.disabled = selected.length === 0;
                if (copySelectionButton) copySelectionButton.disabled = selected.length === 0;
                if (deleteSelectionButton) deleteSelectionButton.disabled = selected.length === 0;
                if (selectAllButton) selectAllButton.disabled = visible.length === 0;

                if (selectAllCheckbox) {
                    selectAllCheckbox.disabled = visible.length === 0;
                    selectAllCheckbox.checked = visible.length > 0 && visibleSelected === visible.length;
                    selectAllCheckbox.indeterminate = visibleSelected > 0 && visibleSelected < visible.length;
                }

                if (pasteSelectionButton) {
                    pasteSelectionButton.hidden = !clipboard;
                    pasteSelectionButton.textContent = clipboard ? `↳ Buraya Yapıştır (${clipboard.items.length})` : '↳ Buraya Yapıştır';
                }

                allRows().forEach(row => row.classList.toggle('is-selected', !!row.querySelector('.row-select')?.checked));
            };

            document.querySelectorAll('.row-select').forEach(check => check.addEventListener('change', updateSelectionUi));

            const setVisibleSelection = checked => {
                visibleRows().forEach(row => {
                    const check = row.querySelector('.row-select');
                    if (check) check.checked = checked;
                });
                updateSelectionUi();
            };

            selectAllButton?.addEventListener('click', () => setVisibleSelection(true));
            selectAllCheckbox?.addEventListener('change', () => setVisibleSelection(selectAllCheckbox.checked));
            clearSelectionButton?.addEventListener('click', () => {
                allRows().forEach(row => {
                    const check = row.querySelector('.row-select');
                    if (check) check.checked = false;
                });
                updateSelectionUi();
            });

            copySelectionButton?.addEventListener('click', () => {
                const items = selectedRows().map(toBatchItem);
                if (!items.length) return;
                sessionStorage.setItem(clipboardKey, JSON.stringify({ items, copiedAt: Date.now() }));
                showToast(`${items.length} öğe kopyalama için hazır. Hedef klasöre gidip “Buraya Yapıştır”ı kullan.`);
                updateSelectionUi();
            });

            pasteSelectionButton?.addEventListener('click', () => {
                const clipboard = getClipboard();
                if (!clipboard) {
                    updateSelectionUi();
                    return;
                }

                openModal({
                    title: 'Seçilenleri buraya kopyala',
                    text: `${clipboard.items.length} öğe bu klasöre kopyalanacak. Aynı isimde öğe varsa işlem durdurulur.`,
                    input: false,
                    action: async () => {
                        const result = await post('/nas/copy-batch', {
                            destinationPath: currentPath,
                            itemsJson: JSON.stringify(clipboard.items)
                        });
                        if (result) {
                            sessionStorage.removeItem(clipboardKey);
                            showToast(result.message);
                            window.location.reload();
                        }
                    }
                });
            });

            deleteSelectionButton?.addEventListener('click', () => {
                const items = selectedRows().map(toBatchItem);
                if (!items.length) return;

                openModal({
                    title: 'Seçilenleri sil',
                    text: `${items.length} seçili öğe kalıcı olarak silinecek. Bu işlem geri alınamaz.`,
                    input: false,
                    danger: true,
                    action: async () => {
                        const result = await post('/nas/delete-batch', { itemsJson: JSON.stringify(items) });
                        if (result) {
                            showToast(result.message);
                            window.location.reload();
                        }
                    }
                });
            });

            updateSelectionUi();

            document.getElementById('refreshButton')?.addEventListener('click', () => window.location.reload());

            const fileInput = document.getElementById('fileInput');
            const dropzone = document.getElementById('dropzone');
            document.getElementById('uploadButton')?.addEventListener('click', () => fileInput?.click());
            document.getElementById('chooseFiles')?.addEventListener('click', () => fileInput?.click());

            const uploadProgress = document.getElementById('uploadProgress');
            const uploadRing = document.getElementById('uploadRing');
            const uploadPercent = document.getElementById('uploadPercent');
            const uploadLabel = document.getElementById('uploadLabel');
            const uploadSubtext = document.getElementById('uploadSubtext');
            const uploadBytes = document.getElementById('uploadBytes');
            let uploadProgressTimer = null;
            let activeUploadId = null;

            const formatBytes = bytes => {
                const value = Math.max(0, Number(bytes) || 0);
                if (value < 1024) return `${Math.round(value)} B`;
                const units = ['KB', 'MB', 'GB', 'TB'];
                let amount = value / 1024;
                let unit = 0;
                while (amount >= 1024 && unit < units.length - 1) {
                    amount /= 1024;
                    unit++;
                }
                return `${amount >= 100 ? amount.toFixed(0) : amount >= 10 ? amount.toFixed(1) : amount.toFixed(2)} ${units[unit]}`;
            };

            const setUploadProgress = value => {
                const percent = Math.max(0, Math.min(100, Math.round(Number(value) || 0)));
                if (uploadRing) uploadRing.style.strokeDashoffset = String(100 - percent);
                if (uploadPercent) uploadPercent.textContent = `${percent}%`;
            };

            const setUploadBytes = (loaded, total) => {
                if (!uploadBytes) return;
                uploadBytes.textContent = `${formatBytes(loaded)} / ${formatBytes(total)}`;
            };

            const showUploadProgress = () => {
                uploadProgress?.classList.add('show');
                uploadProgress?.setAttribute('aria-hidden', 'false');
                document.body.classList.add('nass-uploading');
            };

            const hideUploadProgress = () => {
                uploadProgress?.classList.remove('show');
                uploadProgress?.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('nass-uploading');
            };

            const stopUploadProgressPolling = () => {
                activeUploadId = null;
                if (uploadProgressTimer) clearTimeout(uploadProgressTimer);
                uploadProgressTimer = null;
            };

            const createUploadId = () => {
                if (window.crypto?.randomUUID) return window.crypto.randomUUID();
                return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, char => {
                    const r = Math.random() * 16 | 0;
                    const v = char === 'x' ? r : (r & 0x3 | 0x8);
                    return v.toString(16);
                });
            };

            const pollNasUploadProgress = async (uploadId, totalBytes) => {
                if (activeUploadId !== uploadId) return;
                try {
                    const response = await fetch(`/nas/upload-progress?id=${encodeURIComponent(uploadId)}`, {
                        credentials: 'same-origin',
                        cache: 'no-store',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (response.status === 401) {
                        window.location.href = '/nas';
                        return;
                    }

                    if (response.ok) {
                        const payload = await response.json();
                        if (payload?.found) {
                            const serverTotal = Math.max(0, Number(payload.totalBytes) || totalBytes || 0);
                            const transferred = Math.max(0, Math.min(serverTotal, Number(payload.transferredBytes) || 0));
                            const ratio = serverTotal > 0 ? transferred / serverTotal : 1;

                            // Yüzde her aşamada doğrudan dosya boyutuna göre hesaplanır.
                            // Örn. 58.8 MB / 295 MB = yaklaşık %20. Yapay 50/50 ağırlıklandırma yoktur.
                            setUploadProgress(ratio * 100);
                            if (uploadSubtext) uploadSubtext.textContent = 'Aşama 2/2 · NAS diske yazılıyor';
                            if (uploadLabel && payload.currentFile) uploadLabel.textContent = payload.currentFile;
                            setUploadBytes(transferred, serverTotal);

                            if (payload.stage === 'failed' && payload.error) {
                                if (uploadSubtext) uploadSubtext.textContent = payload.error;
                            }
                        }
                    }
                } catch {
                    // Ana yükleme isteği devam ettiği sürece kısa ağ/poll hatalarını sessizce tekrar dene.
                }

                if (activeUploadId === uploadId)
                    uploadProgressTimer = setTimeout(() => pollNasUploadProgress(uploadId, totalBytes), 250);
            };

            const uploadFiles = files => {
                const list = Array.from(files || []);
                if (!list.length) return;

                const totalBytes = list.reduce((sum, file) => sum + Math.max(0, Number(file.size) || 0), 0);
                const uploadId = createUploadId();
                activeUploadId = uploadId;

                const form = new FormData();
                form.append('__RequestVerificationToken', csrf);
                form.append('currentPath', currentPath);
                form.append('uploadId', uploadId);
                list.forEach(file => form.append('files', file, file.name));

                const xhr = new XMLHttpRequest();
                xhr.open('POST', '/nas/upload', true);
                xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
                showUploadProgress();
                if (uploadLabel) uploadLabel.textContent = list.length === 1 ? list[0].name : `${list.length} dosya hazırlanıyor...`;
                if (uploadSubtext) uploadSubtext.textContent = 'Aşama 1/2 · Web sunucusuna aktarılıyor';
                setUploadProgress(0);
                setUploadBytes(0, totalBytes);
                pollNasUploadProgress(uploadId, totalBytes);

                xhr.upload.onprogress = event => {
                    if (!event.lengthComputable) return;
                    const ratio = Math.max(0, Math.min(1, event.loaded / event.total));
                    setUploadProgress(ratio * 100);
                    setUploadBytes(totalBytes * ratio, totalBytes);
                    if (uploadSubtext) {
                        uploadSubtext.textContent = ratio >= 1
                            ? 'Aşama 1/2 tamamlandı · NAS aktarımı başlatılıyor...'
                            : 'Aşama 1/2 · Web sunucusuna aktarılıyor';
                    }
                };

                xhr.onload = () => {
                    stopUploadProgressPolling();
                    if (xhr.status === 401) {
                        window.location.href = '/nas';
                        return;
                    }
                    let payload = null;
                    try { payload = JSON.parse(xhr.responseText); } catch { }
                    if (xhr.status >= 200 && xhr.status < 300 && payload?.ok) {
                        setUploadProgress(100);
                        setUploadBytes(totalBytes, totalBytes);
                        if (uploadLabel) uploadLabel.textContent = 'Yükleme tamamlandı';
                        if (uploadSubtext) uploadSubtext.textContent = 'Dosya NAS üzerine tamamen yazıldı';
                        showToast(payload.message || 'Dosya yüklendi.');
                        setTimeout(() => window.location.reload(), 750);
                    } else {
                        hideUploadProgress();
                        showToast(payload?.message || 'Dosya yüklenemedi.', true);
                    }
                };

                xhr.onerror = () => {
                    stopUploadProgressPolling();
                    hideUploadProgress();
                    showToast('Yükleme sırasında bağlantı kesildi.', true);
                };
                xhr.onabort = () => {
                    stopUploadProgressPolling();
                    hideUploadProgress();
                    showToast('Yükleme iptal edildi.', true);
                };
                xhr.send(form);
            };

            fileInput?.addEventListener('change', () => {
                uploadFiles(fileInput.files);
                fileInput.value = '';
            });

            ['dragenter', 'dragover'].forEach(type => dropzone?.addEventListener(type, event => {
                event.preventDefault();
                dropzone.classList.add('is-dragging');
            }));
            ['dragleave', 'drop'].forEach(type => dropzone?.addEventListener(type, event => {
                event.preventDefault();
                dropzone.classList.remove('is-dragging');
            }));
            dropzone?.addEventListener('drop', event => uploadFiles(event.dataTransfer?.files));
        })();
    </script>
</body>
</html>

@model NSYazilim.Web.ViewModels.CustomerDownloadsViewModel
@{ ViewData["Title"] = "İndirmelerim"; ViewData["Robots"] = "noindex, nofollow"; ViewData["SkipActiveCampaign"] = true; }
<section class="nsx-account-page"><div class="container nsx-account-hero"><div><span>DİJİTAL TESLİMAT</span><h1>İndirmelerim <em>hazır ve güvende.</em></h1><p>Demo ürünleri ve aktif lisanslarınıza ait program dosyalarını güvenle indirin.</p><div class="nsx-account-hero-points"><span><b>✓</b> Tam sürüm</span><span><b>✓</b> Demo erişimi</span><span><b>✓</b> Güvenli indirme</span></div></div><div class="nsx-account-hero-count"><strong>@(Model.Items.Count + Model.DemoItems.Count)</strong><span>erişilebilir ürün</span></div></div><div class="nsx-info-divider"></div>
<div class="container nsx-account-layout">@await Html.PartialAsync("_AccountNav")<main class="nsx-account-main">
@if(TempData["Error"] is string error){<div class="nsx-form-message is-error">@error</div>}
@if(!Model.Items.Any()&&!Model.DemoItems.Any()){<section class="nsx-account-panel"><div class="nsx-account-empty"><b>Henüz indirme kaydınız yok.</b><p>Demo indirdiğinizde veya lisanslı ürün satın aldığınızda dosyalar burada görünür.</p><a href="/store">Yazılımları İncele</a></div></section>}
else{
@if(Model.Items.Any()){<section class="nsx-account-panel"><div class="nsx-account-panel-head"><div><span>TAM SÜRÜM</span><h2>Satın aldığım programlar</h2></div></div><div class="nsx-download-cards">@foreach(var item in Model.Items){<article><div class="nsx-download-icon">NSX</div><div><small>@(item.LicenseType=="Lifetime"?"SINIRSIZ LİSANS":"YILLIK LİSANS")</small><h3>@item.ProductName</h3><span class="@(item.LicenseActive?"ok":"bad")">@(item.LicenseActive?"Aktif lisans":"Pasif lisans")</span></div>@if(!item.Files.Any()){<p>Bu ürün için program dosyası henüz yüklenmemiş.</p>}else{<div class="nsx-download-files">@foreach(var file in item.Files){<a href="/Account/DownloadFile?productId=@item.ProductId&fileId=@file.Id"><span>@(string.IsNullOrWhiteSpace(file.OriginalFileName)?"Program dosyası":file.OriginalFileName)</span><b>İndir ↓</b></a>}</div>}</article>}</div></section>}
@if(Model.DemoItems.Any()){<section class="nsx-account-panel"><div class="nsx-account-panel-head"><div><span>DEMO ÜRÜNLER</span><h2>Daha önce indirdiklerim</h2></div></div><div class="nsx-download-cards">@foreach(var item in Model.DemoItems){<article><div class="nsx-download-icon demo">DEMO</div><div><small>SON İNDİRME @item.LastDownloadedAt.ToString("dd.MM.yyyy")</small><h3>@item.ProductName</h3><span>@item.DownloadCount kez indirildi</span></div>@if(!item.Files.Any()){<p>Demo dosyası henüz yüklenmemiş.</p>}else{<div class="nsx-download-files"><a href="/store/downloaddemo?productId=@item.ProductId"><span>Demo kurulum dosyası</span><b>Tekrar İndir ↓</b></a></div>}</article>}</div></section>}
}
</main></div></section>

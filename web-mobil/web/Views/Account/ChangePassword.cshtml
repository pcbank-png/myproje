@model NSYazilim.Web.ViewModels.ChangePasswordViewModel
@{ ViewData["Title"] = "Şifre ve Güvenlik"; ViewData["Robots"] = "noindex, nofollow"; ViewData["SkipActiveCampaign"] = true; }
<section class="nsx-account-page"><div class="container nsx-account-hero"><div><span>HESAP GÜVENLİĞİ</span><h1>Şifre ve Güvenlik <em>kontrolünüzde.</em></h1><p>Hesabınızı güçlü ve size özel bir şifreyle koruyun.</p><div class="nsx-account-hero-points"><span><b>✓</b> Güçlü parola</span><span><b>✓</b> Güvenli hesap</span><span><b>✓</b> Hızlı güncelleme</span></div></div><div class="nsx-account-hero-count"><strong>•••</strong><span>güvenli parola</span></div></div><div class="nsx-info-divider"></div>
<div class="container nsx-account-layout">@await Html.PartialAsync("_AccountNav")<main class="nsx-account-main"><section class="nsx-account-panel nsx-password-panel"><div class="nsx-account-panel-head"><div><span>PAROLA YÖNETİMİ</span><h2>Şifrenizi değiştirin</h2></div></div>
@if(TempData["Success"] is string success){<div class="nsx-form-message is-success">@success</div>}
<form class="nsx-auth-form" method="post" action="/Account/ChangePassword" autocomplete="off">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="nsx-validation"></div>
<label for="CurrentPassword">Mevcut şifre</label><div class="nsx-password-field"><input asp-for="CurrentPassword" type="password" placeholder="Mevcut şifreniz" autocomplete="current-password"/><button type="button" data-password-toggle>Göster</button></div><span asp-validation-for="CurrentPassword" class="nsx-field-error"></span>
<label for="NewPassword">Yeni şifre</label><div class="nsx-password-field"><input asp-for="NewPassword" type="password" placeholder="En az 6 karakter" autocomplete="new-password"/><button type="button" data-password-toggle>Göster</button></div><span asp-validation-for="NewPassword" class="nsx-field-error"></span>
<label for="ConfirmPassword">Yeni şifre tekrarı</label><div class="nsx-password-field"><input asp-for="ConfirmPassword" type="password" placeholder="Yeni şifrenizi tekrar yazın" autocomplete="new-password"/><button type="button" data-password-toggle>Göster</button></div><span asp-validation-for="ConfirmPassword" class="nsx-field-error"></span>
<button class="nsx-auth-submit" type="submit">Şifreyi Güncelle <span>→</span></button></form>
<div class="nsx-security-note"><strong>Güvenli şifre önerisi</strong><p>Başka sitelerde kullanmadığınız; harf, rakam ve özel karakter içeren bir şifre seçin.</p></div>
</section></main></div></section>
@section Scripts { <script src="~/lib/jquery/dist/jquery.min.js"></script><partial name="_ValidationScriptsPartial" /><script src="/js/account-ui.js" asp-append-version="true"></script> }

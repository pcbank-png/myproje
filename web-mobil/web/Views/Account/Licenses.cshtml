@model List<NSYazilim.Web.Models.License>
@{ ViewData["Title"] = "Lisanslarım"; ViewData["Robots"] = "noindex, nofollow"; ViewData["SkipActiveCampaign"] = true; }
<section class="nsx-account-page"><div class="container nsx-account-hero"><div><span>ÜRÜN ERİŞİMİ</span><h1>Lisanslarım <em>tek merkezde.</em></h1><p>Aktif, süresi dolan ve sınırsız lisans bilgilerinizi güvenli biçimde yönetin.</p><div class="nsx-account-hero-points"><span><b>✓</b> Lisans anahtarı</span><span><b>✓</b> Cihaz durumu</span><span><b>✓</b> Offline kullanım</span></div></div><div class="nsx-account-hero-count"><strong>@Model.Count</strong><span>toplam lisans</span></div></div><div class="nsx-info-divider"></div>
<div class="container nsx-account-layout">@await Html.PartialAsync("_AccountNav")<main class="nsx-account-main">
@if(TempData["Success"] is string success){<div class="nsx-form-message is-success">@success</div>} @if(TempData["Error"] is string error){<div class="nsx-form-message is-error">@error</div>}
<section class="nsx-account-panel"><div class="nsx-account-panel-head"><div><span>LİSANS MERKEZİ</span><h2>Lisans durumu</h2></div><a href="/Account/Downloads">Program dosyaları</a></div>
@if(!Model.Any()){<div class="nsx-account-empty"><b>Henüz lisansınız yok.</b><p>Satın alma tamamlandığında lisansınız otomatik olarak hesabınıza tanımlanır.</p><a href="/store">Yazılımları İncele</a></div>}
else{<div class="nsx-license-cards">@foreach(var license in Model){var active=license.IsActive&&(license.EndDate==null||license.EndDate>=DateTime.Now);<article class="@(active?"is-active":"is-passive")"><div class="nsx-license-card-head"><div><span>@(active?"AKTİF":"PASİF")</span><h2>@(license.Product?.Name??"Ürün")</h2></div><b>@(license.LicenseType=="Lifetime"?"Sınırsız":"Yıllık")</b></div><div class="nsx-license-key"><small>LİSANS ANAHTARI</small><code id="license-@license.Id">@license.LicenseKey</code><button type="button" data-copy-target="license-@license.Id">Kopyala</button></div><dl><div><dt>Başlangıç</dt><dd>@license.StartDate.ToString("dd.MM.yyyy")</dd></div><div><dt>Bitiş</dt><dd>@(license.EndDate==null?"Sınırsız":license.EndDate.Value.ToString("dd.MM.yyyy"))</dd></div><div><dt>Cihaz durumu</dt><dd>@(string.IsNullOrWhiteSpace(license.MachineId)?"Eşleşmedi":"Eşleşti")</dd></div><div><dt>Offline kullanım</dt><dd>@(license.OfflineAllowed?"Açık":"Kapalı")</dd></div></dl><div class="nsx-license-actions"><a href="/Account/Downloads">Programı İndir</a>@if(active&&license.OfflineAllowed&&!string.IsNullOrWhiteSpace(license.MachineId)){<a class="secondary" href="/Account/OfflineLicenseFile/@license.Id">Offline Lisans Dosyası</a>}</div></article>}</div>}
</section><div class="nsx-account-info-strip"><strong>İnternet bağlantısı olmadığında</strong><p>Offline kullanıma izin verilen ürünlerde lisans anahtarı ve kayıtlı e-posta bilgilerinizle yerel lisans modu kullanılabilir.</p></div>
</main></div></section>
@section Scripts { <script src="/js/account-ui.js" asp-append-version="true"></script> }

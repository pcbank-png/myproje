@model NSYazilim.Web.ViewModels.OrderDeliveryViewModel
@{
    ViewData["Title"] = "Sipariş Detayı";
    ViewData["Robots"] = "noindex, nofollow";
    ViewData["SkipActiveCampaign"] = true;
}
<section class="nsx-account-page"><div class="container nsx-account-hero"><div><span>SİPARİŞ DETAYI</span><h1>@Model.Order.OrderNumber <em>sipariş detayı.</em></h1><p>Sipariş içeriği, ödeme durumu ve teslim edilen lisans bilgileri.</p><div class="nsx-account-hero-points"><span><b>✓</b> Sipariş özeti</span><span><b>✓</b> Ödeme durumu</span><span><b>✓</b> Lisans teslimatı</span></div></div><a class="nsx-account-back" href="/Account/Orders">← Siparişlerime Dön</a></div><div class="nsx-info-divider"></div>
<div class="container nsx-account-layout">@await Html.PartialAsync("~/Views/Account/_AccountNav.cshtml")<main class="nsx-account-main"><div class="nsx-order-detail-grid"><div>
<section class="nsx-account-panel"><div class="nsx-account-panel-head"><div><span>SİPARİŞ İÇERİĞİ</span><h2>Ürünler</h2></div></div><div class="nsx-order-items">@foreach(var item in Model.Order.OrderItems){<div><span><strong>@(item.Product?.Name??"Ürün")</strong><small>@(item.LicenseType=="Lifetime"?"Sınırsız Lisans":"Yıllık Lisans") × @item.Quantity</small></span><b>@item.UnitPrice.ToString("N2") ₺</b></div>}<div class="total"><span>Toplam</span><strong>@Model.Order.TotalAmount.ToString("N2") ₺</strong></div></div></section>
<section class="nsx-account-panel"><div class="nsx-account-panel-head"><div><span>DİJİTAL TESLİMAT</span><h2>Lisanslar</h2></div></div>@if(!Model.Licenses.Any()){<div class="nsx-account-empty compact"><b>Lisans henüz oluşturulmamış.</b><p>Ödeme onayından sonra lisansınız burada görünecektir.</p></div>}else{<div class="nsx-license-list">@foreach(var license in Model.Licenses){<article><div><small>@(license.IsActive?"AKTİF":"PASİF")</small><strong>@(license.Product?.Name??"Ürün")</strong></div><code id="detail-license-@license.Id">@license.LicenseKey</code><button type="button" data-copy-target="detail-license-@license.Id">Kopyala</button></article>}</div>}</section>
</div><aside class="nsx-order-summary"><span>SİPARİŞ BİLGİLERİ</span><dl><div><dt>Tarih</dt><dd>@Model.Order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd></div><div><dt>Ödeme</dt><dd>@StatusTextHelper.PaymentStatus(Model.Order.PaymentStatus)</dd></div><div><dt>Durum</dt><dd>@StatusTextHelper.OrderStatus(Model.Order.OrderStatus)</dd></div></dl><a href="/Account/Downloads">İndirmelerime Git</a><a class="secondary" href="/Account/Licenses">Lisanslarımı Gör</a></aside></div></main></div></section>
@section Scripts { <script src="/js/account-ui.js" asp-append-version="true"></script> }

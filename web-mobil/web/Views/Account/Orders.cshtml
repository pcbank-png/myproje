@model List<NSYazilim.Web.Models.Order>
@{ ViewData["Title"] = "Siparişlerim"; ViewData["Robots"] = "noindex, nofollow"; ViewData["SkipActiveCampaign"] = true; }
<section class="nsx-account-page"><div class="container nsx-account-hero"><div><span>ÜYE PANELİ</span><h1>Siparişlerim <em>tek ekranda.</em></h1><p>Satın alma geçmişinizi, sipariş durumlarını ve teslim edilen ürünleri görüntüleyin.</p><div class="nsx-account-hero-points"><span><b>✓</b> Sipariş geçmişi</span><span><b>✓</b> Durum takibi</span><span><b>✓</b> Dijital teslimat</span></div></div><div class="nsx-account-hero-count"><strong>@Model.Count</strong><span>toplam sipariş</span></div></div><div class="nsx-info-divider"></div>
<div class="container nsx-account-layout">@await Html.PartialAsync("_AccountNav")<main class="nsx-account-main"><section class="nsx-account-panel"><div class="nsx-account-panel-head"><div><span>SATIŞ GEÇMİŞİ</span><h2>Tüm siparişler</h2></div><a href="/store">Yeni ürün incele</a></div>
@if(!Model.Any()){<div class="nsx-account-empty"><b>Henüz siparişiniz yok.</b><p>Satın aldığınız ürünler burada listelenecek.</p><a href="/store">Yazılımları İncele</a></div>}
else{<div class="nsx-account-table nsx-account-table-full"><div class="head"><span>Sipariş No</span><span>Ürünler</span><span>Tutar</span><span>Durum</span></div>@foreach(var order in Model){var products=order.OrderItems.Any()?string.Join(", ",order.OrderItems.Select(x=>x.Product?.Name??"Ürün")):"Ürün";<a href="/Account/OrderDetail/@order.Id"><span><b>@order.OrderNumber</b><small>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small></span><span>@products</span><span>@order.TotalAmount.ToString("N2") ₺</span><strong>@StatusTextHelper.OrderStatus(order.OrderStatus)</strong></a>}</div>}
</section></main></div></section>

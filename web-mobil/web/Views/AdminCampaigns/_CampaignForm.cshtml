@model NSYazilim.Web.Models.Campaign

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label">Kampanya Adı</label>
        <input asp-for="Name" class="form-control" placeholder="Örn: 500 TL üzeri %10 indirim" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Code" class="form-label">Kod / Etiket</label>
        <input asp-for="Code" class="form-control" placeholder="Opsiyonel" />
    </div>

    <div class="col-md-4">
        <label asp-for="MinimumCartTotal" class="form-label">Minimum Tutar</label>
        <input asp-for="MinimumCartTotal" class="form-control" type="number" step="0.01" />
    </div>

    <div class="col-md-4">
        <label asp-for="DiscountType" class="form-label">İndirim Tipi</label>
        <select asp-for="DiscountType" class="form-select">
            <option value="Percent">Yüzde (%)</option>
            <option value="Amount">Sabit TL</option>
        </select>
    </div>

    <div class="col-md-4">
        <label asp-for="DiscountValue" class="form-label">İndirim Değeri</label>
        <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" />
    </div>

    <div class="col-md-4">
        <label asp-for="StartDate" class="form-label">Başlangıç</label>
        <input asp-for="StartDate" class="form-control" type="date" />
    </div>

    <div class="col-md-4">
        <label asp-for="EndDate" class="form-label">Bitiş</label>
        <input asp-for="EndDate" class="form-control" type="date" />
    </div>

    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check form-switch mb-2">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Aktif</label>
        </div>
    </div>
</div>

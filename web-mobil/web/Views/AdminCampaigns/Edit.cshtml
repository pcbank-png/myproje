@model NSYazilim.Web.Models.Campaign

@{
    var isEdit = Model != null && Model.Id > 0;
    ViewData["Title"] = isEdit ? "Kampanya Düzenle" : "Yeni Kampanya";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h1 class="h4 fw-bold mb-4">@ViewData["Title"]</h1>

            <form method="post">
                @Html.AntiForgeryToken()
                @if (isEdit)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Kampanya Kodu</label>
                        <input asp-for="Code" class="form-control text-uppercase" placeholder="Örn: NSX30" />
                        <small class="text-muted">Ana sayfada ve sliderda bu kod gösterilir.</small>
                    </div>
                    <div class="col-md-8 mb-3">
                        <label class="form-label">Kampanya Adı</label>
                        <input asp-for="Name" class="form-control" placeholder="Örn: 1000 TL üzeri %10 indirim" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Kısa Açıklama</label>
                    <input asp-for="Description" class="form-control" placeholder="Örn: NSX30 kodu ile indirim" />
                </div>

                <div class="form-check form-switch mb-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label class="form-check-label">Aktif</label>
                </div>

                <div class="mb-3">
                    <label class="form-label">Minimum Tutar</label>
                    <input asp-for="MinimumCartTotal" class="form-control" type="number" step="0.01" />
                </div>

                <div class="mb-3">
                    <label class="form-label">İndirim Tipi</label>
                    <select asp-for="DiscountType" class="form-select">
                        <option value="Percent">Yüzde</option>
                        <option value="Amount">Sabit TL</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">İndirim Değeri</label>
                    <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Başlangıç Tarihi</label>
                        <input asp-for="StartDate" class="form-control" type="date" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Bitiş Tarihi</label>
                        <input asp-for="EndDate" class="form-control" type="date" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Kaydet</button>
                    <a href="/AdminCampaigns" class="btn btn-outline-secondary rounded-pill px-4">Geri</a>
                </div>
            </form>
        </div>
    </div>
</div>

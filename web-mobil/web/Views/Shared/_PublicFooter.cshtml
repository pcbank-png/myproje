@using NSYazilim.Web.Services
@inject SiteLocalizationService SiteLocalization
@{
    var footerLanguage = await SiteLocalization.GetCurrentLanguageAsync(Context.RequestAborted);
    var footerPath = Context.Request.Path.Value ?? string.Empty;
    var footerReturnUrl = Context.Request.Query["returnUrl"].FirstOrDefault() ?? string.Empty;
    var isFreeVeresiyeContext = footerPath.Equals("/urun/nsx-veresiye-takip-pro-free", StringComparison.OrdinalIgnoreCase)
        || footerPath.StartsWith("/store/free-download-start", StringComparison.OrdinalIgnoreCase)
        || ((footerPath.StartsWith("/Account/Login", StringComparison.OrdinalIgnoreCase)
                || footerPath.StartsWith("/Account/Register", StringComparison.OrdinalIgnoreCase))
            && footerReturnUrl.StartsWith("/store/free-download-start", StringComparison.OrdinalIgnoreCase));
    async Task<string> FT(string source)
    {
        var translated = await SiteLocalization.TranslateAsync(source, footerLanguage.Code, Context.RequestAborted);
        return CheckoutUiTranslations.Resolve(source, footerLanguage.Code, translated);
    }
}
<footer class="nsx-footer-v2">

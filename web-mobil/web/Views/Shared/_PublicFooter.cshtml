<style id="nsx-footer-payment-brands-pro">
/* Always loaded: homepage uses a deferred footer bundle, so the new payment marks must not depend on wwwroot. */
.nsx-footer-v2__payment{display:grid!important;grid-template-columns:38px minmax(180px,1fr) auto!important;align-items:center!important;gap:11px!important;min-width:0!important}.nsx-footer-v2__payment-copy{display:flex!important;min-width:0!important;flex-direction:column!important;gap:3px!important}.nsx-footer-v2__card-brands{min-width:270px;padding:6px 10px 6px 16px;border-inline-start:1px solid #e3e8ed;border-radius:11px;background:#fff}.nsx-footer-v2__card-brands .nsx-payment-brands{display:flex;align-items:center;justify-content:flex-end;gap:15px;min-height:34px}.nsx-footer-v2__card-brands .nsx-payment-brand{display:inline-flex;align-items:center;justify-content:center;flex:none;white-space:nowrap}.nsx-footer-v2__card-brands .nsx-payment-brand--visa{color:#1a2a76;font-size:22px;font-weight:1000;font-style:italic;letter-spacing:-.08em}.nsx-footer-v2__card-brands .nsx-payment-brand--mastercard{display:grid;justify-items:center;gap:0}.nsx-footer-v2__card-brands .nsx-payment-brand__mc-circles{position:relative;display:block;width:35px;height:21px}.nsx-footer-v2__card-brands .nsx-payment-brand__mc-circles b{position:absolute;top:1px;width:20px;height:20px;border-radius:50%}.nsx-footer-v2__card-brands .nsx-payment-brand__mc-circles b:first-child{left:1px;background:#e91d2d}.nsx-footer-v2__card-brands .nsx-payment-brand__mc-circles b:last-child{right:1px;background:#f7a61b;opacity:.94}.nsx-footer-v2__card-brands .nsx-payment-brand--mastercard small{margin-top:-1px;color:#171717;font-size:5.8px;font-weight:800}.nsx-footer-v2__card-brands .nsx-payment-brand--amex{display:grid;place-items:center;width:47px;height:28px;padding:2px;border-radius:3px;background:#1478c9;color:#fff;font-size:6.4px;font-weight:1000;line-height:.9;letter-spacing:-.05em}.nsx-footer-v2__card-brands .nsx-payment-brand--troy{color:#333b46;font-size:21px;font-weight:1000;font-style:italic;letter-spacing:-.08em}.nsx-footer-v2__card-brands .nsx-payment-brand--troy span{margin-inline-start:1px;color:#26a8a4;font-size:9px}
@@media(max-width:760px){.nsx-footer-v2__payment{grid-template-columns:38px minmax(0,1fr)!important}.nsx-footer-v2__card-brands{grid-column:1 / -1;min-width:0;padding:10px 12px;border-inline-start:0;border-top:1px solid #e7ebef}.nsx-footer-v2__card-brands .nsx-payment-brands{justify-content:flex-start;flex-wrap:wrap}}
</style>


                <a href="https://www.youtube.com/@@nsxyazilim" target="_blank" rel="noreferrer" aria-label="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.5 7.1a2.8 2.8 0 0 0-2-2C17.8 4.6 12 4.6 12 4.6s-5.8 0-7.5.5a2.8 2.8 0 0 0-2 2C2 8.8 2 12 2 12s0 3.2.5 4.9a2.8 2.8 0 0 0 2 2c1.7.5 7.5.5 7.5.5s5.8 0 7.5-.5a2.8 2.8 0 0 0 2-2c.5-1.7.5-4.9.5-4.9s0-3.2-.5-4.9Z"/><path fill="#fff" d="m10 15.2 5.2-3.2L10 8.8v6.4Z"/></svg></a>
                <a href="https://wa.me/905434624226" target="_blank" rel="noreferrer" aria-label="WhatsApp"><svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3.2A12.8 12.8 0 0 0 5.2 22.7l-1.7 6.1 6.3-1.7A12.8 12.8 0 1 0 16 3.2Zm0 23.4c-2.1 0-4.2-.6-5.9-1.6l-.4-.3-3.7 1 1-3.6-.3-.5A10.6 10.6 0 1 1 16 26.6Zm5.9-8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.1l-1 1.3c-.2.2-.4.2-.7.1-2-.9-3.4-2-4.3-3.8-.2-.3 0-.5.1-.7l.8-1.1c.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.6-.5-.8-.5h-.6c-.2 0-.6.1-.9.4-1.1 1.2-1.1 2.7-.4 4.3 1.4 3.2 4.1 5.8 7.3 6.7 1.8.5 3.4.3 4.6-.8.4-.4.6-1.5.5-1.8-.1-.1-.4-.2-.7-.4Z"/></svg></a>

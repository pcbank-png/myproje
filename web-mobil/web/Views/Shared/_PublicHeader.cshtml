@using Microsoft.EntityFrameworkCore
@inject NSYazilim.Web.Data.ApplicationDbContext DbContext
@inject NSYazilim.Web.Services.SiteLocalizationService SiteLocalization
@{
    var path = (Context.Request.Path.Value ?? "/").ToLowerInvariant();
    var homeActive = path == "/" || path.StartsWith("/home");
    var storeActive = path.StartsWith("/store") || path.StartsWith("/yazilimlar") || path.StartsWith("/urun");
    var videosActive = path.StartsWith("/videolar");
    var blogActive = path.StartsWith("/blog");
    var supportActive = path.StartsWith("/iletisim") || path.StartsWith("/destek");
    var accountActive = path.StartsWith("/account");
    var customerLoggedIn = User?.Identity?.IsAuthenticated == true && User.IsInRole("User");
    var customerName = (User?.Identity?.Name ?? string.Empty).Trim();
    var accountDisplayName = customerLoggedIn && !string.IsNullOrWhiteSpace(customerName)
        ? customerName
        : "NSX Hesabı";
    var activeLanguages = await SiteLocalization.GetActiveLanguagesAsync(Context.RequestAborted);
    var currentLanguage = await SiteLocalization.GetCurrentLanguageAsync(Context.RequestAborted);

    async Task<string> SafeHeaderTextAsync(string source)
    {
        var translated = await SiteLocalization.TranslateAsync(source, currentLanguage.Code, Context.RequestAborted);
        var plain = NSYazilim.Web.Services.ProductContentSanitizer.ToPlainText(translated);
        return string.IsNullOrWhiteSpace(plain) ? source : plain;
    }

    var localizedAccountLabel = await SafeHeaderTextAsync(customerLoggedIn ? "Hesabım" : "NSX Hesabı");
    var languageReturnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    string? LanguageFlagAsset(string? code) => (code ?? string.Empty).ToLowerInvariant() switch
    {
        "tr" or "tr-tr" => "/nsx-assets/flags/tr.svg",
        "en" or "en-us" or "en-gb" => "/nsx-assets/flags/gb.svg",
        "fr" or "fr-fr" => "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCA5MDAgNjAwIj48cGF0aCBmaWxsPSIjMDAyMzk1IiBkPSJNMCAwaDMwMHY2MDBIMHoiLz48cGF0aCBmaWxsPSIjZmZmIiBkPSJNMzAwIDBoMzAwdjYwMEgzMDB6Ii8+PHBhdGggZmlsbD0iI2VkMjkzOSIgZD0iTTYwMCAwaDMwMHY2MDBINjAweiIvPjwvc3ZnPg==",
        "de" or "de-de" => "/nsx-assets/flags/de.svg",
        "ar" or "ar-sa" => "/nsx-assets/flags/sa.svg",
        _ => null
    };
    string LanguageBadgeCode(string? code, string? urlCode)
    {
        var raw = (string.IsNullOrWhiteSpace(urlCode) ? code : urlCode) ?? string.Empty;
        raw = raw.Trim();
        var dashIndex = raw.IndexOf('-');
        var underscoreIndex = raw.IndexOf('_');
        var separatorIndex = dashIndex < 0
            ? underscoreIndex
            : underscoreIndex < 0 ? dashIndex : Math.Min(dashIndex, underscoreIndex);
        if (separatorIndex > 0)
            raw = raw[..separatorIndex];
        if (raw.Length > 2)
            raw = raw[..2];
        return string.IsNullOrWhiteSpace(raw) ? "--" : raw.ToUpperInvariant();
    }
    // Admin panelindeki kategori kataloğu menünün tek kaynağıdır. Statik belleğe
    // veya sabit bir adet sınırına bağlı kalmadan güncel aktif kayıtları getir.
    var headerCategories = await DbContext.ProductCategories
        .AsNoTracking()
        .Where(x => x.IsActive)
        .OrderBy(x => x.SortOrder)
        .ThenBy(x => x.Label)
        .ToListAsync();
}
@if (!(ViewData["UseHomePerformanceBundle"] is bool useHomePerformanceBundle && useHomePerformanceBundle))

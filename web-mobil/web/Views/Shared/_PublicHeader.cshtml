.public-site-header .nav-links{position:relative;overflow:visible!important;}
.public-site-header .nav-products{position:relative;display:flex;align-items:center;}
.public-site-header .nav-products-trigger{
    position:relative;display:inline-flex;align-items:center;justify-content:center;gap:9px;
    width:auto;min-height:40px;padding:0 13px 0 14px;border:1px solid transparent;border-radius:11px;
    background:transparent;color:#505a65;font-family:inherit;font-size:12px;font-weight:850;line-height:1;letter-spacing:.005em;cursor:pointer;
    transition:color .18s ease,background .18s ease,border-color .18s ease,box-shadow .18s ease,transform .18s ease;
}
.public-site-header .nav-products-trigger::before{
    content:"";width:5px;height:5px;flex:none;border-radius:50%;background:#ff6e04;opacity:0;
    transform:scale(.5);box-shadow:0 0 0 4px rgba(255,110,4,.13);transition:opacity .18s ease,transform .18s ease;
}
.public-site-header .nav-products-chevron{
    width:7px;height:7px;border:solid currentColor;border-width:0 1.5px 1.5px 0;
    transform:translateY(-2px) rotate(45deg);transition:transform .2s ease;
}
.public-site-header .nav-products-trigger:hover,
.public-site-header .nav-products-trigger:focus-visible,
.public-site-header .nav-products.is-open .nav-products-trigger{
    color:#171b20;border-color:#e1e5e9;background:#fff;transform:translateY(-1px);
    box-shadow:0 6px 15px rgba(9,14,20,.075);
}
.public-site-header .nav-products-trigger.is-current{
    color:#d95700;border-color:rgba(255,110,4,.38);background:linear-gradient(180deg,#fff,#fff6ef);
    box-shadow:0 8px 18px rgba(12,17,23,.075),0 0 0 3px rgba(255,110,4,.065),inset 0 1px 0 #fff;
}
.public-site-header .nav-products-trigger.is-current::before{opacity:1;transform:scale(1);}
.public-site-header .nav-products-trigger.is-current:hover,
.public-site-header .nav-products.is-open .nav-products-trigger{
    color:#c94f00;border-color:rgba(255,110,4,.56);background:linear-gradient(180deg,#fff,#ffefe2);
}
.public-site-header .nav-products.is-open .nav-products-chevron{transform:translateY(2px) rotate(225deg);}
.public-site-header .nav-products-panel{
    position:absolute;z-index:120;left:50%;top:calc(100% + 14px);width:590px;padding:10px;
    border:1px solid rgba(20,27,34,.11);border-radius:20px;background:rgba(255,255,255,.985);
    box-shadow:0 28px 70px rgba(6,10,15,.22),0 10px 25px rgba(255,110,4,.08),inset 0 1px 0 #fff;
    opacity:0;visibility:hidden;pointer-events:none;transform:translate(-50%,-8px) scale(.985);transform-origin:50% 0;
    transition:opacity .2s ease,visibility .2s ease,transform .22s cubic-bezier(.2,.72,.2,1);backdrop-filter:blur(18px);
}
.public-site-header .nav-products-panel::before{
    content:"";position:absolute;left:50%;top:-7px;width:13px;height:13px;border:solid rgba(20,27,34,.10);
    border-width:1px 0 0 1px;background:#fff;transform:translateX(-50%) rotate(45deg);
}
.public-site-header .nav-products.is-open .nav-products-panel{
    opacity:1;visibility:visible;pointer-events:auto;transform:translate(-50%,0) scale(1);
}
.public-site-header .nav-products-head{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:12px 13px 13px;border-bottom:1px solid #e9ecef;}
.public-site-header .nav-products-head span{display:flex;flex-direction:column;gap:3px;}
.public-site-header .nav-products-head small{color:#ff6e04;font-size:8px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;}
.public-site-header .nav-products-head strong{color:#171c22;font-size:14px;letter-spacing:-.02em;}
.public-site-header .nav-products-all{display:inline-flex;align-items:center;gap:8px;min-height:34px;padding:0 11px;border-radius:10px;background:#171b20;color:#fff!important;font-size:9px;font-weight:850;white-space:nowrap;}
.public-site-header .nav-products-all .nsx-dir-icon{display:grid!important;place-items:center!important;flex:0 0 21px!important;width:21px!important;min-width:21px!important;max-width:21px!important;height:21px!important;min-height:21px!important;max-height:21px!important;border:0!important;border-radius:7px!important;background:#ff6e04!important;color:#fff!important;box-shadow:none!important;}
.public-site-header .nav-products-all .nsx-dir-icon>svg{width:13px!important;height:13px!important;}
.public-site-header .nav-products-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;max-height:min(62vh,464px);padding:8px 3px 0 0;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable;}
.public-site-header .nav-category-card{display:grid;grid-template-columns:36px minmax(0,1fr) 22px;align-items:center;gap:9px;min-height:58px;padding:8px 9px;border:1px solid transparent;border-radius:13px;color:#48535e!important;background:#f7f8fa;pointer-events:auto;transition:background .17s ease,border-color .17s ease,transform .17s ease,box-shadow .17s ease;}
.public-site-header .nav-category-card:hover,.public-site-header .nav-category-card:focus-visible{color:#171b20!important;border-color:rgba(255,110,4,.28);background:#fff7f1;transform:translateY(-1px);box-shadow:0 8px 18px rgba(12,17,23,.065);}
.public-site-header .nav-category-index{display:grid;place-items:center;width:36px;height:36px;border-radius:11px;background:#fff;color:#ff6e04;font-size:9px;font-weight:950;box-shadow:0 5px 12px rgba(12,17,23,.06);}
.public-site-header .nav-category-copy{display:flex;min-width:0;flex-direction:column;gap:3px;}
.public-site-header .nav-category-copy strong{overflow:hidden;color:#20262d;font-size:10.5px;text-overflow:ellipsis;white-space:nowrap;}
.public-site-header .nav-category-copy small{color:#87919a;font-size:8px;}
.public-site-header .nav-category-arrow{display:grid!important;place-items:center!important;flex:0 0 22px!important;width:22px!important;min-width:22px!important;max-width:22px!important;height:22px!important;min-height:22px!important;max-height:22px!important;border:0!important;border-radius:7px!important;color:#8a949e!important;background:#fff!important;box-shadow:none!important;transition:color .17s ease,background .17s ease,transform .17s ease!important;}
.public-site-header .nav-category-arrow>svg{width:13px!important;height:13px!important;}
.public-site-header .nav-category-card:hover .nav-category-arrow,.public-site-header .nav-category-card:focus-visible .nav-category-arrow{color:#fff!important;background:#ff6e04!important;transform:translateX(2px)!important;}
@@media(max-width:980px){
    .public-site-header .nav-products{display:block;width:100%;}
    .public-site-header .nav-products-trigger{justify-content:flex-start;width:100%;min-height:44px;padding:0 13px;border-radius:10px;}
    .public-site-header .nav-products-trigger .nav-products-chevron{margin-left:auto;margin-right:4px;}
    .public-site-header .nav-products-panel{position:static;width:100%;margin:5px 0 2px;padding:7px;border-radius:14px;box-shadow:inset 0 1px 0 #fff,0 8px 18px rgba(8,12,18,.08);opacity:0;visibility:hidden;display:none;pointer-events:none;transform:none;}
    .public-site-header .nav-products-panel::before{display:none;}
    .public-site-header .nav-products.is-open .nav-products-panel{display:block;opacity:1;visibility:visible;pointer-events:auto;transform:none;}
    .public-site-header .nav-products-head{padding:8px 8px 10px;}
    .public-site-header .nav-products-grid{gap:5px;max-height:min(52vh,420px);}
    .public-site-header .nav-category-card{min-height:52px;grid-template-columns:31px minmax(0,1fr) 20px;padding:6px;}
    .public-site-header .nav-category-index{width:31px;height:31px;}
    .public-site-header .nav-category-copy strong{display:-webkit-box;overflow:hidden;font-size:9.5px;line-height:1.2;white-space:normal;-webkit-box-orient:vertical;-webkit-line-clamp:2;}
    .public-site-header .nav-category-copy small{display:none;}
}
</style>
}


<link rel="stylesheet" href="/css/nsx-home-header-pro.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/nsx-home-button-type.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/nsx-localization.css" asp-append-version="true" />
<header class="public-site-header videos-header">
    <div class="service-ribbon">
        <div class="container">
            <span><b>✓</b> @(await SafeHeaderTextAsync("Güvenli dijital teslimat"))</span>
            <div class="service-ribbon-actions">
                <a href="/iletisim">@(await SafeHeaderTextAsync("Destek"))</a>
                <a href="/Account/Downloads">@(await SafeHeaderTextAsync("İndirmelerim"))</a>
                <a href="/Account/Licenses">@(await SafeHeaderTextAsync("Lisanslarım"))</a>
                <details class="nsx-language-switcher" data-language-switcher>
                    <summary aria-label="Dil seçimi" title="Dil seçimi">
                        <span class="nsx-language-flag" aria-hidden="true">
                            @if (LanguageFlagAsset(currentLanguage.Code) is string currentFlagAsset)
                            {
                                <img src="@currentFlagAsset" alt="" width="28" height="20" />
                            }
                            else
                            {
                                <span class="nsx-language-emoji">@currentLanguage.FlagEmoji</span>
                            }
                        </span>
                        @{
                            var currentLanguageBadge = LanguageBadgeCode(currentLanguage.Code, currentLanguage.UrlCode);
                        }
                        <svg class="nsx-language-code-badge nsx-language-code-badge--current" viewBox="0 0 24 18" role="img" aria-label="@currentLanguageBadge" focusable="false">
                            <rect x="0.5" y="0.5" width="23" height="17" rx="5" fill="#f0f2f4" stroke="#e8ebee" />
                            <text x="12" y="12" fill="#46515c" font-family="Arial, Segoe UI, sans-serif" font-size="9.1" font-weight="800" text-anchor="middle">@currentLanguageBadge</text>
                        </svg>
                        <span class="nsx-language-current notranslate" translate="no" data-nsx-localization="off" lang="@currentLanguage.Code" dir="@(currentLanguage.IsRtl ? "rtl" : "ltr")">@currentLanguage.NativeName</span>
                        <span class="nsx-language-chevron" aria-hidden="true"></span>
                    </summary>
                    <form class="nsx-language-dropdown" method="get" action="/language/set">
                        <input type="hidden" name="returnUrl" value="@languageReturnUrl" />
                        <div class="nsx-language-dropdown-head">
                            <span class="nsx-language-dropdown-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <circle cx="12" cy="12" r="8.5"></circle>
                                    <path d="M3.8 12h16.4M12 3.5c2.15 2.3 3.25 5.13 3.25 8.5S14.15 18.2 12 20.5C9.85 18.2 8.75 15.37 8.75 12S9.85 5.8 12 3.5Z"></path>
                                </svg>
                            </span>
                            <span>
                                <strong>Dil / Language</strong>
                                <small>Seçiminiz hatırlanır</small>
                            </span>
                        </div>
                        <div class="nsx-language-list">
                            @foreach (var language in activeLanguages)
                            {
                                var isCurrentLanguage = string.Equals(language.Code, currentLanguage.Code, StringComparison.OrdinalIgnoreCase);
                                <button type="submit" name="code" value="@language.Code" class="nsx-language-option notranslate @(isCurrentLanguage ? "is-current" : "")" translate="no" data-nsx-localization="off" aria-current="@(isCurrentLanguage ? "true" : null)" aria-label="@language.NativeName">
                                    <span class="nsx-language-option-flag" aria-hidden="true">
                                        @if (LanguageFlagAsset(language.Code) is string flagAsset)
                                        {
                                            <img src="@flagAsset" alt="" width="30" height="21" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="nsx-language-emoji">@language.FlagEmoji</span>
                                        }
                                    </span>
                                    @{
                                        var languageBadge = LanguageBadgeCode(language.Code, language.UrlCode);
                                    }
                                    <svg class="nsx-language-code-badge nsx-language-code-badge--option" viewBox="0 0 24 18" role="img" aria-label="@languageBadge" focusable="false">
                                        <rect x="0.5" y="0.5" width="23" height="17" rx="5" fill="#eceff1" stroke="#e3e7ea" />
                                        <text x="12" y="12" fill="#56616c" font-family="Arial, Segoe UI, sans-serif" font-size="9.1" font-weight="800" text-anchor="middle">@languageBadge</text>
                                    </svg>
                                    <span class="nsx-language-option-name" lang="@language.Code" dir="@(language.IsRtl ? "rtl" : "ltr")">@language.NativeName</span>
                                    <span class="nsx-language-option-check" aria-hidden="true">✓</span>
                                </button>
                            }
                        </div>
                    </form>
                </details>
            </div>
        </div>
    </div>
    <nav class="nav detail-nav container" aria-label="@(await SafeHeaderTextAsync("Ana menü"))">
        <a href="/" class="brand" aria-label="@(await SafeHeaderTextAsync("NSX Yazılım ana sayfa"))"><img class="brand-logo" src="/nsx-assets/logo-brand.webp" asp-append-version="true" alt="NSX Yazılım" width="400" height="105" decoding="async" /></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="public-main-menu" aria-label="@(await SafeHeaderTextAsync("Ana menüyü aç"))"><span></span><span></span><span></span></button>
        <div class="nav-links" id="public-main-menu">
            <a class="@(homeActive ? "is-current" : "")" href="/">@(await SafeHeaderTextAsync("Ana Sayfa"))</a>
            <div class="nav-products @(storeActive ? "is-current" : "")" data-products-menu>
                <button class="nav-products-trigger @(storeActive ? "is-current" : "")" type="button" aria-expanded="false" aria-controls="public-products-panel">
                    <span>@(await SafeHeaderTextAsync("Yazılımlar"))</span><i class="nav-products-chevron" aria-hidden="true"></i>
                </button>
                <div class="nav-products-panel" id="public-products-panel">
                    <div class="nav-products-head">
                        <span><small>@(await SafeHeaderTextAsync("NSX Çözümleri"))</small><strong>@(await SafeHeaderTextAsync("İşletmenize uygun yazılımı seçin"))</strong></span>
                        <a class="nav-products-all" href="/store">@(await SafeHeaderTextAsync("Tüm Yazılımlar")) <b class="nsx-dir-icon is-compact" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5.5 6.5 6.5L9 18.5"></path></svg></b></a>
                    </div>
                    <div class="nav-products-grid">
                        @for (var categoryIndex = 0; categoryIndex < headerCategories.Count; categoryIndex++)
                        {
                            var headerCategory = headerCategories[categoryIndex];
                            <a class="nav-category-card" href="/store?category=@Uri.EscapeDataString(headerCategory.Key)">
                                <span class="nav-category-index">@((categoryIndex + 1).ToString("00"))</span>
                                <span class="nav-category-copy"><strong>@(await SafeHeaderTextAsync(headerCategory.Label))</strong><small>@(await SafeHeaderTextAsync("Ürünleri görüntüle"))</small></span>
                                <span class="nav-category-arrow nsx-dir-icon is-compact" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5.5 6.5 6.5L9 18.5"></path></svg></span>
                            </a>
                        }
                    </div>
                </div>
            </div>
            <a class="@(videosActive ? "is-current" : "")" href="/videolar">@(await SafeHeaderTextAsync("Videolar"))</a><a class="@(blogActive ? "is-current" : "")" href="/blog">@(await SafeHeaderTextAsync("Rehberler"))</a><a class="@(supportActive ? "is-current" : "")" href="/iletisim">@(await SafeHeaderTextAsync("Destek"))</a>
        </div>
        <div class="account-menu @(accountActive ? "is-current" : "") @(customerLoggedIn ? "is-logged-in" : "")" data-account-menu>
            <button class="account-menu-button" type="button" aria-expanded="false" aria-controls="public-account-dropdown">
                <span class="account-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"></circle><path d="M5.5 20c.5-4 2.8-6 6.5-6s6 2 6.5 6"></path></svg></span>
                <span class="account-welcome">
                    <span class="account-welcome-label notranslate" translate="no" data-nsx-localization="off">@localizedAccountLabel</span>
                    @if (customerLoggedIn && !string.IsNullOrWhiteSpace(customerName))
                    {
                        <strong class="account-welcome-name">@customerName</strong>
                    }
                </span><span class="account-chevron" aria-hidden="true"></span>
            </button>
            <div class="account-dropdown" id="public-account-dropdown" role="menu">
                @if (customerLoggedIn)
                {
                    <div class="account-dropdown-head"><small>NSX Hesabı</small><strong>@accountDisplayName</strong><p>Hesap, lisans ve indirme işlemleriniz.</p></div>
                    <a class="account-menu-link" href="/Account/MyAccount" role="menuitem"><span class="account-link-icon"><svg viewBox="0 0 24 24" stroke-width="1.8"><circle cx="12" cy="8" r="3.5"/><path d="M5.5 20c.5-4 2.8-6 6.5-6s6 2 6.5 6"/></svg></span><span class="account-link-copy">Hesabım<small>Genel bakış ve siparişler</small></span><span class="account-link-cue"><svg viewBox="0 0 24 24" stroke-width="2"><path d="m9 5.5 6.5 6.5L9 18.5"/></svg></span></a>
                    <a class="account-menu-link" href="/Account/Licenses" role="menuitem"><span class="account-link-icon"><svg viewBox="0 0 24 24" stroke-width="1.8"><path d="m12 3 8 4v5c0 5-3.4 8-8 9-4.6-1-8-4-8-9V7z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg></span><span class="account-link-copy">Lisanslarım<small>Aktif ürün lisanslarınız</small></span><span class="account-link-cue"><svg viewBox="0 0 24 24" stroke-width="2"><path d="m9 5.5 6.5 6.5L9 18.5"/></svg></span></a>
                    <a class="account-menu-link" href="/Account/Downloads" role="menuitem"><span class="account-link-icon"><svg viewBox="0 0 24 24" stroke-width="1.8"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg></span><span class="account-link-copy">İndirmelerim<small>Kurulum ve program dosyaları</small></span><span class="account-link-cue"><svg viewBox="0 0 24 24" stroke-width="2"><path d="m9 5.5 6.5 6.5L9 18.5"/></svg></span></a>
                    <a class="account-menu-link" href="/Account/ChangePassword" role="menuitem"><span class="account-link-icon"><svg viewBox="0 0 24 24" stroke-width="1.8"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M12 14v2"/></svg></span><span class="account-link-copy">Şifre ve Güvenlik<small>Hesap erişim ayarları</small></span><span class="account-link-cue"><svg viewBox="0 0 24 24" stroke-width="2"><path d="m9 5.5 6.5 6.5L9 18.5"/></svg></span></a>
                    <div class="account-dropdown-divider"></div>
                    <a class="account-menu-link account-logout" href="/Account/Logout" role="menuitem"><span class="account-link-icon"><svg viewBox="0 0 24 24" stroke-width="1.8"><path d="M10 5H5v14h5"/><path d="M13 8l4 4-4 4"/><path d="M8 12h9"/></svg></span><span class="account-link-copy">Çıkış Yap<small>Oturumu güvenle kapatın</small></span><span class="account-link-cue"><svg viewBox="0 0 24 24" stroke-width="2"><path d="m9 5.5 6.5 6.5L9 18.5"/></svg></span></a>
                }
                else
                {
                    <div class="account-dropdown-head"><small>NSX Hesabı</small><strong>Hoşgeldiniz</strong><p>Hesabınıza giriş yapın veya ücretsiz üyelik oluşturun.</p></div>
                    <a class="account-menu-link account-primary-link" href="/Account/Login" role="menuitem"><span class="account-link-icon"><svg viewBox="0 0 24 24" stroke-width="1.8"><path d="M10 5H5v14h5"/><path d="M13 8l4 4-4 4"/><path d="M8 12h9"/></svg></span><span class="account-link-copy">Giriş Yap<small>Lisans ve indirmelerinize ulaşın</small></span><span class="account-link-cue"><svg viewBox="0 0 24 24" stroke-width="2"><path d="m9 5.5 6.5 6.5L9 18.5"/></svg></span></a>
                    <a class="account-menu-link" href="/Account/Register" role="menuitem"><span class="account-link-icon"><svg viewBox="0 0 24 24" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><path d="M3.5 19c.5-3.5 2.3-5.2 5.5-5.2 1.2 0 2.2.2 3 .7"/><path d="M17 11v6M14 14h6"/></svg></span><span class="account-link-copy">Ücretsiz Üye Ol<small>Yeni NSX hesabı oluşturun</small></span><span class="account-link-cue"><svg viewBox="0 0 24 24" stroke-width="2"><path d="m9 5.5 6.5 6.5L9 18.5"/></svg></span></a>
                }
            </div>
        </div>
    </nav>
    @if (!(ViewData["SkipActiveCampaign"] is bool skipCampaign && skipCampaign))
    {
        @await Component.InvokeAsync("ActiveCampaign", new { preloadedCampaigns = ViewData["PreloadedActiveCampaigns"] as System.Collections.Generic.IEnumerable<NSYazilim.Web.Models.Campaign> })
    }
</header>
@if (!(ViewData["UseHomePerformanceBundle"] is bool useHomePerformanceScripts && useHomePerformanceScripts))
{
    <script src="/js/public-header.js" asp-append-version="true" defer></script>
}

<script src="/js/nsx-localization.js" asp-append-version="true" defer></script>

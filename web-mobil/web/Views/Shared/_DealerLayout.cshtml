@inject NSYazilim.Web.Services.SiteLocalizationService SiteLocalization
@{
    var currentLanguage = await SiteLocalization.GetCurrentLanguageAsync();
    var dealer = ViewBag.Dealer as NSYazilim.Web.Models.Dealer;
    var title = ViewData["Title"] ?? "Bayi Paneli";
}
<!DOCTYPE html>
<html lang="@currentLanguage.UrlCode" dir="@(currentLanguage.IsRtl ? "rtl" : "ltr")">
<head>
    <link rel="stylesheet" href="~/css/nsx-design-tokens.css" asp-append-version="true" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>@title - NSX Bayi</title>
    <style>
        *{box-sizing:border-box}body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;background:#f3f7f8;color:#10252d}.dealer-shell{min-height:100vh;display:grid;grid-template-columns:250px 1fr}.dealer-side{background:#0c2d36;color:#fff;padding:24px 18px;display:flex;flex-direction:column;gap:22px}.dealer-brand{display:flex;align-items:center;gap:12px;color:#fff;text-decoration:none}.dealer-logo{width:46px;height:46px;border-radius:13px;background:#28bfa9;display:grid;place-items:center;font-weight:800}.dealer-brand strong{display:block;font-size:17px}.dealer-brand small{opacity:.68}.dealer-nav{display:flex;flex-direction:column;gap:6px}.dealer-nav a{color:#d9ebee;text-decoration:none;padding:12px 13px;border-radius:10px;font-weight:650}.dealer-nav a:hover{background:#173f49;color:#fff}.dealer-side-foot{margin-top:auto;padding-top:16px;border-top:1px solid rgba(255,255,255,.12)}.dealer-side-foot strong,.dealer-side-foot small{display:block}.dealer-side-foot small{opacity:.72;margin-top:4px;word-break:break-word}.dealer-logout{width:100%;margin-top:12px;border:1px solid rgba(255,255,255,.2);background:transparent;color:#fff;padding:10px 12px;border-radius:9px;cursor:pointer}.dealer-main{min-width:0}.dealer-top{height:78px;background:#fff;border-bottom:1px solid #dce7e9;display:flex;align-items:center;justify-content:space-between;padding:0 28px}.dealer-top span{font-size:12px;letter-spacing:.1em;color:#168c7c;font-weight:800}.dealer-top strong{display:block;font-size:18px}.dealer-home{color:#143b45;text-decoration:none;border:1px solid #d4e2e4;border-radius:9px;padding:9px 12px;font-weight:700}.dealer-content{padding:28px;max-width:1500px;margin:0 auto}.dealer-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:22px}.dealer-head h1{margin:4px 0 6px;font-size:30px}.dealer-head p{margin:0;color:#60767d}.dealer-kicker{font-size:12px;letter-spacing:.12em;color:#168c7c;font-weight:850}.dealer-btn{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;border:0;border-radius:10px;padding:11px 15px;background:#123d47;color:#fff;font-weight:750;cursor:pointer}.dealer-btn.primary{background:#16a98f}.dealer-btn.light{background:#fff;color:#153b45;border:1px solid #d5e2e5}.dealer-btn.danger{background:#a72f3c}.dealer-btn.sm{padding:8px 11px;font-size:13px}.dealer-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:20px}.dealer-card{background:#fff;border:1px solid #dce7e9;border-radius:16px;padding:19px;box-shadow:0 8px 24px rgba(16,54,63,.04)}.dealer-stat small{display:block;color:#6d8086;font-weight:650}.dealer-stat strong{display:block;margin-top:8px;font-size:28px;color:#153b45}.dealer-card h2{margin:0 0 14px;font-size:19px}.dealer-table-wrap{overflow:auto}.dealer-table{width:100%;border-collapse:collapse;min-width:940px}.dealer-table th{font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:#75888e;text-align:left;padding:12px;border-bottom:1px solid #dce7e9;background:#f7fafb}.dealer-table td{padding:13px 12px;border-bottom:1px solid #edf2f3;vertical-align:top}.dealer-table td small{display:block;color:#72858b;margin-top:4px}.dealer-pill{display:inline-flex;padding:5px 9px;border-radius:999px;font-size:12px;font-weight:800;background:#edf3f4;color:#39525a}.dealer-pill.ok{background:#e6f8f2;color:#11846e}.dealer-pill.warn{background:#fff3d9;color:#9b6500}.dealer-pill.bad{background:#fdebed;color:#a12b38}.dealer-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.dealer-field label{display:block;font-size:13px;font-weight:750;margin-bottom:7px}.dealer-field input,.dealer-field select,.dealer-field textarea{width:100%;border:1px solid #cedde0;background:#fff;border-radius:10px;padding:11px 12px;font:inherit;color:#15343c}.dealer-field textarea{min-height:92px;resize:vertical}.dealer-field.full{grid-column:1/-1}.dealer-alert{padding:12px 14px;border-radius:10px;margin-bottom:14px;background:#eef9f7;border:1px solid #c6ece5;color:#176758}.dealer-alert.error{background:#fff0f1;border-color:#f1c5ca;color:#942b37}.dealer-note{background:#f5faf9;border:1px solid #dbece8;padding:13px 14px;border-radius:10px;color:#48666d}.dealer-license{padding:12px;border:1px solid #dce7e9;border-radius:10px;margin-top:9px}.dealer-code{font-family:Consolas,monospace;font-size:14px;word-break:break-all}.dealer-actions{display:flex;gap:8px;flex-wrap:wrap}.dealer-empty{padding:28px;text-align:center;color:#72858b}.validation-summary-errors{background:#fff0f1;border:1px solid #f1c5ca;color:#942b37;padding:12px;border-radius:10px;margin-bottom:15px}.field-validation-error{color:#a72f3c;font-size:12px;display:block;margin-top:5px}input[type=checkbox]{appearance:none;-webkit-appearance:none;position:relative;display:inline-grid;place-items:center;width:15px!important;height:15px;margin:0;border:1px solid #b9c9cd;border-radius:3px;background:#fff;cursor:pointer}input[type=checkbox]:checked{border-color:#16a98f;background:#16a98f}input[type=checkbox]:checked::after{content:"✓";color:#fff;font-size:10px;line-height:1;font-weight:900}@@media(max-width:980px){.dealer-shell{grid-template-columns:1fr}.dealer-side{padding:16px}.dealer-nav{flex-direction:row;flex-wrap:wrap}.dealer-side-foot{margin-top:0}.dealer-grid{grid-template-columns:repeat(2,1fr)}}@@media(max-width:650px){.dealer-content{padding:18px}.dealer-top{padding:0 18px}.dealer-head{flex-direction:column}.dealer-grid{grid-template-columns:1fr}.dealer-form-grid{grid-template-columns:1fr}.dealer-field.full{grid-column:auto}}
    </style>
    <link rel="stylesheet" href="/css/nsx-global-type.css" asp-append-version="true" />
</head>
<body>
<div class="dealer-shell">
    <aside class="dealer-side">
        <a class="dealer-brand" href="/Bayi"><span class="dealer-logo">NSX</span><span><strong>Bayi Paneli</strong><small>Sat&#305;&#351; ve kontrol kanal&#305;</small></span></a>
        <nav class="dealer-nav">
            <a href="/Bayi">Genel Bak&#305;&#351;</a>
            <a href="/Bayi/Satis/Yeni">Yeni Sat&#305;&#351;</a>
            <a href="/Bayi/Satislarim">Sat&#305;&#351;lar&#305;m / Lisanslar</a>
            <a href="/">NSX Yaz&#305;l&#305;m Sitesi</a>
        </nav>
        @if (dealer != null)
        {
            <div class="dealer-side-foot">
                <strong>@dealer.BusinessName</strong><small>@dealer.DealerCode</small><small>@dealer.Email</small>
                <form method="post" action="/Bayi/Cikis">@Html.AntiForgeryToken()<button class="dealer-logout" type="submit">G&#252;venli &#199;&#305;k&#305;&#351;</button></form>
            </div>
        }
    </aside>
    <div class="dealer-main">
        <header class="dealer-top"><div><span>NSX YAZILIM</span><strong>@title</strong></div><a class="dealer-home" href="/">Ana Sayfa</a></header>
        <main class="dealer-content">
            @if (TempData["Success"] != null) { <div class="dealer-alert">@TempData["Success"]</div> }
            @if (TempData["Error"] != null) { <div class="dealer-alert error">@TempData["Error"]</div> }
            @RenderBody()
        </main>
    </div>
</div>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

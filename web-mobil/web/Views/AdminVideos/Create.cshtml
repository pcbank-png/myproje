@model NSYazilim.Web.ViewModels.ProductVideoFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Yeni Video Ekle";
}

<section class="nsx-video-admin-head compact">
    <div>
        <span class="nsx-video-kicker">Video Yönetimi</span>
        <h1>Yeni YouTube Videosu</h1>
        <p>Bağlantıyı girin ve videonun ait olduğu programı seçin.</p>
    </div>
    <a class="nsx-admin-btn" href="/Admin/Videos">Videolara Dön</a>
</section>

@await Html.PartialAsync("_VideoForm", Model)

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

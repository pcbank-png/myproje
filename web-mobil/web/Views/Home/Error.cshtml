@model NSYazilim.Web.Models.ErrorViewModel
@{
    Layout = "_PublicLayout";
}

<style id="nsx-status-pro-standard">
    .public-content-page{background:#fff!important;}
    .public-content-page *{box-sizing:border-box;}
    .public-content-page > .container{width:100%!important;max-width:none!important;margin:0!important;padding:0!important;}

    .public-content-page .public-site-header .service-ribbon > .container,
    .public-content-page .public-site-header .detail-nav.container,
    .nsx-status-pro .nsx-status-hero > .container,
    .nsx-status-pro .nsx-status-content > .container{
        width:min(1505px,calc(100% - 48px))!important;
        max-width:1505px!important;
        margin-left:auto!important;
        margin-right:auto!important;
    }

    @@media (min-width:981px){
        .public-content-page .public-site-header .detail-nav.container{display:flex!important;align-items:center!important;min-height:78px!important;gap:8px!important;}
        .public-content-page .public-site-header .brand{display:flex!important;align-items:center!important;justify-content:flex-start!important;flex:0 0 auto!important;margin:0 auto 0 0!important;padding:0!important;}
        .public-content-page .public-site-header .brand-logo{display:block!important;width:clamp(142px,10.8vw,184px)!important;max-width:184px!important;height:auto!important;object-fit:contain!important;}
        .public-content-page .public-site-header .nav-links{display:flex!important;align-items:center!important;justify-content:flex-end!important;flex:0 1 auto!important;width:auto!important;margin-left:auto!important;margin-right:7px!important;gap:7px!important;}
        .public-content-page .public-site-header .nav-links > a{white-space:nowrap!important;}
        .public-content-page .public-site-header .nav-cta{flex:0 0 auto!important;margin-left:0!important;}
        .public-content-page .public-site-header .menu-toggle{display:none!important;}
    }

    .nsx-status-pro{background:#fff;color:#171b20;}
    .nsx-status-pro .nsx-status-hero{
        position:relative;
        width:100%;
        height:286px!important;
        min-height:286px!important;
        max-height:286px!important;
        overflow:hidden;
        color:#fff;
        background:radial-gradient(ellipse at 80% 50%,rgba(255,110,4,.10) 0%,rgba(255,110,4,.03) 26%,transparent 48%),linear-gradient(118deg,#030405 0%,#06080b 42%,#0a1219 100%);
        border-top:1px solid rgba(255,255,255,.04);
        border-bottom:1px solid rgba(255,255,255,.06);
        box-shadow:inset 0 1px 0 rgba(255,255,255,.03),inset 0 -50px 90px rgba(0,0,0,.22);
    }
    .nsx-status-pro .nsx-status-hero:before{
        content:"";
        position:absolute;
        inset:0;
        pointer-events:none;
        opacity:.10;
        background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
        background-size:72px 72px;
        -webkit-mask-image:linear-gradient(90deg,rgba(0,0,0,.95) 0%,rgba(0,0,0,.55) 58%,transparent 100%);
        mask-image:linear-gradient(90deg,rgba(0,0,0,.95) 0%,rgba(0,0,0,.55) 58%,transparent 100%);
    }
    .nsx-status-pro .nsx-status-hero > .container{position:relative;z-index:2;height:100%;display:flex;align-items:flex-start;padding-top:24px;padding-bottom:24px;}
    .nsx-status-pro .nsx-status-hero-copy{max-width:980px;}
    .nsx-status-pro .nsx-status-kicker{display:flex;align-items:center;gap:10px;margin:0 0 14px;color:#39d98a;font-size:12px;font-weight:900;letter-spacing:.11em;text-transform:uppercase;}
    .nsx-status-pro .nsx-status-kicker:before{content:"";width:7px;height:7px;flex:0 0 auto;border-radius:50%;background:#39d98a;box-shadow:0 0 0 5px rgba(57,217,138,.12);}
    .nsx-status-pro .nsx-status-hero h1{max-width:900px;margin:0;color:#fff;font-size:42px;font-weight:900;line-height:1.06;letter-spacing:-.04em;}
    .nsx-status-pro .nsx-status-hero h1 em{display:block;color:#ff6e04;font-style:normal;}
    .nsx-status-pro .nsx-status-hero p{max-width:900px;margin:12px 0 0;color:#d3d8df;font-size:14px;line-height:1.7;font-weight:520;}
    .nsx-status-pro .nsx-status-hero-points{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px;}
    .nsx-status-pro .nsx-status-hero-points span{display:inline-flex;align-items:center;gap:7px;min-height:34px;padding:0 11px;border:1px solid rgba(255,255,255,.15);border-radius:999px;background:rgba(255,255,255,.045);color:#d9dee4;font-size:10px;font-weight:800;}
    .nsx-status-pro .nsx-status-hero-points b{color:#39d98a;font-size:11px;}

    .nsx-status-pro .nsx-status-content{padding:38px 0 72px;background:#fff;}
    .nsx-status-pro .nsx-status-panel{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(300px,.7fr);gap:20px;align-items:stretch;}
    .nsx-status-pro .nsx-status-card{position:relative;overflow:hidden;padding:30px;border:1px solid #e1e6eb;border-radius:20px;background:linear-gradient(145deg,#fff 0%,#fbfcfd 100%);box-shadow:0 14px 36px rgba(15,23,42,.055);}
    .nsx-status-pro .nsx-status-card:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:#ff6e04;}
    .nsx-status-pro .nsx-status-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;padding-bottom:22px;border-bottom:1px solid #edf0f3;}
    .nsx-status-pro .nsx-status-card-label{display:block;margin-bottom:7px;color:#ff6e04;font-size:10px;font-weight:900;letter-spacing:.11em;text-transform:uppercase;}
    .nsx-status-pro .nsx-status-card h2{max-width:720px;margin:0;color:#171b20;font-size:30px;font-weight:900;line-height:1.12;letter-spacing:-.035em;}
    .nsx-status-pro .nsx-status-code{flex:0 0 auto;color:#ff6e04;font-size:54px;font-weight:900;line-height:.9;letter-spacing:-.06em;}
    .nsx-status-pro .nsx-status-card > p{max-width:820px;margin:20px 0 0;color:#687582;font-size:12px;line-height:1.75;}
    .nsx-status-pro .nsx-status-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px;}
    .nsx-status-pro .nsx-status-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 17px;border-radius:12px;font-size:10px;font-weight:900;text-decoration:none;transition:transform .16s ease,box-shadow .16s ease,background .16s ease;}
    .nsx-status-pro .nsx-status-actions .is-primary{border:1px solid #ff6e04;background:#ff6e04;color:#fff;box-shadow:0 9px 22px rgba(255,110,4,.20);}
    .nsx-status-pro .nsx-status-actions .is-secondary{border:1px solid #dfe4e9;background:#fff;color:#343d47;}
    .nsx-status-pro .nsx-status-actions a:hover{transform:translateY(-1px);}
    .nsx-status-pro .nsx-status-request{display:block;margin-top:18px;color:#8a949f;font-size:9px;line-height:1.6;}
    .nsx-status-pro .nsx-status-request code{padding:3px 6px;border:1px solid #e4e8ec;border-radius:6px;background:#f7f8fa;color:#53606d;font-size:9px;}

    .nsx-status-pro .nsx-status-side{position:relative;overflow:hidden;padding:28px;border:1px solid #202b36;border-radius:20px;background:radial-gradient(circle at 86% 10%,rgba(255,110,4,.14),transparent 32%),linear-gradient(145deg,#10151b 0%,#171d24 100%);color:#fff;box-shadow:0 14px 36px rgba(15,23,42,.11);}
    .nsx-status-pro .nsx-status-side > span{display:block;color:#ff8a33;font-size:9px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;}
    .nsx-status-pro .nsx-status-side h3{margin:9px 0 10px;color:#fff;font-size:23px;font-weight:900;line-height:1.18;letter-spacing:-.03em;}
    .nsx-status-pro .nsx-status-side > p{margin:0;color:#aeb7c0;font-size:11px;line-height:1.7;}
    .nsx-status-pro .nsx-status-links{display:grid;gap:8px;margin-top:22px;}
    .nsx-status-pro .nsx-status-links a{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:45px;padding:0 13px;border:1px solid rgba(255,255,255,.09);border-radius:12px;background:rgba(255,255,255,.035);color:#eef2f5;font-size:10px;font-weight:850;text-decoration:none;}
    .nsx-status-pro .nsx-status-links a span{color:#ff8a33;font-size:14px;}

    @@media (max-width:1180px){
        .public-content-page .public-site-header .service-ribbon > .container,
        .public-content-page .public-site-header .detail-nav.container,
        .nsx-status-pro .nsx-status-hero > .container,
        .nsx-status-pro .nsx-status-content > .container{width:calc(100% - 32px)!important;}
        .nsx-status-pro .nsx-status-hero h1{font-size:38px;}
    }
    @@media (max-width:980px){
        .public-content-page .public-site-header .service-ribbon > .container,
        .public-content-page .public-site-header .detail-nav.container,
        .nsx-status-pro .nsx-status-hero > .container,
        .nsx-status-pro .nsx-status-content > .container{width:calc(100% - 24px)!important;}
        .nsx-status-pro .nsx-status-panel{grid-template-columns:1fr;}
    }
    @@media (max-width:680px){
        .nsx-status-pro .nsx-status-hero > .container,
        .nsx-status-pro .nsx-status-content > .container{width:calc(100% - 18px)!important;}
        .nsx-status-pro .nsx-status-hero > .container{padding-top:20px;padding-bottom:20px;}
        .nsx-status-pro .nsx-status-hero h1{font-size:30px;}
        .nsx-status-pro .nsx-status-hero p{font-size:13px;}
        .nsx-status-pro .nsx-status-hero-points{gap:7px;margin-top:14px;}
        .nsx-status-pro .nsx-status-hero-points span{min-height:31px;padding:0 9px;font-size:9px;}
        .nsx-status-pro .nsx-status-content{padding:26px 0 52px;}
        .nsx-status-pro .nsx-status-card,.nsx-status-pro .nsx-status-side{padding:20px;}
        .nsx-status-pro .nsx-status-card-top{flex-direction:column-reverse;gap:14px;}
        .nsx-status-pro .nsx-status-card h2{font-size:24px;}
        .nsx-status-pro .nsx-status-code{font-size:44px;}
        .nsx-status-pro .nsx-status-actions{flex-direction:column;}
        .nsx-status-pro .nsx-status-actions a{width:100%;}
    }
</style>

<section class="nsx-status-pro nsx-status-error-pro">
    <header class="nsx-status-hero">
        <div class="container">
            <div class="nsx-status-hero-copy">
                <span class="nsx-status-kicker">NSX DESTEK</span>
                <h1>Beklenmeyen bir sorun <em>oluştu.</em></h1>
                <p>İşleminiz tamamlanamadı. Birkaç dakika sonra tekrar deneyebilir veya destek ekibimize ulaşabilirsiniz.</p>
                <div class="nsx-status-hero-points" aria-label="Hata sayfası seçenekleri">
                    <span><b>✓</b> Güvenli geri dönüş</span>
                    <span><b>✓</b> Destek erişimi</span>
                    <span><b>✓</b> İşlem takibi</span>
                </div>
            </div>
        </div>
    </header>

    <section class="nsx-status-content">
        <div class="container">
            <div class="nsx-status-panel">
                <article class="nsx-status-card">
                    <div class="nsx-status-card-top">
                        <div>
                            <span class="nsx-status-card-label">SİSTEM BİLDİRİMİ</span>
                            <h2>İşlemi güvenli biçimde yeniden deneyebilirsiniz.</h2>
                        </div>
                        <strong class="nsx-status-code">500</strong>
                    </div>
                    <p>Geçici bir sistem sorunu oluşmuş olabilir. Ana sayfaya dönün, işlemi yeniden deneyin veya devam eden bir sorun varsa destek ekibimize ulaşın.</p>
                    <div class="nsx-status-actions">
                        <a class="is-primary" href="/">Ana Sayfaya Dön</a>
                        <a class="is-secondary" href="/iletisim">Destek Al</a>
                        <a class="is-secondary" href="javascript:location.reload()">Tekrar Dene</a>
                    </div>
                    @if (Model.ShowRequestId)
                    {
                        <small class="nsx-status-request">Takip kodu: <code>@Model.RequestId</code></small>
                    }
                </article>

                <aside class="nsx-status-side">
                    <span>YARDIM MERKEZİ</span>
                    <h3>Devam etmek için hızlı seçenekler.</h3>
                    <p>İşleminizi güvenli biçimde sürdürmek için aşağıdaki bölümleri kullanabilirsiniz.</p>
                    <div class="nsx-status-links">
                        <a href="/">Ana Sayfa <span>→</span></a>
                        <a href="/store">Yazılımlar <span>→</span></a>
                        <a href="/iletisim">Destek <span>→</span></a>
                        <a href="/sikca-sorulan-sorular">Sık Sorulan Sorular <span>→</span></a>
                    </div>
                </aside>
            </div>
        </div>
    </section>
</section>

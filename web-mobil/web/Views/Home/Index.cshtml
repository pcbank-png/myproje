<div class="container">
<div class="home-products-heading">
<div><span>NSX YAZILIMLARI</span><h2>Son eklenen profesyonel çözümler.</h2></div>
<a href="/store">Tüm yazılımları incele <b class="nsx-dir-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5.5 6.5 6.5L9 18.5"></path></svg></b></a>
</div>
<div class="products-grid home-products-grid" aria-live="polite">
@for (var index = 0; index < homeProducts.Count; index++)
{
    var product = homeProducts[index];
    var localizedProductName = await SiteLocalization.TranslateAsync(product.Name, currentLanguage.Code, Context.RequestAborted);
    var categoryKey = NSYazilim.Web.Services.ProductCategoryHelper.GetKey(product);
    var categoryLabel = NSYazilim.Web.Services.ProductCategoryHelper.GetLabel(product);
    var image = HomeImage(product, 720);
    var imageSrcSet = HomeImageSrcSet(product);
    var seoProfile = NSYazilim.Web.Services.ProductSeoCatalog.Find(product);
    var description = !currentLanguage.Code.StartsWith("tr", StringComparison.OrdinalIgnoreCase) && seoProfile != null
        ? seoProfile.MetaDescription
        : (string.IsNullOrWhiteSpace(product.MetaDescription)
            ? NSYazilim.Web.Services.ProductContentSanitizer.ToPlainText(product.Description, 150)
            : product.MetaDescription);
    // Yabancı dilde çeviri henüz yoksa ürünün gerçek metnini koru.
    // Sayfa sonundaki localization middleware'i native/otomatik çeviri katmanını uygular;
    // genel ve kısa bir sabit cümleye düşme yoktur.
    var localizedDescription = await SiteLocalization.TranslateAsync(description, currentLanguage.Code, Context.RequestAborted);
    var detailsOpenLabel = await SiteLocalization.TranslateAsync("detay sayfasını aç", currentLanguage.Code, Context.RequestAborted);
    var detailsViewLabel = await SiteLocalization.TranslateAsync("detaylarını gör", currentLanguage.Code, Context.RequestAborted);
    var productImageLabel = await SiteLocalization.TranslateAsync("ürün görseli", currentLanguage.Code, Context.RequestAborted);
    var productDetailsOpenAria = $"{localizedProductName} {detailsOpenLabel}";
    var productDetailsViewAria = $"{localizedProductName} {detailsViewLabel}";
    var localizedProductImageAlt = $"{localizedProductName} {productImageLabel}";
    var price = product.YearlyPrice > 0 ? product.YearlyPrice : product.LifetimePrice;
    var bestCampaign = Model.ActiveCampaigns
        .Select(campaign => new { Campaign = campaign, Discount = HomeCampaignDiscount(price, campaign) })
        .Where(x => x.Discount > 0)
        .OrderByDescending(x => x.Discount)
        .ThenByDescending(x => x.Campaign.CreatedAt)
        .FirstOrDefault();
    var discountAmount = bestCampaign?.Discount ?? 0;
    var payablePrice = Math.Max(0, price - discountAmount);
    var priceText = price <= 0
        ? "Ücretsiz"
        : payablePrice.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " ₺";
    var features = HomeProductFeatures(product);
    var ratingAverage = 0d;
    if (ViewBag.RatingAverage is System.Collections.Generic.Dictionary<int, double> ratingAverages
        && ratingAverages.TryGetValue(product.Id, out var savedRatingAverage))
    {
        ratingAverage = savedRatingAverage;
    }
    var ratingText = ratingAverage > 0 ? ratingAverage.ToString("0.0") : "Yeni";
    var cardAccent = "#ff6e04";
<article class="product-card home-product-card" data-category-key="@categoryKey" data-product-index="@index" style="--accent:@cardAccent">
<a class="product-visual" href="/urun/@product.Slug" aria-label="@productDetailsOpenAria">
<img src="@image" srcset="@imageSrcSet" sizes="(max-width:680px) calc(100vw - 36px), (max-width:1180px) 46vw, 350px" alt="@localizedProductImageAlt" width="1581" height="995" loading="lazy" decoding="async" fetchpriority="low">
<span class="product-tag">@(index == 0 ? "En yeni ürün" : categoryLabel)</span>
@if (bestCampaign != null && discountAmount > 0) { <span class="home-product-campaign-badge">@HomeCampaignLabel(bestCampaign.Campaign)</span> }
<span class="product-number">@((index + 1).ToString("00"))</span>
</a>
<div class="product-body">
<div class="product-meta">
<span>@categoryLabel</span>
<span class="rating">★★★★★ <b>@ratingText</b></span>
</div>
<h3>@localizedProductName</h3>
<p>@(string.IsNullOrWhiteSpace(localizedDescription) ? localizedProductName : localizedDescription)</p>
<ul>
@foreach (var feature in features)
{
<li><b class="nsx-public-check" aria-hidden="true">✓</b> @feature</li>
}
</ul>
<div class="product-footer">
<div class="@(discountAmount > 0 ? "home-campaign-price" : string.Empty)">
<small>@(discountAmount > 0 ? "Kampanyalı fiyat" : "Başlangıç")</small>
<strong>@priceText</strong>
@if (discountAmount > 0) { <del>@(price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " ₺")</del> }
</div>
<a class="product-cta" href="/urun/@product.Slug" aria-label="@productDetailsViewAria">
<span>Ürünü İncele</span>
<b class="nsx-dir-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5.5 6.5 6.5L9 18.5"></path></svg></b>
</a>
</div>
</div>
</article>
}
</div>


@inject NSYazilim.Web.Services.SiteLocalizationService SiteLocalization
@inject NSYazilim.Web.Services.SeoLanguageUrlService SeoLanguageUrls
@model NSYazilim.Web.ViewModels.HomePageViewModel
@{
    Layout = null;
    ViewData["UseHomePerformanceBundle"] = true;
    var currentLanguage = await SiteLocalization.GetCurrentLanguageAsync(Context.RequestAborted);
    var homeSeoLinks = await SeoLanguageUrls.BuildAsync("/", currentLanguage, Context.RequestAborted);
    var homeCanonical = homeSeoLinks.CurrentUrl;
    var localizedStorePath = await SeoLanguageUrls.BuildLocalizedReturnUrlAsync("/store", currentLanguage, Context.RequestAborted);
    var localizedSearchTarget = NSYazilim.Web.Services.SeoTextHelper.AbsoluteUrl(localizedStorePath) + "?q={search_term_string}";
    var localizedBrandName = await SiteLocalization.TranslateAsync("NSX Yazılım", currentLanguage.Code, Context.RequestAborted);
    var localizedDiscountWord = await SiteLocalization.TranslateAsync("İNDİRİM", currentLanguage.Code, Context.RequestAborted);
    var homeProducts = Model.FeaturedProducts.OrderByDescending(x => x.CreatedAt).Take(4).ToList();
    NSYazilim.Web.Models.ProductImage? HomeMainImage(NSYazilim.Web.Models.Product product)
        => product.Images.OrderByDescending(x => x.IsMain).ThenBy(x => x.SortOrder).ThenBy(x => x.Id).FirstOrDefault();

    string HomeImage(NSYazilim.Web.Models.Product product, int width = 720)
    {
        var image = HomeMainImage(product);
        if (image == null || string.IsNullOrWhiteSpace(image.ImagePath)) return "/nsx-assets/logo-brand.webp";
        if (image.ImagePath.StartsWith("/uploads/products/images/", StringComparison.OrdinalIgnoreCase))
        {
            var fileName = System.IO.Path.GetFileName(image.ImagePath);
            if (!string.IsNullOrWhiteSpace(fileName))
                return $"{NSYazilim.Web.Services.ProductThumbnailGenerator.GetRelativePath(fileName, width)}?v={image.Id}";
        }
        return image.ImagePath + (image.ImagePath.Contains('?') ? "&" : "?") + "v=" + image.Id;
    }

    string? HomeImageSrcSet(NSYazilim.Web.Models.Product product)
    {
        var image = HomeMainImage(product);
        if (image == null || string.IsNullOrWhiteSpace(image.ImagePath) || !image.ImagePath.StartsWith("/uploads/products/images/", StringComparison.OrdinalIgnoreCase))
            return null;
        var fileName = System.IO.Path.GetFileName(image.ImagePath);
        if (string.IsNullOrWhiteSpace(fileName)) return null;
        return $"{NSYazilim.Web.Services.ProductThumbnailGenerator.GetRelativePath(fileName, 480)}?v={image.Id} 480w, {NSYazilim.Web.Services.ProductThumbnailGenerator.GetRelativePath(fileName, 720)}?v={image.Id} 720w, {NSYazilim.Web.Services.ProductThumbnailGenerator.GetRelativePath(fileName, 960)}?v={image.Id} 960w";
    }


    decimal HomeCampaignDiscount(decimal amount, NSYazilim.Web.Models.Campaign campaign)
    {
        if (amount <= 0 || campaign.DiscountValue <= 0 || (campaign.MinimumCartTotal > 0 && amount < campaign.MinimumCartTotal)) return 0;
        var fixedDiscount = string.Equals(campaign.DiscountType, "Fixed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(campaign.DiscountType, "FixedAmount", StringComparison.OrdinalIgnoreCase)
            || string.Equals(campaign.DiscountType, "Amount", StringComparison.OrdinalIgnoreCase);
        return Math.Round(Math.Clamp(fixedDiscount ? campaign.DiscountValue : amount * campaign.DiscountValue / 100m, 0, amount), 2, MidpointRounding.AwayFromZero);
    }

    string HomeCampaignLabel(NSYazilim.Web.Models.Campaign campaign)
    {
        var fixedDiscount = string.Equals(campaign.DiscountType, "Fixed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(campaign.DiscountType, "FixedAmount", StringComparison.OrdinalIgnoreCase)
            || string.Equals(campaign.DiscountType, "Amount", StringComparison.OrdinalIgnoreCase);
        return fixedDiscount ? $"{campaign.DiscountValue:N0} TL {localizedDiscountWord}" : $"%{campaign.DiscountValue:N0} {localizedDiscountWord}";
    }

    string[] HomeProductFeatures(NSYazilim.Web.Models.Product product)
    {
        return NSYazilim.Web.Services.ProductCategoryHelper.GetKey(product) switch
        {
            "organizasyon" => new[] { "Rezervasyon", "Müşteri takibi", "Tahsilat yönetimi" },
            "cari" => new[] { "Cari hesaplar", "Borç ve alacak", "Raporlama" },
            "servis" => new[] { "Servis kabul", "Müşteri takibi", "İşlem geçmişi" },
            "otomotiv" => new[] { "Araç takibi", "Müşteri yönetimi", "Kârlılık raporu" },
            "klinik" => new[] { "Randevu takibi", "Hasta yönetimi", "Bildirimler" },
            "performans" => new[] { "Sistem optimizasyonu", "Performans takibi", "Kolay kullanım" },
            _ => new[] { "Kolay kullanım", "Gelişmiş takip", "Detaylı raporlar" }
        };
    }
}

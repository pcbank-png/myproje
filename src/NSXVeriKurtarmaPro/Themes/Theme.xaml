<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:NSXVeriKurtarmaPro.Infrastructure">
    <Color x:Key="NavyColor">#073A8C</Color>
    <Color x:Key="AccentColor">#0B57C9</Color>
    <Color x:Key="AccentHoverColor">#0848A8</Color>
    <Color x:Key="TextColor">#101828</Color>
    <Color x:Key="MutedTextColor">#667085</Color>
    <Color x:Key="LineColor">#E1E7EF</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="PageColor">#F6F8FB</Color>
    <Color x:Key="SuccessColor">#22B455</Color>
    <Color x:Key="WarningColor">#F79009</Color>

    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="PageBrush" Color="{StaticResource PageColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

    <!-- NSX logo-derived button palette. -->
    <Color x:Key="LogoDeepBlueColor">#003B9F</Color>
    <Color x:Key="LogoBlueColor">#0078F8</Color>
    <Color x:Key="LogoCyanColor">#00C8EE</Color>
    <SolidColorBrush x:Key="LogoDeepBlueBrush" Color="{StaticResource LogoDeepBlueColor}"/>
    <SolidColorBrush x:Key="LogoBlueBrush" Color="{StaticResource LogoBlueColor}"/>
    <SolidColorBrush x:Key="LogoCyanBrush" Color="{StaticResource LogoCyanColor}"/>
    <SolidColorBrush x:Key="LogoSoftBrush" Color="#EAF8FF"/>
    <SolidColorBrush x:Key="LogoSoftHoverBrush" Color="#DDF4FF"/>
    <SolidColorBrush x:Key="LogoSoftPressedBrush" Color="#CDEEFF"/>
    <SolidColorBrush x:Key="LogoSoftBorderBrush" Color="#A8DDF3"/>
    <LinearGradientBrush x:Key="LogoPrimaryBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#003B9F" Offset="0"/>
        <GradientStop Color="#006DE5" Offset="0.62"/>
        <GradientStop Color="#008FCA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoPrimaryHoverBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#00348B" Offset="0"/>
        <GradientStop Color="#0062CF" Offset="0.62"/>
        <GradientStop Color="#007DB2" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoPrimaryPressedBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#002C76" Offset="0"/>
        <GradientStop Color="#0053B5" Offset="0.62"/>
        <GradientStop Color="#006B99" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ReferencePrimaryBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#003B9F" Offset="0"/>
        <GradientStop Color="#006DE5" Offset="0.62"/>
        <GradientStop Color="#008FCA" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="56"/>
        <Setter Property="Margin" Value="26,3"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#182230"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EEF4FF"/>
                            <Setter Property="Foreground" Value="{StaticResource LogoDeepBlueBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DCE9FF"/>
                            <Setter Property="Foreground" Value="{StaticResource LogoDeepBlueBrush}"/>
                        </Trigger>
                        <Trigger Property="infra:NavigationAssist.IsActive" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ReferencePrimaryBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="infra:NavigationAssist.IsActive" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource LogoPrimaryHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="infra:NavigationAssist.IsActive" Value="True"/>
                                <Condition Property="IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource LogoPrimaryPressedBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="62"/>
        <Setter Property="Background" Value="{StaticResource ReferencePrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource LogoPrimaryHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource LogoPrimaryPressedBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="62"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#172B4D"/>
        <Setter Property="BorderBrush" Value="#D6DEE9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F2F6FC"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#A9BBD3"/>
                            <Setter Property="Foreground" Value="{StaticResource LogoDeepBlueBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E8EEF7"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8DA5C4"/>
                            <Setter Property="Foreground" Value="{StaticResource LogoDeepBlueBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Windows 10 uyumlu Pro pencere baslik dugmeleri: cercevesiz, golgesiz ve piksel merkezli. -->
    <Style x:Key="WindowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#171717"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Surface"
                          Background="{TemplateBinding Background}"
                          SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E5E5E5"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#CCCCCC"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseWindowButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#171717"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Surface"
                          Background="{TemplateBinding Background}"
                          SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#C50F1F"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

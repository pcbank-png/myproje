<Window x:Class="NSXVeriKurtarmaPro.RecoveryPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:infra="clr-namespace:NSXVeriKurtarmaPro.Infrastructure"
        xmlns:services="clr-namespace:NSXVeriKurtarmaPro.Services"
        Title="Dosya Önizleme"
        Width="1160" Height="828"
        MinWidth="920" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F7F9FC"
        Icon="/NSXVeriKurtarmaPro;component/Assets/logo.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="RecoveryPreviewWindow_PreviewKeyDown">

    <Window.Resources>
        <infra:LocalizedTextConverter x:Key="LocalizedTextConverter"/>
        <Style x:Key="PreviewScrollBarBaseStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <Trigger Property="IsMouseCaptureWithin" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PreviewVerticalScrollBarStyle" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PreviewScrollBarBaseStyle}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="8" Background="Transparent">
                            <Border Width="4"
                                    HorizontalAlignment="Center"
                                    Margin="0,2"
                                    Background="#E7EDF5"
                                    CornerRadius="2"/>
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="34" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBody"
                                                        Width="6"
                                                        Margin="0,2"
                                                        HorizontalAlignment="Center"
                                                        Background="#073A8C"
                                                        CornerRadius="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#0B57C9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#0B4DBB"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewHorizontalScrollBarStyle" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PreviewScrollBarBaseStyle}">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Height="8" Background="Transparent">
                            <Border Height="4"
                                    VerticalAlignment="Center"
                                    Margin="2,0"
                                    Background="#E7EDF5"
                                    CornerRadius="2"/>
                            <Track x:Name="PART_Track" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinWidth="34" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBody"
                                                        Height="6"
                                                        Margin="2,0"
                                                        VerticalAlignment="Center"
                                                        Background="#073A8C"
                                                        CornerRadius="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#0B57C9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#0B4DBB"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Border x:Name="RootBorder"
            Background="#F7F9FC"
            BorderThickness="0"
            CornerRadius="15">

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="74"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="252"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <Border Grid.Row="0"
                    Background="#F7F9FC"
                    BorderBrush="#E5ECF3"
                    BorderThickness="0,0,0,1"
                    CornerRadius="15,15,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="12" Background="#EEF4FF" VerticalAlignment="Center" BorderBrush="#D8E6FF" BorderThickness="1">
                        <TextBlock Text="{Binding TypeGlyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Foreground="#0B57C9"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                        <TextBlock Text="{Binding FileName}"
                                   FontSize="15.5"
                                   FontWeight="SemiBold"
                                   Foreground="#101828"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="LocationCaptionText"
                                   FontSize="10.8"
                                   Foreground="#667085"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                    <Binding Path="LocationText"/>
                                    <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="2" Background="#EFF3F8" BorderBrush="#D6DEE9" BorderThickness="1" CornerRadius="9" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PreviewCounterText" Text="1 / 1" FontSize="10.8" FontWeight="SemiBold" Foreground="#344054"/>
                    </Border>

                    <Border x:Name="PreviewLimitBadge" Grid.Column="3" Background="#F1ECFF" BorderBrush="#D9CCFF" BorderThickness="1" CornerRadius="9" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" FontSize="10" Foreground="#6D3BEF" Margin="0,0,5,0"/>
                            <TextBlock Text="Decoder Önizleme" FontSize="10.8" FontWeight="SemiBold" Foreground="#6D3BEF"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="4"
                            Style="{StaticResource WindowButtonStyle}"
                            VerticalAlignment="Center"
                            ToolTip="Küçült"
                            Click="Minimize_Click">
                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <Path Data="M2,8 H14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.45"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Button>
                    <Button Grid.Column="5"
                            Style="{StaticResource WindowButtonStyle}"
                            VerticalAlignment="Center"
                            ToolTip="Tam ekran / Geri yükle"
                            Click="MaximizeRestore_Click">
                        <Grid Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox x:Name="MaximizeGlyph" Width="14" Height="14" Stretch="Uniform">
                                <Path Data="M2.5,2.5 H13.5 V13.5 H2.5 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.35"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"/>
                            </Viewbox>
                            <Grid x:Name="RestoreGlyph" Visibility="Collapsed" Width="14" Height="14"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="9.5" Height="8.5"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                        BorderThickness="1.2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"/>
                                <Border Width="9.5" Height="8.5"
                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                        BorderThickness="1.2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Button>
                    <Button Grid.Column="6"
                            Style="{StaticResource CloseWindowButtonStyle}"
                            VerticalAlignment="Center"
                            ToolTip="Kapat"
                            Click="Close_Click">
                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <Path Data="M3,3 L13,13 M13,3 L3,13"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.45"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <!-- Ana önizleme -->
            <Grid x:Name="MainPreviewGrid" Grid.Row="1" Margin="18,18,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="PreviewSideColumn" Width="286"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="PrimaryPreviewBorder" Grid.Column="0" Background="#FFFFFF" CornerRadius="24" ClipToBounds="True" Margin="0,0,16,0" BorderBrush="#D6DEE9" BorderThickness="1">
                    <Grid x:Name="MediaHost" MouseLeftButtonUp="PreviewMedia_MouseLeftButtonUp" SizeChanged="MediaHost_SizeChanged">
                        <Grid x:Name="LoadingPanel" Background="#EEF2F7">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="62" Height="62" CornerRadius="31" Background="#EEF4FF" BorderBrush="#D6E4FF" BorderThickness="1">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#0B57C9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Önizleme hazırlanıyor" FontSize="14.5" FontWeight="SemiBold" Foreground="#101828" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                <TextBlock Text="Video verisi güvenli önizleme alanında çözümleniyor" FontSize="11" Foreground="#667085" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <ProgressBar IsIndeterminate="True" Width="260" Height="5" Margin="0,15,0,0" Background="#DFE7F1" Foreground="#0B57C9" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="PhotoPanel" Visibility="Collapsed" Background="Transparent">
                            <Grid x:Name="PhotoViewport"
                                  Background="Transparent"
                                  ClipToBounds="True"
                                  PreviewMouseWheel="PhotoViewport_PreviewMouseWheel"
                                  PreviewMouseLeftButtonDown="PhotoViewport_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="PhotoViewport_PreviewMouseMove"
                                  PreviewMouseLeftButtonUp="PhotoViewport_PreviewMouseLeftButtonUp"
                                  MouseLeave="PhotoViewport_MouseLeave"
                                  SizeChanged="PhotoViewport_SizeChanged">
                                <Image x:Name="PhotoPreview"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       SnapsToDevicePixels="True"
                                       UseLayoutRounding="True"
                                       RenderTransformOrigin="0.5,0.5"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="PhotoScaleTransform" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="PhotoTranslateTransform" X="0" Y="0"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>
                        </Grid>

                        <Grid x:Name="VideoPanel" Visibility="Collapsed" Background="#111827">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="64"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <vlc:VideoView x:Name="VideoView" Background="#111827">
                                    <Border x:Name="PreviewFinishedOverlay" Visibility="Collapsed" Background="#AF020617">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="62" Height="62" CornerRadius="31" Background="#E9FFFFFF">
                                                <TextBlock Text="▶" FontSize="23" Foreground="#0B57C9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Decode önizlemesi tamamlandı" Foreground="White" FontSize="13.5" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </vlc:VideoView>
                            </Grid>

                            <Border Grid.Row="1" Background="#F4F6F9" BorderBrush="#D6DEE9" BorderThickness="0,1,0,0">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PlayPauseButton" Width="36" Height="36" Background="#0B57C9" Foreground="White" BorderBrush="#0B57C9" Cursor="Hand" Click="PlayPause_Click">
                                        <Grid>
                                            <TextBlock x:Name="VideoPlayGlyph" Text="▶" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="VideoPauseGlyph" Text="Ⅱ" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                    <TextBlock x:Name="CurrentTimeText" Grid.Column="1" Text="00:00" Foreground="#344054" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Slider x:Name="PositionSlider" Grid.Column="2" Minimum="0" Maximum="10" Value="0" VerticalAlignment="Center" Margin="10,0" ValueChanged="PositionSlider_ValueChanged"/>
                                    <TextBlock x:Name="LimitTimeText" Grid.Column="3" Text="00:10" Foreground="#344054" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="UnsupportedPanel" Visibility="Collapsed" Background="#F3F6FA">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                <Border Width="62" Height="62" CornerRadius="31" Background="#F1ECFF" BorderBrush="#D9CCFF" BorderThickness="1">
                                    <TextBlock Text="{Binding TypeGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#6D3BEF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="UnsupportedTitle" Text="Önizleme kullanılamıyor" FontSize="15.5" FontWeight="SemiBold" Foreground="#101828" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                <TextBlock x:Name="UnsupportedText" Text="Dosya doğrulandı; kurtarma için hazır." FontSize="11.2" Foreground="#667085" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="RepairLoadingOverlay" Visibility="Collapsed" Background="#CC020617">
                            <Border Width="404" Padding="24" Background="#FFFFFF" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel>
                                    <Border Width="60" Height="60" CornerRadius="30" Background="#EEF4FF" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#0B57C9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="RepairLoadingTitle" Text="Medya onarılıyor" FontSize="16" FontWeight="SemiBold" Foreground="#101828" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                    <TextBlock x:Name="RepairLoadingDetail" Text="Container/codec yapısı parse ediliyor..." FontSize="11" Foreground="#667085" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,16,0,0" Foreground="#0B57C9" Background="#E7EDF5" BorderThickness="0"/>
                                    <TextBlock Text="Onarım tamamlanana kadar bu dosya üzerinde başka işlem başlatılmaz." FontSize="9.8" Foreground="#98A2B3" TextAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="PreviewSidePanel" Grid.Column="1" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D6DEE9" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PreviewVerticalScrollBarStyle}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Margin="16">
                            <Border x:Name="FileInfoCard" Background="#F8FAFC" BorderBrush="#E5ECF3" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="Dosya Bilgileri" FontSize="14" FontWeight="SemiBold" Foreground="#101828"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dosya" FontSize="10.7" Foreground="#667085"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="11" Foreground="#101828" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="1" Text="Tür" FontSize="10.7" Foreground="#667085" Margin="0,9,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" Foreground="#101828" Margin="0,9,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                    <Binding Path="Category"/>
                                                    <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Grid.Row="2" Text="Uzantı" FontSize="10.7" Foreground="#667085" Margin="0,9,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Extension}" FontSize="11" Foreground="#101828" Margin="0,9,0,0"/>
                                        <TextBlock Grid.Row="3" Text="Boyut" FontSize="10.7" Foreground="#667085" Margin="0,9,0,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SizeText}" FontSize="11" Foreground="#101828" Margin="0,9,0,0"/>
                                        <TextBlock Grid.Row="4" Text="Durum" FontSize="10.7" Foreground="#667085" Margin="0,9,0,0"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" FontSize="11" Foreground="#101828" Margin="0,9,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                    <Binding Path="EffectiveRecoveryState"/>
                                                    <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Grid.Row="5" Text="Tarih" FontSize="10.7" Foreground="#667085" Margin="0,9,0,0"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CapturedAtText}" FontSize="11" Foreground="#101828" Margin="0,9,0,0"/>
                                        <TextBlock x:Name="TechnicalInfoLabelText" Grid.Row="6" Text="Bilgi" FontSize="10.7" Foreground="#667085" Margin="0,9,0,0"/>
                                        <TextBlock x:Name="TechnicalInfoValueText" Grid.Row="6" Grid.Column="1" Text="—" FontSize="10.5" Foreground="#475467" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="RepairCard" Background="#F8FAFC" BorderBrush="#E5ECF3" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Onarma" FontSize="14" FontWeight="SemiBold" Foreground="#101828"/>
                                    <TextBlock x:Name="RepairHintText" FontSize="10.7" Foreground="#667085" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <Border x:Name="ReferenceVideoPanel" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#D6DEE9" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Reference Device Profile" FontSize="10.8" FontWeight="SemiBold" Foreground="#344054"/>
                                            <TextBlock Text="Codec profile/level, timescale, parameter-set ve container signature çıkarımı için referans stream kullanılır." FontSize="9.8" Foreground="#667085" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="ReferenceVideoStatusText" Text="Reference profile bağlı değil." FontSize="9.9" Foreground="#475467" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                                <Button x:Name="SelectReferenceVideoButton" Height="32" Padding="12,0" Background="#FFFFFF" Foreground="#0B57C9" BorderBrush="#B8C9E6" FontWeight="SemiBold" Cursor="Hand" Click="SelectReferenceVideo_Click" Content="Referans Video Seç"/>
                                                <Button x:Name="ClearReferenceVideoButton" Height="32" Padding="11,0" Margin="8,0,0,0" Background="#FFFFFF" Foreground="#667085" BorderBrush="#D0D5DD" Cursor="Hand" Click="ClearReferenceVideo_Click" Content="Temizle"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="RepairStatusBorder" Background="#F8FAFC" CornerRadius="10" Padding="10" Margin="0,12,0,0">
                                        <TextBlock x:Name="RepairStatusText" FontSize="10.6" Foreground="#475467" TextWrapping="Wrap"/>
                                    </Border>
                                    <Button x:Name="RepairButton" Height="44" Margin="0,14,0,0" Background="#EEF4FF" Foreground="#0B57C9" BorderBrush="#B8C9E6" FontWeight="SemiBold" Cursor="Hand" Click="Repair_Click" Content="Onarmayı Başlat"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Alt galeri + aksiyonlar -->
            <Border Grid.Row="2" Background="#EEF2F7" BorderBrush="#D6DEE9" BorderThickness="0,1,0,0" CornerRadius="0,0,15,15">
                <Grid Margin="18,12,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="136"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Sonraki Dosyalar" FontSize="13.8" FontWeight="SemiBold" Foreground="#101828"/>
                            <TextBlock x:Name="StripInfoText" Text=" • 0 öğe" FontSize="11.3" Foreground="#667085" Margin="7,1,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="StripSelectionText" Grid.Column="1" VerticalAlignment="Center" FontSize="10.8" Foreground="#475467" Text="Seçim 1 / 1"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D6DEE9" BorderThickness="1" CornerRadius="14" Padding="10,8,10,10">
                        <ScrollViewer x:Name="PreviewStripScrollViewer"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      PanningMode="None"
                                      Height="102"
                                      PreviewMouseWheel="PreviewStripScrollViewer_PreviewMouseWheel"
                                      SizeChanged="PreviewStripScrollViewer_SizeChanged">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PreviewHorizontalScrollBarStyle}"/>
                            </ScrollViewer.Resources>
                            <StackPanel x:Name="PreviewStripPanel" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="188"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Border Background="#F4F6F9" CornerRadius="8" Padding="9,4" BorderBrush="#D6DEE9" BorderThickness="1">
                                <TextBlock Text="{Binding Extension}" FontSize="10.2" FontWeight="Bold" Foreground="#344054"/>
                            </Border>
                            <TextBlock Text="{Binding SizeText}" FontSize="10.7" Foreground="#667085" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBlock Text="•" FontSize="10.7" Foreground="#98A2B3" VerticalAlignment="Center" Margin="7,0"/>
                            <TextBlock Text="{Binding ResolutionText}" FontSize="10.7" Foreground="#667085" VerticalAlignment="Center"/>
                            <TextBlock Text="•" FontSize="10.7" Foreground="#98A2B3" VerticalAlignment="Center" Margin="7,0"/>
                            <TextBlock FontSize="10.7" Foreground="#667085" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                        <Binding Path="EffectiveRecoveryState"/>
                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <Button x:Name="RecoverButton"
                                Grid.Column="1"
                                Height="42"
                                Style="{StaticResource PrimaryButtonStyle}"
                                FontSize="13"
                                BorderThickness="0"
                                Click="Recover_Click"
                                Content="Bu Dosyayı Kurtar"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

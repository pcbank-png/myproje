<Window x:Class="NSXVeriKurtarmaPro.ScanCompletedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarama Tamamlandı"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown">
    <Grid Background="#720F172A">
        <Border Width="560"
                MinHeight="430"
                Padding="28,25,28,24"
                Background="White"
                BorderBrush="#DDE6F1"
                BorderThickness="1"
                CornerRadius="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#14243A" BlurRadius="34" ShadowDepth="8" Opacity="0.28"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource CloseWindowButtonStyle}"
                        ToolTip="Kapat"
                        Click="StayButton_Click">
                    <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <Path Data="M3,3 L13,13 M13,3 L3,13"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1"
                              StrokeStartLineCap="Square"
                              StrokeEndLineCap="Square"
                              SnapsToDevicePixels="True"/>
                    </Grid>
                </Button>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <Grid Width="78" Height="78">
                        <Ellipse Fill="#EAF7EF"/>
                        <Ellipse Width="56" Height="56" Fill="#D4F1DF"/>
                        <Path Data="M 20,39 L 32,51 L 58,25"
                              Stroke="#169B50" StrokeThickness="6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                    <TextBlock x:Name="TitleText" Margin="0,15,0,0"
                               FontSize="19" FontWeight="SemiBold" Foreground="#101828"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="SubtitleText" Margin="0,5,0,0" Width="450"
                               FontSize="11.5" Foreground="#667085" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,20,0,0" Background="#F6F8FB" CornerRadius="12" Padding="0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="FoundCountText" FontSize="20" FontWeight="Bold" Foreground="#101828" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="FoundLabelText" Margin="0,3,0,0" FontSize="10.5" Foreground="#667085" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#DDE3EA" Margin="0,0"/>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock x:Name="FoundSizeText" FontSize="20" FontWeight="Bold" Foreground="#101828" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SizeLabelText" Margin="0,3,0,0" FontSize="10.5" Foreground="#667085" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="3" Background="#DDE3EA" Margin="0,0"/>
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <TextBlock x:Name="ElapsedText" FontSize="20" FontWeight="Bold" Foreground="#101828" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ElapsedLabelText" Margin="0,3,0,0" FontSize="10.5" Foreground="#667085" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="0,16,0,0" Background="#EAF2FF" BorderBrush="#D2E3FC" BorderThickness="1" CornerRadius="10" Padding="12,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="17" Height="17" CornerRadius="9" Background="#18A957" VerticalAlignment="Center">
                            <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="QualityText" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#0B57C9" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="RetentionText" Grid.Row="3" Margin="0,11,0,0"
                           FontSize="10.2" Foreground="#7A889A" TextAlignment="Center" TextWrapping="Wrap"/>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,19,0,0">
                    <Button x:Name="StayButton" Width="142" Height="40" Margin="0,0,10,0"
                            Background="White" BorderBrush="#CCD6E2" BorderThickness="1" Foreground="#344054"
                            FontWeight="SemiBold" Cursor="Hand" Click="StayButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F5F7FA"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="RecoveryButton" Width="154" Height="40"
                            Background="{StaticResource LogoPrimaryBrush}" BorderThickness="0" Foreground="White"
                            FontWeight="SemiBold" Cursor="Hand" Click="RecoveryButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource LogoPrimaryHoverBrush}"/></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

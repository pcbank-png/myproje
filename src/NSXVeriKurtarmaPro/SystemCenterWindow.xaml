<Window x:Class="NSXVeriKurtarmaPro.SystemCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:NSXVeriKurtarmaPro.Infrastructure"
        Title="NSX Sistem Merkezi"
        Width="930"
        Height="690"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SystemNavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#42526B"/>
            <Setter Property="BorderBrush" Value="#DFE5ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LogoSoftHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LogoSoftBorderBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource LogoBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LogoSoftPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="infra:NavigationAssist.IsActive" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LogoPrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LogoBlueBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="infra:NavigationAssist.IsActive" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LogoPrimaryHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LogoPrimaryHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SystemCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#172B4D"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CompactPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="145"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{StaticResource LogoPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LogoPrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LogoPrimaryPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="BorderBrush" Value="#D7DEE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F4F7FB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#AFC1DA"/>
                                <Setter Property="Foreground" Value="{StaticResource LogoBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E9EFF7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactDangerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#C9362B"/>
            <Setter Property="BorderBrush" Value="#F0B8B4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF2F1"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E99A94"/>
                                <Setter Property="Foreground" Value="#B42318"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FDE8E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProSettingsSwitchStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="24">
                            <Border x:Name="Track" Background="#D6DEE9" CornerRadius="12"/>
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#24405F" BlurRadius="5" ShadowDepth="1" Opacity="0.18"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource LogoPrimaryBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="0,11"/>
            <Setter Property="BorderBrush" Value="#EDF1F5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#EEF4FF"/>
            <Setter Property="BorderBrush" Value="#D5E4FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>
    </Window.Resources>

    <Border Background="#F7F9FC"
            BorderBrush="#D9E1EC"
            BorderThickness="1"
            CornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="66"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <!-- Ortak baslik -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E5EAF1" BorderThickness="0,0,0,1" CornerRadius="15,15,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#EEF4FF" Margin="0,0,10,0">
                            <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#0B57C9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NSX Sistem Merkezi" Foreground="#172B4D" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Lisans, güncelleme, ayarlar ve ürün bilgileri" Foreground="#7A869A" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="2,0,10,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource CloseWindowButtonStyle}"
                            ToolTip="Kapat"
                            Click="CloseButton_Click">
                        <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path Data="M3,3 L13,13 M13,3 L3,13"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square"
                                  SnapsToDevicePixels="True"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- Her sayfada ayni kalan navigasyon -->
            <Border Grid.Row="1" Background="#FBFCFE" BorderBrush="#E7ECF2" BorderThickness="0,0,0,1">
                <Grid Margin="24,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LicenseNavButton" Grid.Column="0" Style="{StaticResource SystemNavButtonStyle}" Click="LicenseNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lisans" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UpdateNavButton" Grid.Column="1" Style="{StaticResource SystemNavButtonStyle}" Click="UpdateNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Güncelleme" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AboutNavButton" Grid.Column="2" Style="{StaticResource SystemNavButtonStyle}" Click="AboutNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Hakkında" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNavButton" Grid.Column="3" Style="{StaticResource SystemNavButtonStyle}" Click="SettingsNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ayarlar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="4" Text="ESC: Kapat" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#98A2B3" FontSize="11"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <!-- LISANS -->
                <Grid x:Name="LicensePage">
                    <StackPanel Margin="28,8,28,8" VerticalAlignment="Top">
                        <Grid Margin="0,4,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Lisans Merkezi" Foreground="#101828" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="Ürün lisansınızı tek bir ekrandan yönetin ve doğrulama durumunu izleyin." Foreground="#667085" FontSize="13" Margin="0,7,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#FFF7E6" BorderBrush="#F6D68A" BorderThickness="1" CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="LicenseBadgeDot" Width="7" Height="7" Fill="#F79009" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LicenseBadgeText" Text="Lisans durumu" Foreground="#9A6700" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource SystemCardStyle}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" Background="#EEF4FF" CornerRadius="12" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#0B57C9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Lisans durumu" Foreground="#172B4D" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LicenseStatusText" Text="Lisans durumu hazırlanıyor..." Foreground="#667085" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SystemCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Ürün" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock x:Name="LicenseProductNameText" Text="NSX Veri Kurtarma Pro" Style="{StaticResource InfoValueStyle}"/>
                                    <TextBlock Text="NSXDATARECOVERYPRO" Foreground="#98A2B3" FontSize="10.5" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SystemCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Mevcut sürüm" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock x:Name="LicenseVersionText" Text="1.3.0" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource SystemCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Lisans doğrulama bilgileri" Foreground="#172B4D" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Lisans, satın alma sırasında kullanılan e-posta adresi ile lisans anahtarının eşleşmesiyle doğrulanır." Foreground="#667085" FontSize="12" Margin="0,4,0,9" TextWrapping="Wrap"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="E-posta adresi" Foreground="#475467" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <TextBox x:Name="LicenseEmailBox"
                                                 Height="40"
                                                 Padding="12,7"
                                                 FontSize="14"
                                                 VerticalContentAlignment="Center"
                                                 BorderBrush="#D7DEE8"
                                                 BorderThickness="1"
                                                 Background="#FCFDFE"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Lisans anahtarı" Foreground="#475467" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <PasswordBox x:Name="LicenseKeyBox"
                                                     Height="40"
                                                     Padding="12,7"
                                                     FontSize="14"
                                                     VerticalContentAlignment="Center"
                                                     BorderBrush="#D7DEE8"
                                                     BorderThickness="1"
                                                     Background="#FCFDFE"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="LicenseActionStatusText" Text="Çevrimiçi doğrulama için e-posta adresi ve lisans anahtarı bekleniyor." Foreground="#7A869A" FontSize="12" Margin="0,8,0,8" TextWrapping="Wrap"/>
                                <Grid HorizontalAlignment="Right" Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="RefreshLicenseButton"
                                            Grid.Column="0"
                                            Style="{StaticResource CompactSecondaryButtonStyle}"
                                            MinWidth="172"
                                            Padding="16,0"
                                            FontSize="12"
                                            Margin="0,0,8,0"
                                            Click="RefreshLicenseButton_Click">Lisans Bilgisini Yenile</Button>
                                    <Button x:Name="CancelLicenseButton"
                                            Grid.Column="1"
                                            Style="{StaticResource CompactDangerButtonStyle}"
                                            MinWidth="136"
                                            Padding="14,0"
                                            FontSize="12"
                                            Margin="0,0,8,0"
                                            Click="CancelLicenseButton_Click">Lisansı İptal Et</Button>
                                    <Button x:Name="VerifyLicenseButton"
                                            Grid.Column="2"
                                            Style="{StaticResource CompactPrimaryButtonStyle}"
                                            MinWidth="150"
                                            Padding="16,0"
                                            FontSize="12"
                                            Click="VerifyLicenseButton_Click">Lisansı Doğrula</Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- GUNCELLEME -->
                <Grid x:Name="UpdatePage" Visibility="Collapsed">
                    <StackPanel Margin="28,14,28,14" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Güncelleme Merkezi" Foreground="#101828" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="Sürüm bilgilerini kontrol edin ve yeni paketler hazır olduğunda güvenli şekilde güncelleyin." Foreground="#667085" FontSize="13" Margin="0,7,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#EEF4FF" BorderBrush="#D5E4FF" BorderThickness="1" CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="UpdateBadgeDot" Width="7" Height="7" Fill="#0B57C9" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="UpdateBadgeText" Text="Sürüm bilgisi" Foreground="#0B57C9" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource SystemCardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" Background="#EEF4FF" CornerRadius="12" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#0B57C9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Güncelleme durumu" Foreground="#172B4D" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="UpdateStatusText" Text="Güncelleme sunucusu bağlantıya hazır." Foreground="#667085" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="CheckUpdatesButton" Grid.Column="2"
                                        Style="{StaticResource CompactPrimaryButtonStyle}"
                                        Width="176"
                                        MinWidth="0"
                                        Padding="10,0"
                                        FontSize="12"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="CheckUpdatesButton_Click">Güncellemeleri Denetle</Button>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SystemCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Mevcut sürüm" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock x:Name="UpdateVersionText" Text="1.3.0" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SystemCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Paket durumu" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock x:Name="UpdatePackageStatusText" Text="Kontrol edilmedi" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource SystemCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Son kontrol" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock x:Name="UpdateLastCheckText" Text="Henüz denetlenmedi" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource SystemCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#516B90" VerticalAlignment="Top" Margin="2,2,0,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Güvenli güncelleme yapısı" Foreground="#172B4D" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Güncelleme kontrolü ürün sürümünü değiştirmez. Yeni paket bulunduğunda indirme ve kurulum adımları kullanıcı onayıyla başlatılır." Foreground="#667085" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- AYARLAR -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,14,28,14">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Ayarlar" Foreground="#101828" FontSize="24" FontWeight="SemiBold"/>
                                    <TextBlock Text="Arayüz, önizleme ve bağlı aygıt davranışlarını güvenli biçimde yönetin." Foreground="#667085" FontSize="13" Margin="0,7,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#ECFDF3" BorderBrush="#ABEFC6" BorderThickness="1" CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="#17B26A" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Anında kaydedilir" Foreground="#067647" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SystemCardStyle}" Padding="18,15">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Width="36" Height="36" Background="{StaticResource LogoSoftHoverBrush}" CornerRadius="10" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE737;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource LogoBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Başlangıç ve pencere" Foreground="#172B4D" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="Çalışma alanını ve pencere yerleşimini yönetin." Foreground="#667085" FontSize="11.5" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Style="{StaticResource SettingsRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="Açılışta çalışma alanını doldur" Foreground="#344054" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Programı görev çubuğunu kapatmadan kullanılabilir ekran alanına sığdırır." Foreground="#7A869A" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox x:Name="StartInWorkAreaToggle" Grid.Column="1" Style="{StaticResource ProSettingsSwitchStyle}" VerticalAlignment="Center" Click="SettingsToggle_Click"/>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource SettingsRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="Ana pencere boyutunu hatırla" Foreground="#344054" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Normal pencere konumu ve boyutu sonraki açılış için korunur." Foreground="#7A869A" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox x:Name="RememberMainWindowToggle" Grid.Column="1" Style="{StaticResource ProSettingsSwitchStyle}" VerticalAlignment="Center" Click="SettingsToggle_Click"/>
                                            </Grid>
                                        </Border>

                                        <Border Padding="0,11,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="Önizleme boyutunu hatırla" Foreground="#344054" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Dosya önizleme penceresi son kullandığınız boyut ve konumla açılır." Foreground="#7A869A" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox x:Name="RememberPreviewWindowToggle" Grid.Column="1" Style="{StaticResource ProSettingsSwitchStyle}" VerticalAlignment="Center" Click="SettingsToggle_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource SystemCardStyle}" Padding="18,15">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Width="36" Height="36" Background="#ECF7FF" CornerRadius="10" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#008BD2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Aygıtlar ve sonuçlar" Foreground="#172B4D" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="Bağlı diskler ve sonuç önizlemeleri için davranışlar." Foreground="#667085" FontSize="11.5" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Style="{StaticResource SettingsRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="Bağlı aygıtları otomatik yenile" Foreground="#344054" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="USB, HDD, SSD ve kart takma/çıkarma değişikliklerini otomatik algılar." Foreground="#7A869A" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox x:Name="AutoRefreshDevicesToggle" Grid.Column="1" Style="{StaticResource ProSettingsSwitchStyle}" VerticalAlignment="Center" Click="SettingsToggle_Click"/>
                                            </Grid>
                                        </Border>

                                        <Border Padding="0,11,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="Küçük resimleri otomatik hazırla" Foreground="#344054" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Sonuçlarda fotoğraf ve video küçük resimlerini arka planda hazırlar." Foreground="#7A869A" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox x:Name="AutoGenerateThumbnailsToggle" Grid.Column="1" Style="{StaticResource ProSettingsSwitchStyle}" VerticalAlignment="Center" Click="SettingsToggle_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource SystemCardStyle}" Padding="18,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" Background="#ECFDF3" CornerRadius="10" VerticalAlignment="Top">
                                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#079455" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Pro güvenlik korumaları" Foreground="#172B4D" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Kritik veri güvenliği kuralları kullanıcı tarafından kapatılamaz." Foreground="#667085" FontSize="11.5" Margin="0,4,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Border Background="#ECFDF3" BorderBrush="#ABEFC6" BorderThickness="1" CornerRadius="8" Padding="9,5" Margin="0,0,8,0">
                                                <TextBlock Text="Kaynak aygıt salt okunur" Foreground="#067647" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#ECFDF3" BorderBrush="#ABEFC6" BorderThickness="1" CornerRadius="8" Padding="9,5">
                                                <TextBlock Text="Aynı fiziksel diske kurtarma engeli" Foreground="#067647" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#F2F4F7" CornerRadius="8" Padding="9,5" VerticalAlignment="Top">
                                        <TextBlock Text="Zorunlu" Foreground="#475467" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid>
                                <TextBlock Text="Ayar değişiklikleri otomatik kaydedilir ve uygun olanlar anında uygulanır." Foreground="#7A869A" FontSize="11.5" VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right" Style="{StaticResource CompactSecondaryButtonStyle}" MinWidth="170" Click="ResetSettingsButton_Click">Varsayılan Ayarlara Dön</Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- HAKKINDA -->
                <Grid x:Name="AboutPage" Visibility="Collapsed">
                    <StackPanel Margin="28,14,28,14" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Hakkında" Foreground="#101828" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="Ürün, sürüm ve platform bilgileri" Foreground="#667085" FontSize="13" Margin="0,7,0,0"/>
                        </StackPanel>

                        <Border Style="{StaticResource SystemCardStyle}" Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="68" Background="#F8FAFD" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <Image x:Name="AboutLogoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="NSX Veri Kurtarma Pro" Foreground="#101828" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="USB, HDD, SSD, SD ve microSD veri kurtarma platformu." Foreground="#667085" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AboutVersionLineText" Text="Sürüm 1.3.0" Foreground="#0B57C9" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SystemCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Ürün" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Text="NSX Veri Kurtarma Pro" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SystemCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Sürüm" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock x:Name="AboutVersionText" Text="1.3.0" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource SystemCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Geliştirici" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Text="NSX Yazılım" Style="{StaticResource InfoValueStyle}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource SystemCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Desteklenen depolama aygıtları" Foreground="#172B4D" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Border Style="{StaticResource ChipStyle}"><TextBlock Text="USB Bellek" Foreground="#315B94" FontSize="12" FontWeight="SemiBold"/></Border>
                                    <Border Style="{StaticResource ChipStyle}"><TextBlock Text="HDD" Foreground="#315B94" FontSize="12" FontWeight="SemiBold"/></Border>
                                    <Border Style="{StaticResource ChipStyle}"><TextBlock Text="SSD" Foreground="#315B94" FontSize="12" FontWeight="SemiBold"/></Border>
                                    <Border Style="{StaticResource ChipStyle}"><TextBlock Text="SD / microSD" Foreground="#315B94" FontSize="12" FontWeight="SemiBold"/></Border>
                                </WrapPanel>
                                <Border Height="1" Background="#E9EDF3" Margin="0,4,0,8"/>
                                <TextBlock Text="Telif Hakkı © 2026 NSX Yazılım. Tüm hakları saklıdır." Foreground="#7A869A" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Ortak footer -->
            <Border Grid.Row="3" Background="White" BorderBrush="#E5EAF1" BorderThickness="0,1,0,0" CornerRadius="0,0,15,15">
                <Grid Margin="24,0">
                    <TextBlock x:Name="FooterPageHintText" Text="Lisans yönetimi" Foreground="#7A869A" FontSize="12" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CompactSecondaryButtonStyle}" Click="CloseButton_Click">Kapat</Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

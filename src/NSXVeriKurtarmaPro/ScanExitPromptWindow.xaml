<Window x:Class="NSXVeriKurtarmaPro.ScanExitPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarama Uyarısı"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown">
    <Grid Background="#720F172A">
        <Border Width="560" MinHeight="390" Padding="28,24,28,24"
                Background="White" BorderBrush="#DDE6F1" BorderThickness="1" CornerRadius="18"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#14243A" BlurRadius="34" ShadowDepth="8" Opacity="0.28"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource CloseWindowButtonStyle}"
                        ToolTip="Kapat"
                        Click="CancelButton_Click">
                    <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <Path Data="M3,3 L13,13 M13,3 L3,13"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1"
                              StrokeStartLineCap="Square"
                              StrokeEndLineCap="Square"
                              SnapsToDevicePixels="True"/>
                    </Grid>
                </Button>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <Grid Width="72" Height="72">
                        <Ellipse Fill="#FFF3D6"/>
                        <Ellipse Width="52" Height="52" Fill="#FFE3A0"/>
                        <TextBlock Text="!" FontSize="31" FontWeight="Bold" Foreground="#CC7A00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="TitleText" Margin="0,14,0,0" Width="455"
                               FontSize="17" FontWeight="SemiBold" Foreground="#101828"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,18,0,0" Background="#F6F8FB" CornerRadius="12" Padding="0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="FoundCountText" FontSize="20" FontWeight="Bold" Foreground="#101828" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="FoundLabelText" Margin="0,3,0,0" FontSize="10.5" Foreground="#667085" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#DDE3EA"/>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock x:Name="SecondaryValueText" FontSize="20" FontWeight="Bold" Foreground="#101828" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SecondaryLabelText" Margin="0,3,0,0" FontSize="10.5" Foreground="#667085" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="0,15,0,0" Padding="12,10" Background="#FFF9ED" BorderBrush="#F9E4B7" BorderThickness="1" CornerRadius="10">
                    <TextBlock x:Name="DetailText" FontSize="10.7" Foreground="#73510D" TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button x:Name="ConfirmButton" MinWidth="150" Height="40" Padding="18,0" Margin="0,0,10,0"
                            Background="#FFF0F0" BorderBrush="#FFCACA" BorderThickness="1" Foreground="#D92D20"
                            FontWeight="SemiBold" Cursor="Hand" Click="ConfirmButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FFE4E4"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="CancelButton" MinWidth="150" Height="40" Padding="18,0"
                            Background="{StaticResource LogoPrimaryBrush}" BorderThickness="0" Foreground="White"
                            FontWeight="SemiBold" Cursor="Hand" Click="CancelButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource LogoPrimaryHoverBrush}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

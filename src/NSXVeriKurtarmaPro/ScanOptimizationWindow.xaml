<Window x:Class="NSXVeriKurtarmaPro.ScanOptimizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dosyalar optimize ediliyor"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="CenterOwner">
    <Border Background="White" BorderBrush="#C8DDF4" BorderThickness="1" CornerRadius="16" Padding="30">
        <StackPanel>
            <TextBlock x:Name="Heading" Text="Dosyalar optimize ediliyor"
                       FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold" Foreground="#12345A"/>
            <TextBlock x:Name="Explanation" Margin="0,12,0,18" TextWrapping="Wrap"
                       FontSize="13" Foreground="#66758B"
                       Text="Tarama sonuçları hazırlanıyor. Dosya listesi ve klasör ağacı hazır olduğunda bu pencere kapanacak."/>
            <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                       FontSize="32" FontWeight="SemiBold" Foreground="#007AE8" Margin="0,0,0,10"/>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                         Height="10" Foreground="#0089ED" Background="#EAF2FB" BorderThickness="0"/>
            <TextBlock Text="{Binding ProgressDetail}" TextWrapping="Wrap"
                       FontSize="12" Foreground="#53657E" Margin="0,15,0,8"/>
            <TextBlock Text="{Binding ProgressProcessedText}" FontSize="12" Foreground="#7A8AA0"/>
        </StackPanel>
    </Border>
</Window>

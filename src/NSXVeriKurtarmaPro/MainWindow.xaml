                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScanActionGroupPrimaryStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Width" Value="208"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource LogoBlueBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimarySurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#0049B9" BlurRadius="13" ShadowDepth="2" Opacity="0.24"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimarySurface" Property="Background" Value="{StaticResource LogoPrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimarySurface" Property="Background" Value="{StaticResource LogoPrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimarySurface" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Ust sag sistem menuleri: dil, tarama oturumu ve ana uygulama menusu. -->
        <Style x:Key="TopBarMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#3C4A5D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TopBarSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TopBarSurface" Property="Background" Value="{StaticResource LogoSoftHoverBrush}"/>
                                <Setter TargetName="TopBarSurface" Property="BorderBrush" Value="{StaticResource LogoSoftBorderBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource LogoBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TopBarSurface" Property="Background" Value="{StaticResource LogoSoftPressedBrush}"/>
                                <Setter TargetName="TopBarSurface" Property="BorderBrush" Value="{StaticResource LogoBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopBarLanguageButtonStyle" TargetType="Button" BasedOn="{StaticResource TopBarMenuButtonStyle}">
            <Setter Property="Width" Value="124"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DCE5F0"/>
        </Style>

        <Style x:Key="TopBarSessionButtonStyle" TargetType="Button" BasedOn="{StaticResource TopBarMenuButtonStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Background" Value="{StaticResource LogoSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LogoSoftBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource LogoBlueBrush}"/>
        </Style>

        <Style x:Key="TopBarHamburgerButtonStyle" TargetType="Button" BasedOn="{StaticResource TopBarMenuButtonStyle}">
            <Setter Property="Width" Value="40"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootShell"
            Margin="0"
            Background="#F6F8FB"
            CornerRadius="0"
            BorderBrush="Transparent"
            BorderThickness="0">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#F4F7FD"
                    BorderBrush="#DCE4EE"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Yeni yatay NSX wordmark: title bar icinde optik olarak ortali, oran bozulmadan net render edilir. -->
                    <Image x:Name="BrandLogoImage" Grid.Column="0"
                           Source="/NSXVeriKurtarmaPro;component/Assets/logo_ui.png"
                           Height="50"
                           MaxWidth="255"
                           Margin="0,1,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Dinamik dil menusu: program ana dizinindeki Languages klasorunu okur. -->
                        <Button x:Name="LanguageMenuButton"
                                Style="{StaticResource TopBarLanguageButtonStyle}"
                                ToolTip="Dil Seçiniz"
                                Click="LanguageMenuButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource RecoveryContextMenuStyle}" Width="248"/>
                            </Button.ContextMenu>
                            <Grid Margin="10,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="22" Height="15"
                                        CornerRadius="3"
                                        BorderBrush="#D7E0EA"
                                        BorderThickness="1"
                                        Background="#F6F8FB"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Image x:Name="CurrentLanguageFlag" Stretch="UniformToFill" SnapsToDevicePixels="True"/>
                                        <TextBlock x:Name="CurrentLanguageFallbackGlyph"
                                                   Text="&#xE774;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11"
                                                   Foreground="#5B6B80"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="LanguageButtonLabel"
                                           Grid.Column="1"
                                           Text="Dil Seçiniz"
                                           FontSize="10.8"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center"
                                           Margin="7,0,3,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2"
                                           Text="&#xE70D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="#738198"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Madde 9: .nsx tarama oturumunu kaydet / yukle. -->
                        <Button x:Name="SessionMenuButton"
                                Style="{StaticResource TopBarSessionButtonStyle}"
                                ToolTip="Tarama Oturumu"
                                Click="SessionMenuButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource RecoveryContextMenuStyle}" Width="272">
                                    <MenuItem Header="Tarama Oturumunu Kaydet"
                                              Style="{StaticResource RecoveryContextMenuItemStyle}"
                                              Click="SaveSessionMenuItem_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#0B57C9"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Tarama Oturumunu Yükle"
                                              Style="{StaticResource RecoveryContextMenuItemStyle}"
                                              Click="LoadSessionMenuItem_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#0B57C9"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                        </Button>

                        <Button x:Name="MainMenuButton"
                                Style="{StaticResource TopBarHamburgerButtonStyle}"
                                ToolTip="Ana Menü"
                                Click="MainMenuButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource RecoveryContextMenuStyle}" Width="248">
                                    <MenuItem Header="Lisans" Style="{StaticResource RecoveryContextMenuItemStyle}" Click="LicenseMenuItem_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#516B90"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Güncellemeleri Denetle" Style="{StaticResource RecoveryContextMenuItemStyle}" Click="UpdateMenuItem_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#516B90"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Margin="8,5" Background="#E7ECF2"/>
                                    <MenuItem Header="Ayarlar" Style="{StaticResource RecoveryContextMenuItemStyle}" Click="SettingsMenuItem_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#516B90"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Hakkında" Style="{StaticResource RecoveryContextMenuItemStyle}" Click="AboutMenuItem_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#516B90"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Margin="8,5" Background="#E7ECF2"/>
                                    <MenuItem Header="Çıkış" Style="{StaticResource RecoveryContextMenuItemStyle}" Click="ExitMenuItem_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#B42318"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                        </Button>

                        <Button Style="{StaticResource WindowButtonStyle}" Margin="8,0,2,0" ToolTip="Küçült" Click="Minimize_Click">
                            <Viewbox Width="15" Height="15" Stretch="Uniform">
                                <Path Data="M2,9 H14"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource WindowButtonStyle}" ToolTip="Tam ekran sabit" Click="Maximize_Click">
                            <Viewbox Width="15" Height="15" Stretch="Uniform">
                                <Path Data="M2.5,2.5 H13.5 V13.5 H2.5 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.4"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"/>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource CloseWindowButtonStyle}" ToolTip="Kapat" Click="Close_Click">
                            <Viewbox Width="15" Height="15" Stretch="Uniform">
                                <Path Data="M3,3 L13,13 M13,3 L3,13"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.55"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- Referanstaki ilk ekran: sol navigasyon kopyalanmaz; yalnız orta seçim yapısı kullanılır. -->
                <Grid x:Name="LandingWorkspace">
                    <Border Margin="14" Background="#FFFFFF" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="12">
                        <Grid Margin="26,24,26,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="84"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Kayıp verileri aramak için bir konum seçin" FontSize="22" FontWeight="SemiBold" Foreground="#101828"/>
                                    <TextBlock Text="Disk, bölüm veya belirli bir konum seçin. Kaynak aygıt yalnızca okunur." FontSize="12.5" Foreground="#667085" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="22,0,0,0"
                                        Padding="4"
                                        Background="#F8FAFD"
                                        BorderBrush="#E3E9F1"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource LandingHeaderActionButtonStyle}"
                                                Command="{Binding RefreshDevicesCommand}"
                                                ToolTip="Sürücü listesini yenile">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="27" Height="27" CornerRadius="8" Background="#F2F4F7" Margin="0,0,8,0">
                                                    <TextBlock Text="&#xE72C;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Yenile" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="Dahili ve bağlı sürücüler" FontSize="12" Foreground="#667085" Margin="0,22,0,10"/>

                            <ScrollViewer x:Name="DeviceScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Devices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource LandingDeviceCardStyle}"
                                                    Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Grid Margin="16,14" Background="Transparent" IsHitTestVisible="False">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="106"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="28"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="108"
                                                          Height="108"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left">
                                                        <Image Source="{Binding DeviceImageSource}"
                                                               Width="104"
                                                               Height="104"
                                                               Stretch="Uniform"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                                        <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="#101828" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                                    <Binding Path="DisplayName"/>
                                                                    <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock FontSize="11.3" Foreground="#667085" Margin="0,5,0,0" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                                    <Binding Path="CapacityText"/>
                                                                    <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <ProgressBar Style="{StaticResource RoundedProgressStyle}" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}" Height="6" Margin="0,10,0,0"/>
                                                        <TextBlock FontSize="10.2" Foreground="#98A2B3" Margin="0,6,0,0" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                                    <Binding Path="SpaceText"/>
                                                                    <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock Margin="0,4,0,0"
                                                                   Visibility="{Binding HasHealthInfo, Converter={StaticResource BoolToVisibility}}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontSize" Value="11"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Foreground" Value="#0B57C9"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HealthSeverity}" Value="2">
                                                                            <Setter Property="Foreground" Value="#B76E00"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HealthSeverity}" Value="3">
                                                                            <Setter Property="Foreground" Value="#B42318"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                                    <Binding Path="HealthText"/>
                                                                    <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Width="20" Height="20" CornerRadius="10" Background="#1677FF" VerticalAlignment="Top" Margin="0,2,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="✓" FontSize="11.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" Margin="2,0,18,0">
                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="#475467">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                        <Binding Path="StatusTitle"/>
                                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                    <TextBlock FontSize="9.5" Foreground="#98A2B3" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                        <Binding Path="StatusDetail"/>
                                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                    <TextBlock FontSize="9.2" Foreground="#7E8EA5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                        <Binding Path="SelectedDeviceText"/>
                                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="#F8FBFF"
                                        BorderBrush="#C8DAF2"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="5"
                                        VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#17324D" BlurRadius="14" ShadowDepth="2" Opacity="0.10"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ScanActionGroupPrimaryStyle}"
                                                Width="270"
                                                Command="{Binding StartScanCommand}"
                                                ToolTip="Kayıp Veri Taraması: özgün yol metadata’sı + ham veri analizi tek otomatik akışta">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="34" Height="34" CornerRadius="9" Background="#2CFFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" Margin="0,0,11,0">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#03275E" BlurRadius="7" ShadowDepth="1" Opacity="0.28"/>
                                                    </Border.Effect>
                                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Kayıp Verileri Tara" Foreground="White" FontWeight="SemiBold" FontSize="11.8"/>
                                                    <TextBlock Text="Akıllı dengeli tarama • tüm veri türleri" Foreground="#E6F0FF" FontSize="8.9" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Tarama / sonuç alanı: referanstaki YOL / TÜR sol navigasyonu globaldir. -->
                <Grid x:Name="RecoveryWorkspace" Visibility="Collapsed" DataContext="{x:Null}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="RecoveryNavigationColumn" Width="250" MinWidth="58" MaxWidth="560"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="292"/>
                    </Grid.ColumnDefinitions>

                    <GridSplitter x:Name="NavigationResizeSplitter"
                                  Grid.Column="0"
                                  Width="8"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Stretch"
                                  Margin="0"
                                  Background="Transparent"
                                  ResizeDirection="Columns"
                                  ResizeBehavior="CurrentAndNext"
                                  ShowsPreview="False"
                                  Cursor="SizeWE"
                                  DragCompleted="NavigationResizeSplitter_DragCompleted"
                                  Panel.ZIndex="10">
                        <GridSplitter.Style>
                            <Style TargetType="GridSplitter">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridSplitter">
                                            <Border Background="Transparent">
                                                <Border Width="2"
                                                        HorizontalAlignment="Center"
                                                        CornerRadius="1"
                                                        Background="#D6DFEA"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Opacity" Value="0.85"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </GridSplitter.Style>
                    </GridSplitter>

                    <Border Grid.Column="0" Background="#FBFCFE" BorderBrush="#E3E8EF" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid x:Name="NavigationExpandedContent" Margin="10,12,10,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F2F4F7" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="2">
                                        <UniformGrid Columns="2">
                                            <RadioButton GroupName="ResultNavigator" Style="{StaticResource ResultNavTabStyle}" IsChecked="{Binding IsResultPathNavigationActive, Mode=OneWay}" Command="{Binding ShowResultNavigationCommand}" CommandParameter="Path">YOL</RadioButton>
                                            <RadioButton GroupName="ResultNavigator" Style="{StaticResource ResultNavTabStyle}" IsChecked="{Binding IsResultTypeNavigationActive, Mode=OneWay}" Command="{Binding ShowResultNavigationCommand}" CommandParameter="Type">TÜR</RadioButton>
                                        </UniformGrid>
                                    </Border>

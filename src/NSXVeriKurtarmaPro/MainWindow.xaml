                                                                    </Border>
                                                                    <TextBlock Text="{Binding SizeText}" FontSize="9.5" Foreground="#667085" VerticalAlignment="Center"/>
                                                                    <TextBlock Text=" • " FontSize="9.5" Foreground="#B2BBC8" VerticalAlignment="Center"/>
                                                                    <TextBlock FontSize="9.5" Foreground="#667085" VerticalAlignment="Center">
                                                                        <TextBlock.Text>
                                                                            <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                                                <Binding Path="EffectiveRecoveryState"/>
                                                                                <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>

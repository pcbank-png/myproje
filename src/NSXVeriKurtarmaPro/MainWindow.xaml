                                                </TextBlock.Text>
                                            </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button MinWidth="104" Height="46" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding PauseCommand}" Margin="0,0,7,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" Margin="0,0,7,0"/>
                                            <TextBlock Text="Duraklat" Foreground="White" FontSize="10.8" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button MinWidth="104" Height="46" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ResumeCommand}" Margin="0,0,7,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" Margin="0,0,7,0"/>
                                            <TextBlock Text="Devam" Foreground="White" FontSize="10.8" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button MinWidth="104" Height="46" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding IsScanRunning}" Click="StopScanButton_Click" Margin="0,0,9,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" Margin="0,0,7,0"/>
                                            <TextBlock Text="Durdur" Foreground="White" FontSize="10.8" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button MinWidth="164" Height="46" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RecoverSelectedCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Seçilenleri Kurtar" Foreground="White" FontSize="10.8" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Column="2" Background="#FBFCFE" BorderBrush="#E3E8EF" BorderThickness="1,0,0,0">
                        <Grid Margin="14">
                            <!-- Seçim yoksa sade boş durum. -->
                            <Grid Visibility="{Binding IsRecoveryInfoEmpty, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <Border Width="84" Height="84" CornerRadius="16" Background="#EEF4FC" BorderBrush="#DCE7F6" BorderThickness="1">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#6F96D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Bir dosya seçin" FontSize="12" FontWeight="SemiBold" Foreground="#667085" Margin="0,13,0,0"/>
                                    <TextBlock Text="Kurtarma için işaretlenen dosyaların özeti burada görünür." FontSize="9.4" Foreground="#98A2B3" TextAlignment="Center" TextWrapping="Wrap" Width="220" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Bir veya daha fazla dosya işaretlendiğinde sağ panel doğrudan kurtarma seçim özetine dönüşür. -->
                            <Grid Visibility="{Binding HasRecoverySelection, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#EAF2FF" BorderBrush="#D2E2FA" BorderThickness="1">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#0B57C9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="Kurtarma Seçimi" FontSize="12.4" FontWeight="SemiBold" Foreground="#172033"/>
                                        <TextBlock Text="Anlık seçim özeti" FontSize="9.2" Foreground="#98A2B3" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#E9F8EF" BorderBrush="#CBEBD7" BorderThickness="1" CornerRadius="9" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="SEÇİM" FontSize="8.6" FontWeight="Bold" Foreground="#197A42"/>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1" Background="#F2F7FF" BorderBrush="#D6E5FA" BorderThickness="1" CornerRadius="14" Padding="14,13" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="TOPLAM SEÇİLİ BOYUT" FontSize="8.4" FontWeight="SemiBold" Foreground="#6C7C94"/>
                                        <TextBlock Text="{Binding SelectedBytesText}" FontSize="25" FontWeight="SemiBold" Foreground="#173D72" Margin="0,3,0,1"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SelectedCount, StringFormat={}{0:N0}}" FontSize="11.2" FontWeight="SemiBold" Foreground="#344054"/>
                                            <TextBlock Text=" dosya seçili" FontSize="11.2" Foreground="#667085"/>
                                        </StackPanel>
                                        <Border Height="1" Background="#DCE8F8" Margin="0,10,0,9"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Kapsam" FontSize="8.6" Foreground="#98A2B3"/>
                                                <TextBlock FontSize="9.8" FontWeight="SemiBold" Foreground="#475467" Margin="0,2,0,0" TextWrapping="Wrap">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                            <Binding Path="SelectionCoverageText"/>
                                                            <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Minimum hedef alanı" FontSize="8.6" Foreground="#98A2B3"/>
                                                <TextBlock FontSize="9.8" FontWeight="SemiBold" Foreground="#475467" Margin="0,2,0,0" TextWrapping="Wrap">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                            <Binding Path="SelectionRequiredSpaceText"/>
                                                            <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="DOSYA DAĞILIMI" FontSize="8.7" FontWeight="SemiBold" Foreground="#98A2B3" Margin="1,0,0,7"/>

                                        <Border Background="White" BorderBrush="#E4E9F0" BorderThickness="1" CornerRadius="11" Padding="10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="9" Background="#EEF5FF">
                                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2E6DB6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                                                    <TextBlock Text="Fotoğraf" FontSize="9.8" FontWeight="SemiBold" Foreground="#344054"/>
                                                    <TextBlock Text="{Binding SelectedPhotoBytesText}" FontSize="8.8" Foreground="#98A2B3" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SelectedPhotoCount, StringFormat={}{0:N0}}" FontSize="12" FontWeight="SemiBold" Foreground="#344054" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="White" BorderBrush="#E4E9F0" BorderThickness="1" CornerRadius="11" Padding="10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="9" Background="#F0F3FF">
                                                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#566CC7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                                                    <TextBlock Text="Video" FontSize="9.8" FontWeight="SemiBold" Foreground="#344054"/>
                                                    <TextBlock Text="{Binding SelectedVideoBytesText}" FontSize="8.8" Foreground="#98A2B3" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SelectedVideoCount, StringFormat={}{0:N0}}" FontSize="12" FontWeight="SemiBold" Foreground="#344054" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="White" BorderBrush="#E4E9F0" BorderThickness="1" CornerRadius="11" Padding="10" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="9" Background="#F4F5F7">
                                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#667085" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                                                    <TextBlock Text="Belge / Diğer" FontSize="9.8" FontWeight="SemiBold" Foreground="#344054"/>
                                                    <TextBlock Text="{Binding SelectedDocumentBytesText}" FontSize="8.8" Foreground="#98A2B3" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SelectedDocumentCount, StringFormat={}{0:N0}}" FontSize="12" FontWeight="SemiBold" Foreground="#344054" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="SEÇİM DETAYLARI" FontSize="8.7" FontWeight="SemiBold" Foreground="#98A2B3" Margin="1,0,0,7"/>
                                        <Border Background="White" BorderBrush="#E4E9F0" BorderThickness="1" CornerRadius="11" Padding="11">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Dosya türleri" FontSize="9.2" Foreground="#667085"/>
                                                    <TextBlock Grid.Column="1" FontSize="9.5" FontWeight="SemiBold" Foreground="#344054">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                                <Binding Path="SelectionTypeText"/>
                                                                <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Onarılan" FontSize="9.2" Foreground="#667085"/>
                                                    <TextBlock Grid.Column="1" FontSize="9.5" FontWeight="SemiBold" Foreground="#344054">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                                <Binding Path="SelectedRepairedText"/>
                                                                <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Grid>
                                                <Border Height="1" Background="#EDF0F4" Margin="0,0,0,8"/>
                                                <TextBlock Text="Kaynak" FontSize="8.6" Foreground="#98A2B3"/>
                                                <TextBlock FontSize="9.8" FontWeight="SemiBold" Foreground="#344054" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                            <Binding Path="SelectionSourceText"/>
                                                            <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock FontSize="8.7" Foreground="#98A2B3" Margin="0,2,0,0" TextWrapping="Wrap">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                            <Binding Path="SelectionSourceDetail"/>
                                                            <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#F5F8FC" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,9,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#5E86C5" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" FontSize="8.9" Foreground="#667085" TextWrapping="Wrap" VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                            <Binding Path="SelectionStatusText"/>
                                                            <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                    <Button Height="42" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RecoverSelectedCommand}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="13" Margin="0,0,7,0"/>
                                            <TextBlock Text="Seçilenleri Kurtar" Foreground="White" FontSize="10.2" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Height="34" Style="{StaticResource WorkspaceToolButtonStyle}" Command="{Binding ClearRecoverySelectionCommand}" Margin="0,7,0,0">Seçimi Temizle</Button>
                                </StackPanel>
                            </Grid>

                            <!-- İşaretlenmiş kurtarma seçimi yoksa tek dosya önizleme davranışı korunur. -->
                            <Grid Visibility="{Binding DataContext.HasSingleRecoveryFileInfo, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVisibility}}" DataContext="{Binding SelectedRecoveryFile}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="44"/>
                                </Grid.RowDefinitions>
                                <Border Width="224" Height="158" CornerRadius="12" Background="#EEF3FA" BorderBrush="#E0E7EF" BorderThickness="1" HorizontalAlignment="Center" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>
                                        <TextBlock Text="{Binding TypeGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="42" Foreground="#7CA5E6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" Foreground="#263548" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Extension}" FontSize="9.5" Foreground="#1677FF" TextAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                                    <TextBlock Text="Boyut" FontSize="9.2" Foreground="#98A2B3"/>
                                    <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="#344054" Margin="0,3,0,10"/>
                                    <TextBlock FontSize="9.2" Foreground="#98A2B3">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                <Binding Path="DetailPrimaryInfoLabel"/>
                                                <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Foreground="#344054" Margin="0,3,0,10" TextWrapping="Wrap">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                <Binding Path="DetailPrimaryInfoText"/>
                                                <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <StackPanel Margin="0,0,0,10" Visibility="{Binding HasRecoveredOriginalPath, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontSize="9.2" Foreground="#98A2B3">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                    <Binding Source="YOL"/>
                                                    <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding RecoveredPathDisplayText}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="#344054"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding RecoveredFullPath}"/>
                                    </StackPanel>
                                    <TextBlock Text="Durum" FontSize="9.2" Foreground="#98A2B3"/>
                                    <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="#344054" Margin="0,3,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                <Binding Path="EffectiveRecoveryState"/>
                                                <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="Güven" FontSize="9.2" Foreground="#98A2B3" Margin="0,10,0,0"/>
                                    <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="#1769AA" Margin="0,3,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                <Binding Path="RecoveryConfidenceText"/>
                                                <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock FontSize="9" Foreground="#667085" Margin="0,3,0,0" TextWrapping="Wrap">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                                <Binding Path="RecoveryConfidenceSummary"/>
                                                <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Row="3" Style="{StaticResource WorkspaceToolButtonStyle}" Click="PreviewFile_Click">Önizle</Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Tarama I/O bittikten sonra ağır tür/klasör/tarih indeksleri tek seferde hazırlanır.
                     Kullanıcı dosyaları tarama boyunca canlı görür; bu overlay yalnız final organizasyon fazıdır. -->
                <Grid Panel.ZIndex="50"
                      Background="#5C1C2A3A"
                      Visibility="{Binding IsOrganizingResults, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="510" MinHeight="232"
                            Padding="24,22"
                            Background="White"
                            BorderBrush="#DDE6F1"
                            BorderThickness="1"
                            CornerRadius="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#243B5A" BlurRadius="30" ShadowDepth="5" Opacity="0.22"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Width="58" Height="58" CornerRadius="16" Background="#EAF2FF" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="27" Foreground="#1677FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#182230" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                        <Binding Source="Bulunan dosyalar organize ediliyor..."/>
                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock FontSize="10.5" Foreground="#667085" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                        <Binding Source="Tarama tamamlandı. Tür, klasör, tarih ve kalite indeksleri hazırlanıyor."/>
                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="#344054">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                            <Binding Path="ProgressProcessedText"/>
                                            <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercentText}" FontSize="11" FontWeight="Bold" Foreground="#0B57C9"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource RoundedProgressStyle}" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Height="8" Margin="0,8,0,0"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="10" Foreground="#667085">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                            <Binding Path="ProgressFoundText"/>
                                            <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Column="1" FontSize="10" Foreground="#667085">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
                                            <Binding Path="ProgressEtaText"/>
                                            <Binding Path="Revision" Source="{x:Static services:LocalizationService.Current}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

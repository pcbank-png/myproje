                                                        <TextBlock Text="&#xE762;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#0B57C9"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Önizle" Style="{StaticResource RecoveryContextMenuItemStyle}" Click="PreviewFile_Click">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#5E86C5"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Seçilenleri kurtar" Style="{StaticResource RecoveryContextMenuItemStyle}" Click="RecoverSingleFile_Click">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#0B57C9"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Kurtarma için işaretle" Style="{StaticResource RecoveryContextMenuItemStyle}" Click="MarkFileForRecovery_Click">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#5E86C5"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <infra:VirtualizingWrapPanel ItemWidth="184" ItemHeight="184"/>

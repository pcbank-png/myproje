                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             ItemContainerStyle="{StaticResource ThumbnailCardItemStyle}"
                                             PreviewMouseRightButtonDown="RecoveryThumbnailList_PreviewMouseRightButtonDown"
                                             ContextMenuOpening="RecoveryThumbnailList_ContextMenuOpening"
                                             MouseDoubleClick="RecoveryThumbnailList_MouseDoubleClick"
                                             Loaded="RecoveryThumbnailList_Loaded"
                                             SizeChanged="RecoveryThumbnailList_SizeChanged">
                                        <ListBox.ContextMenu>
                                            <ContextMenu Style="{StaticResource RecoveryContextMenuStyle}">

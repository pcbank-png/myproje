                                            <ContextMenu Style="{StaticResource RecoveryContextMenuStyle}">
                                                <MenuItem Header="Tümünü seç" Style="{StaticResource RecoveryContextMenuItemStyle}" Click="SelectAllVisibleFiles_Click">

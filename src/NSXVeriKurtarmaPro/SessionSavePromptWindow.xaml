<Window x:Class="NSXVeriKurtarmaPro.SessionSavePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620"
        Height="370"
        MinWidth="620"
        MaxWidth="620"
        MinHeight="370"
        MaxHeight="370"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DialogButtonBaseStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Border Background="#FFFFFF"
                BorderBrush="#D7E0EA"
                BorderThickness="1"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="6"
                                  Opacity="0.20"
                                  Color="#10213A"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="76"/>
                </Grid.RowDefinitions>

                <!-- Pro title bar -->
                <Border Grid.Row="0"
                        Background="#F8FAFD"
                        BorderBrush="#E3EAF2"
                        BorderThickness="0,0,0,1"
                        CornerRadius="18,18,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="18,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="36" Height="36"
                                CornerRadius="10"
                                Background="#EEF4FF"
                                BorderBrush="#D7E5FF"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE74E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Foreground="#0B57C9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
                            <TextBlock x:Name="TitleText"
                                       FontSize="14.5"
                                       FontWeight="SemiBold"
                                       Foreground="#101828"/>
                            <TextBlock Text="NSX Veri Kurtarma Pro"
                                       FontSize="10.5"
                                       Foreground="#667085"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource CloseWindowButtonStyle}"
                                ToolTip="Kapat"
                                Click="Cancel_Click">
                            <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Path Data="M3,3 L13,13 M13,3 L3,13"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1"
                                      StrokeStartLineCap="Square"
                                      StrokeEndLineCap="Square"
                                      SnapsToDevicePixels="True"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Row="1" Margin="24,22,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="54" Height="54"
                            CornerRadius="27"
                            Background="#EEF4FF"
                            BorderBrush="#D7E5FF"
                            BorderThickness="1"
                            VerticalAlignment="Top">
                        <Grid>
                            <Ellipse Width="30" Height="30"
                                     Fill="#0B57C9"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="?"
                                       Foreground="White"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-1,0,0"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border x:Name="ScanStateBadge"
                                    Background="#EEF4FF"
                                    BorderBrush="#D7E5FF"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="9,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ScanStateDot" Width="7" Height="7" Fill="#0B57C9" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ScanStateText"
                                               FontSize="10.8"
                                               FontWeight="SemiBold"
                                               Foreground="#0B57C9"
                                               Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="MessageText"
                                   FontSize="12.6"
                                   Foreground="#344054"
                                   LineHeight="20"
                                   TextWrapping="Wrap"
                                   MaxWidth="465"/>

                        <Border Margin="0,16,0,0"
                                Padding="12,9"
                                Background="#F8FAFC"
                                BorderBrush="#E4EAF1"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#EEF4FF" CornerRadius="7" Padding="7,3" VerticalAlignment="Center">
                                    <TextBlock Text=".NSX"
                                               FontSize="9.5"
                                               FontWeight="Bold"
                                               Foreground="#0B57C9"/>
                                </Border>
                                <TextBlock x:Name="ProjectNoteText"
                                           Grid.Column="1"
                                           FontSize="10.6"
                                           Foreground="#667085"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Actions -->
                <Border Grid.Row="2"
                        Background="#F8FAFD"
                        BorderBrush="#E3EAF2"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,18,18">
                    <Grid Margin="22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="126"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="CancelButton"
                                Grid.Column="1"
                                Style="{StaticResource DialogButtonBaseStyle}"
                                Background="#FFFFFF"
                                Foreground="#475467"
                                BorderBrush="#D0D5DD"
                                Click="Cancel_Click"/>

                        <Button x:Name="DiscardButton"
                                Grid.Column="3"
                                Style="{StaticResource DialogButtonBaseStyle}"
                                Background="#FFFFFF"
                                Foreground="#344054"
                                BorderBrush="#B8C2CE"
                                Click="Discard_Click"/>

                        <Button x:Name="SaveButton"
                                Grid.Column="5"
                                Style="{StaticResource DialogButtonBaseStyle}"
                                Background="{StaticResource LogoPrimaryBrush}"
                                Foreground="#FFFFFF"
                                BorderBrush="{StaticResource LogoBlueBrush}"
                                IsDefault="True"
                                Click="Save_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
